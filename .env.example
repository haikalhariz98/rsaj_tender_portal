# Copy to .env and fill in. The defaults below work with the bundled compose.yaml.

POSTGRES_USER=perolehan
POSTGRES_PASSWORD=perolehan
POSTGRES_DB=perolehan
POSTGRES_PORT=5432

DATABASE_URL="postgresql://perolehan:perolehan@localhost:5432/perolehan?schema=public"

# Document store (ADR 0011). The driver defaults to postgres, the only one built.
# DOCUMENT_MAX_BYTES is the deployment's technical ceiling on one file, in bytes; with it
# unset every upload is refused. The organisation's own limit is set in the portal under
# Configuration, Documents, Upload rules, and the smaller of the two applies.
#
# Memory: a file is held whole while it is handled, so one request needs a multiple of
# DOCUMENT_MAX_BYTES. An upload holds about 4 times the file (the parsed form part, the
# copy taken from it, and the database driver's own copy when writing; measured at 2 to 3
# times through parsing alone, down from 7 to 8 before the body was parsed once). A
# download holds about 3 times (the driver's result, the decoded bytes, the response;
# an estimate, not measured). Size the host for
#   uploads cap x 4 x ceiling  +  downloads cap x 3 x ceiling  (plus the application's own ~0.5 GB)
# and measure on the real hardware; the 50 MB below with the defaults is about 1.5 GB, before
# the application's own memory. Only the parse was measured: the driver's copy and the
# download figure are estimates.
# The caps count requests in flight in this process only (one per instance: several
# instances multiply them). A download's slot is held while the response is built, not
# while a slow client reads it, so the caps do not bound slow readers. A request over a cap is answered 503 with Retry-After and is
# not an access event. An unset, zero or non-numeric value is the default.
DOCUMENT_STORE_DRIVER=postgres
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_CONCURRENT_UPLOADS=3
DOCUMENT_MAX_CONCURRENT_DOWNLOADS=6

# Optional, local only: a name for the dashboard greeting until sign-in names the user.
# PEROLEHAN_GREETING_NAME=""
