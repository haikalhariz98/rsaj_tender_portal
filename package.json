{
  "name": "perolehan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-ui.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "auth:bootstrap": "tsx scripts/bootstrap-administrator.ts",
    "auth:purge-sign-in-detail": "tsx scripts/purge-sign-in-detail.ts",
    "auth:holdings": "tsx scripts/check-administrator-holdings.ts",
    "auth:attribution": "tsx scripts/check-attribution-coverage.ts",
    "demo:accounts": "tsx scripts/demo-accounts.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:watch": "vitest",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run setup",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "tsx scripts/db-roles.ts",
    "db:deploy": "prisma migrate deploy",
    "postdb:deploy": "tsx scripts/db-roles.ts",
    "db:roles": "tsx scripts/db-roles.ts",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "pack": "tsx scripts/load-pack.ts",
    "postinstall": "prisma generate",
    "demo:load": "tsx prisma/demo.ts load",
    "demo:wipe": "tsx prisma/demo.ts wipe",
    "demo:results": "tsx prisma/demo.ts results",
    "demo:attribute": "tsx prisma/demo.ts attribute",
    "demo:inbox": "tsx prisma/demo.ts inbox",
    "demo:company": "tsx prisma/demo.ts company",
    "demo:my-bids": "tsx prisma/demo.ts my-bids",
    "demo:my-projects": "tsx prisma/demo.ts my-projects",
    "demo:project-documents": "tsx prisma/demo.ts project-documents",
    "demo:contractor": "tsx prisma/demo.ts contractor",
    "demo:switches": "tsx prisma/demo.ts switches",
    "compare": "node scripts/compare-screen.mjs",
    "compare:drawer": "node scripts/compare-drawer.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "exceljs": "^4.4.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
