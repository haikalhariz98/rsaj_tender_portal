+describe("returnTargetBeforeNext", () => {
+  const steps = [
+    { sequence: 1, roleCode: "SEC_PRE", decision: "DONE" },
+    { sequence: 2, roleCode: "HOD_CP", decision: "PENDING" },
+    { sequence: 3, roleCode: "FD", decision: "PENDING" },
+  ];
+  it("says whether the named office has a step before the next one pending", () => {
+    expect(returnTargetBeforeNext({ rejectionKind: "RETURN_TO_STEP", rejectionReturnToRoleCode: "SEC_PRE", steps })).toBe(true);
+    expect(returnTargetBeforeNext({ rejectionKind: "RETURN_TO_STEP", rejectionReturnToRoleCode: "HOD_CP", steps })).toBe(false);
+  });
+  it("does not arise for other destinations or a route with nothing pending", () => {
+    expect(returnTargetBeforeNext({ rejectionKind: "TERMINATE", rejectionReturnToRoleCode: null, steps })).toBeUndefined();
+    expect(returnTargetBeforeNext({ rejectionKind: "RETURN_TO_STEP", rejectionReturnToRoleCode: "SEC_PRE", steps: steps.map((s) => ({ ...s, decision: "DONE" })) })).toBeUndefined();
+  });
+});
diff --git a/src/lib/authority/rejection.ts b/src/lib/authority/rejection.ts
index c9cd8dc..0d59cce 100644
--- a/src/lib/authority/rejection.ts
+++ b/src/lib/authority/rejection.ts
@@ -98,6 +98,18 @@ export function earlierSteps<T extends RouteStep>(steps: readonly T[], rejecting
   return steps.filter((s) => s.sequence < rejectingSeq).sort((a, b) => a.sequence - b.sequence);
 }
 
+/**
+ * For a route read as a whole: whether a configured return to a step can apply to the
+ * next step awaiting a decision — a step of the named office comes before it. Undefined
+ * where that does not arise (no return to a step, or nothing pending).
+ */
+export function returnTargetBeforeNext(route: { rejectionKind: string | null; rejectionReturnToRoleCode: string | null; steps: readonly (RouteStep & { decision: string })[] }): boolean | undefined {
+  if (route.rejectionKind !== "RETURN_TO_STEP") return undefined;
+  const next = [...route.steps].sort((a, b) => a.sequence - b.sequence).find((s) => s.decision === "PENDING");
+  if (!next) return undefined;
+  return earlierSteps(route.steps, next.sequence).some((s) => s.roleCode === route.rejectionReturnToRoleCode);
+}
