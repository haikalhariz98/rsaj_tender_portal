/// A human being. Identity, deliberately separate from authentication: a committee
/// vote must be attributable long before anyone can sign in, and external members
/// never sign in at all.
model Person {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  staffNo  String?
  name     String
  email    String?
  jobTitle String?
  /// The same job title as the customer writes it in Malay. Held rather than
  /// translated: it is the title on the officer's own appointment letter.
  jobTitleMs String?
  /// Shown on the People list. A label rather than a link to OrgUnit, because the
  /// prototype lists people whose department is recorded but whose unit is not.
  department String?
  telephone  String?
  /// 6.7 (FR-CTE-011, C-6): the unit the person sits in (OrgUnit.code, checked against the units when
  /// saved; no key, as requestingUnitCode). Null: not recorded, and an opening panel judged by an
  /// independence rule cannot be assigned with them.
  orgUnitCode String?

  /// The office this person is presented as holding in the portal. Distinct from the
  /// authority level, which is what the approval matrix routes on: a person may sit
  /// at one authority level while doing a different job in the portal.
  portalRoleCode String?

  /// Where this person sits in the delegated authority. Recorded on the person as
  /// well as on the role because the two genuinely differ: an officer can act at a
  /// level their portal role does not imply. The vocabulary is whatever levels the
  /// customer has put on their roles — never a list in code.
  authorityLevel String?

  /// False while they are away. Cover is a Delegation; this is only the signal that
  /// one is needed.
  isAvailable Boolean @default(true)
  /// False for a leaver. Never delete a person — decisions they voted on must keep
  /// resolving to a name.
  isActive Boolean @default(true)

  headOf            OrgUnit[]           @relation("OrgUnitHead")
  budgetCodesHeld   BudgetCode[]        @relation("BudgetHolder")
  ownsCostCentres   CostCentre[]        @relation("CostCentreOwner")
  roleAssignments   RoleAssignment[]
  committeeSeats    CommitteeMember[]
  meetingAttendance MeetingAttendance[]
  votes             Vote[]
  auditEntries      AuditEntry[]
  staffAccount      StaffAccount?
  codesIssued       OneTimeCode[] @relation("CodeIssuedBy")
  delegationsGiven  Delegation[] @relation("DelegationFrom")
  delegationsTaken  Delegation[] @relation("DelegationTo")
  mattersTabled     CommitteeDecision[] @relation("TabledBy")
  recusals          DecisionRecusal[]
  requisitionsRaised    Requisition[]            @relation("RequestedBy")
  requisitionsReturned  Requisition[]            @relation("ReturnedTo")
  endorsements          RequisitionEndorsement[]
  splitOverrides        RequisitionSplitCheck[]
  approvalStepsDecided  ApprovalStep[]
  exerciseTypeOverrides SourcingExercise[] @relation("TypeOverriddenBy")
  proposalsReviewed     SourcingExercise[] @relation("ProposalReviewer")
  exercisesInCharge     SourcingExercise[] @relation("ExercisePersonInCharge")
  exerciseParticipation ExerciseParticipant[]
  awardsSigned          Award[]              @relation("AwardSignatory")
  returnsReceived       AwardReturn[]        @relation("ReturnReceivedBy")
  securitiesVerified    SecurityInstrument[] @relation("SecurityVerifiedBy")
  policiesVerified      InsurancePolicy[]    @relation("PolicyVerifiedBy")
  rejectionChoices      ApprovalInstance[]   @relation("RejectionChosenBy")
  conflictsDeclared     ApprovalStep[]       @relation("ConflictDeclaredBy")
  documentVersionsRecorded DocumentVersion[] @relation("VersionRecordedBy")
  legalHoldsPlaced         LegalHold[]       @relation("HoldPlacedBy")
  legalHoldsReleased       LegalHold[]       @relation("HoldReleasedBy")
  qualificationsHeld       PersonQualification[]
  bqVersionsPrepared       BqVersion[]              @relation("BqPreparer")
  panelVerifications       SpecPanelVerification[]
  estimatesPrepared        CompanyEstimate[]        @relation("EstimatePreparer")
  estimateVersionsPrepared CompanyEstimateVersion[] @relation("EstimateVersionPreparer")
  clauseOverridesEndorsed  ClauseOverride[]
  packAssurancesConfirmed  PackAssurance[]
  estimateEvents           EstimateEvent[]
  rateSchedulesIssued      RateSchedule[]           @relation("RateScheduleIssuedBy")
  publicationsRecorded     PublicationRecord[]      @relation("PublicationRecordedBy")
  documentSalesIssued      DocumentSale[]           @relation("SaleIssuedBy")
  attendanceRecorded       SiteEventAttendance[]    @relation("AttendanceRecordedBy")
  envelopesReceived        BidEnvelope[]            @relation("EnvelopeReceivedBy")
  withdrawalsReceived      BidWithdrawal[]          @relation("WithdrawalReceivedBy")
  boxEventsRecorded        BoxEvent[]               @relation("BoxEventBy")
  extensionsRecorded       ValidityExtension[]      @relation("ExtensionRecordedBy")
  withdrawalFindings       BidWithdrawal[]          @relation("WithdrawalFindingBy")
  openingsStarted          Opening[]                @relation("OpeningStartedBy")
  panelOverrides           Opening[]                @relation("OpeningPanelOverrideBy")
  openingSittingsRecorded  OpeningSitting[]         @relation("OpeningSittingRecordedBy")
  openingPanelSeats        OpeningPanelMember[]     @relation("OpeningPanelPerson")
  openingAuthorisations    OpeningAuthorisation[]   @relation("OpeningAuthorisedBy")
  openedBidInitials        OpenedBidInitial[]       @relation("OpenedBidInitialBy")
  openingSignatures        OpeningSignature[]       @relation("OpeningSignedBy")
  copyExplanations         EstimateCopyExplanation[] @relation("CopyExplainedBy")
  evaluationsStarted       Evaluation[]             @relation("EvaluationStartedBy")
  evaluationReportsIssued  Evaluation[]             @relation("EvaluationIssuedBy")
  evaluationTeamSeats      EvaluationTeamMember[]   @relation("EvaluationTeamPerson")
  evaluationCorrections    EvaluationBidder[]       @relation("EvaluationCorrectedBy")
  evaluationShortlists     EvaluationBidder[]       @relation("EvaluationShortlistedBy")
  evaluationInputs         EvaluationBidder[]       @relation("EvaluationInputsBy")
  evaluationScoresRecorded EvaluationScore[]        @relation("EvaluationScoredBy")
  stageSubmissions         StageSubmission[]        @relation("StageSubmittedBy")
  aspectAssessments        AspectAssessment[]       @relation("AspectAssessedBy")
  evaluationMeetingsOpened EvaluationMeeting[]      @relation("EvaluationMeetingOpenedBy")
  evaluationMeetingsClosed EvaluationMeeting[]      @relation("EvaluationMeetingClosedBy")
  tendererCommunications   TendererCommunication[]  @relation("CommunicationRecordedBy")
  recommendationsFormed    Recommendation[]         @relation("RecommendationFormedBy")
  proposalPapersChecked    ProposalPaper[]          @relation("ProposalCheckedBy")
  proposalPapersRecommended ProposalPaper[]         @relation("ProposalRecommendedBy")
  proposalPapersRendered   ProposalPaper[]          @relation("ProposalRenderedBy")
  negotiationRequests      NegotiationRequest[]     @relation("NegotiationRequestedBy")
  evaluationsCancelled     Evaluation[]             @relation("EvaluationCancelledBy")
  /// 6.15: acts on the supplier register, recorded on their behalf (never a supplier's own people: ADR 0019).
  supplierApplicationsRecorded  SupplierApplication[] @relation("SupplierApplicationRecordedBy")
  supplierApplicationsSubmitted SupplierApplication[] @relation("SupplierApplicationSubmittedBy")
  applicationDecisions          ApplicationDecision[] @relation("ApplicationDecidedBy")
  portalApplicationsDecided     PortalApplication[]   @relation("PortalApplicationDecidedBy")
  supplierDocumentsRecorded     SupplierDocument[]    @relation("SupplierDocumentRecordedBy")
  supplierDocumentsVerified     SupplierDocument[]    @relation("SupplierDocumentVerifiedBy")

  @@unique([organisationId, staffNo])
  @@index([organisationId, name])
  standingRequested    StandingRequest[]   @relation("StandingRequestedBy")
  standingWithdrawn    StandingRequest[]   @relation("StandingWithdrawnBy")
  standingRecorded     StandingEvent[]     @relation("StandingRecordedBy")
  /// 615-C2: registration cancellations this person withdrew as recorded in error.
  cancellationsWithdrawn StandingEvent[]   @relation("CancellationWithdrawnBy")
  permissionsRequested SpecialPermission[] @relation("PermissionRequestedBy")
  permissionsGranted   SpecialPermission[] @relation("PermissionGrantedBy")
  /// 6.12: formation acts, recorded on their behalf.
  wcChecks               InsurancePolicy[]         @relation("PolicyWcCheckedBy")
  reconciliationsChecked ContractReconciliation[]  @relation("ReconciliationCheckedBy")
  amendmentsSigned       ReconciliationAmendment[] @relation("AmendmentSignedBy")
  formationChecks        FormationCheck[]          @relation("FormationCheckBy")
  legalSubmissions       LegalReview[]             @relation("LegalSubmittedBy")
  legalReviews           LegalReview[]             @relation("LegalReviewedBy")
  contractSignatures     ContractSignature[]       @relation("ContractSignedBy")
  custodyHeld            CustodyItem[]             @relation("CustodyHeldBy")
  custodyMoves           CustodyMovement[]         @relation("CustodyMovedBy")
  certificateSignatures  CertificateSignature[]    @relation("CertificateSignedBy")
  certificateOverrides   CertificateOverride[]     @relation("CertificateOverriddenBy")
  routingChecks          RoutingCheck[]            @relation("RoutingCheckedBy")
  // 6.13 Part A (4b): supervision, recorded on their behalf.
  soDelegationsHeld      SoDelegation[]            @relation("SoDelegate")
  soDelegationsGranted   SoDelegation[]            @relation("SoDelegationGrantor")
  possessionsRecorded    Possession[]              @relation("PossessionRecordedBy")
  programmesScrutinised  WorkProgramme[]           @relation("ProgrammeScrutinisedBy")
  programmesDecided      WorkProgramme[]           @relation("ProgrammeDecidedBy")
  progressRecorded       ProgressRecord[]          @relation("ProgressRecordedBy")
  diaryEntriesKept       SiteDiaryEntry[]          @relation("DiaryOfficer")
  diaryEndorsements      DiaryEndorsement[]        @relation("DiaryEndorsedBy")
  siteMeetingsChaired    SiteMeeting[]             @relation("SiteMeetingChair")
  observationsMade       ComplianceObservation[]   @relation("ObservationBy")
  directionsGiven        ProgrammeDirection[]      @relation("DirectionBy")
  deductionsRecorded     PendingDeduction[]        @relation("PendingDeductionBy")
  earlyActionsDecided    EarlyActionDecision[]     @relation("EarlyActionBy")
  recordsHandedOver      SiteRecordsHandover[]     @relation("RecordsHandedOverBy")
  // 6.13 Part A step 3 (4c): payment and the damages chain, recorded on their behalf.
  calendarsAgreed        PaymentCalendar[]         @relation("CalendarRecordedBy")
  openingPositions       OpeningPosition[]         @relation("OpeningRecordedBy")
  valuationsRecorded     InterimValuation[]        @relation("ValuationRecordedFor")
  retentionReleased      RetentionRelease[]        @relation("RetentionReleasedBy")
  advancesApplied        AdvancePayment[]          @relation("AdvanceAppliedBy")
  financePaymentsRecorded FinancePayment[]         @relation("FinancePaymentBy")
  // 6.13 Part A step 4 (4d): variations and the adjustment of the contract sum, recorded on their behalf.
  variationsOriginated   Variation[]               @relation("VariationOriginator")
  variationsReviewed     Variation[]               @relation("VariationReviewer")
  variationsPassedOn     Variation[]               @relation("VariationPrincipal")
  variationsDecided      Variation[]               @relation("VariationSoDecision")
  variationsCommenced    Variation[]               @relation("VariationCommencedSupport")
  variationsClosed       Variation[]               @relation("VariationClosedBy")
  contractMattersRecorded ContractMatter[]         @relation("ContractMatterRecordedBy")
  // 6.13 Part B run 1b: time and damages, recorded on their behalf.
  delayNoticesRecorded   DelayNotice[]             @relation("DelayNoticeRecordedFor")
  eotClaimsRecorded      EotClaim[]                @relation("EotClaimRecordedBy")
  eotClaimsDetermined    EotClaim[]                @relation("EotClaimDeterminedBy")
  extensionsRaised       ExtensionOfTime[]         @relation("ExtensionOfTimeRaisedBy")
  lossExpenseRecorded    LossExpenseClaim[]        @relation("LossExpenseRecordedBy")
  lossExpenseValued      LossExpenseClaim[]        @relation("LossExpenseValuedBy")
  periodExtensionsRecorded PeriodExtension[]       @relation("PeriodExtensionRecordedBy")
  periodAgreementsRaised PeriodAgreement[]         @relation("PeriodAgreementRaisedBy")
  ladWaiversRecorded     LadWaiver[]               @relation("LadWaiverRecordedBy")
  variationRoutesSent    VariationApproval[]       @relation("VariationRouteSentBy")
  instructionsRecorded   VariationInstruction[]    @relation("InstructionRecordedBy")
  measurementsRecorded   VariationMeasurement[]    @relation("MeasurementRecordedBy")
  dayworkRecorded        DayworkRecord[]           @relation("DayworkRecordedBy")
  variationCertsRaised   VariationCertificate[]    @relation("VariationCertificateBy")
  sumAdjustmentsRaised   SumAdjustment[]           @relation("SumAdjustmentBy")
  ladWarningsRecorded    LadWarning[]              @relation("LadWarningBy")
  nonCompletionsDecided  NonCompletion[]           @relation("NonCompletionBy")
  routesSubmitted        ApprovalInstance[]        @relation("RouteSubmittedBy")
  // Phase 2a (ADR 0034 D12, D15): the attribution of acts, and the two-person records of configuration.
  actsAttributedAsSubject    ActAttribution[]        @relation("ActSubject")
  actsAttributedAsRecorder   ActAttribution[]        @relation("ActRecordedBy")
  actsBackdateAuthorised     ActAttribution[]        @relation("ActBackdateAuthorisedBy")
  matrixMaking               AuthorityMatrixMaker[]
  matricesIssued             AuthorityMatrix[]       @relation("MatrixIssuedBy")
  configurationChangesProposed ConfigurationChange[] @relation("ChangeProposedBy")
  configurationChangesDecided  ConfigurationChange[] @relation("ChangeDecidedBy")
}

/// Who holds an authority office, and when.
///
/// Effective-dated because a rule resolves to an office rather than a person, and
/// only this turns the office into a signatory — and because re-opening a past
/// decision must find whoever held it at the time.
model RoleAssignment {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Matches AuthorityRole.code.
  roleCode String
  /// Set where the office is held per department rather than organisation-wide.
  scope    String?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@index([roleCode, effectiveFrom])
  @@index([personId])
}

/// An office or committee that can hold authority. Rules reference these by `code`
/// rather than by foreign key, because rules are versioned independently of the org
/// chart and must keep citing an office that has since been retired.
model AuthorityRole {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code        String
  nameEn      String
  nameMs      String
  isCommittee Boolean @default(false)

  /// Which workspace the role belongs to — the internal portal or the supplier one.
  /// A label, since a customer may run more than two.
  workspace String @default("")

  /// What the role is worth in the delegated authority, as the customer names it.
  /// Held apart from `code` because several roles can sit at one authority level.
  authorityLevel String @default("")

  /// When the holder is absent, authority reverts UPWARD to this office. It never
  /// passes down automatically.
  escalatesToCode String?

  /// Nobody approves their own matter. Where the actor is also the approver, the
  /// approval escalates here and the actor is downgraded to recommender.
  selfApprovalEscalatesToCode String?

  sortOrder Int @default(0)

  @@unique([organisationId, code])
}

/// One issue of an organisation's authority limits.
///
/// Thresholds live here rather than in code because they change by resolution, and
/// because where the governing documents contradict each other the organisation —
/// not the software — has to choose.
model AuthorityMatrix {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  label         String
  effectiveFrom DateTime
  effectiveTo   DateTime?

  /// When this issue was put into force. Null is a draft: editable, and invisible to
  /// every routing decision. Once issued it is frozen — a change is a new revision, so
  /// a decision taken under this issue can always be shown the rules it ran under.
  issuedAt DateTime?

  /// The value at which the quotation and tender regimes meet.
  boundaryValue Decimal @db.Decimal(18, 2)

  /// Which side a value exactly equal to `boundaryValue` falls. True puts it in the
  /// LOWER band, false in the upper. Only that exact value is affected; every other
  /// band edge stays (min, max].
  boundaryInclusive Boolean @default(true)

  quotationFloor      Decimal @db.Decimal(18, 2)
  tenderFloor         Decimal @db.Decimal(18, 2)
  requisitionBoundary Decimal @db.Decimal(18, 2)

  /// Deprecated (6.1 ruling OD-9): never read, edited or shown. The 30 was a guess,
  /// and the window now lives only in RequisitionPolicy, unset until the customer sets
  /// it. Kept so existing rows and migrations stay valid.
  splittingWindowDays Int    @default(30)
  currency            String @default("MYR")

  /// The clauses the engine cites when it applies a standing rule of its own rather
  /// than a row. Customer text, never shipped: null means "source not recorded", and
  /// the warning says so rather than citing a clause from someone else's manual.
  /// Where no row matches and the matter must go to the approver's superior.
  noRuleClause         String?
  /// Where nobody may approve their own matter.
  selfApprovalClause   String?
  /// Where an absent holder's authority reverts upward.
  absenceClause        String?
  /// Where an external funder's directives override these limits.
  funderOverrideClause String?

  /// Set on a funder's rule set: an issue that routes matters on this funding route
  /// (FundingRoute.code) in place of the organisation's own limits (FR-REQ-006). Null
  /// is the organisation's own issue. Every reader that means "the rules that apply"
  /// excludes funder issues unless it asks for one by route.
  fundingRouteCode String?

  /// Where the ruling on a value exactly at `boundaryValue` comes from (spec D3, R2).
  /// ASSUMED until a written ruling is recorded: STATED needs `boundarySource`, and like
  /// every field of an issue it is frozen once issued, so a ruling arrives as a new
  /// issue. Every exercise on the boundary records whether it was ruled (6.3 ruling).
  boundaryProvenance Provenance @default(ASSUMED)
  boundarySource     String     @default("")

  rules             AuthorityRule[]
  termsBands        TermsBand[]
  /// The core routing rule (FR-APR-004): the chain beneath each approving office.
  /// Owned by the issue, copied on revision, frozen when issued. Ships empty, and a
  /// funder's rule set carries its own, never the organisation's (6.9 OQ-7).
  coreRouting       CoreRoutingLevel[]
  approvalInstances ApprovalInstance[] @relation("InstanceMatrix")
  overrideInstances ApprovalInstance[] @relation("InstanceOverrideMatrix")

  /// Maker-checker at issue (ADR 0034 D15, Phase 2a). Who issued it: never one of its makers. Null while a draft, and on every
  /// issue made before sign-in.
  issuedByPersonId String?
  issuedByPerson   Person? @relation("MatrixIssuedBy", fields: [issuedByPersonId], references: [id], onDelete: Restrict)
  /// A draft that existed when sign-in landed: who made it is not known. Set once, by the migration, for every draft then in the
  /// database; a new draft is false. Such a draft must be adopted (an attributed edit, or an explicit adopt act) before it is issued.
  makersUnknownAtLanding Boolean @default(false)
  makers                 AuthorityMatrixMaker[]

  @@unique([organisationId, label])
  @@index([organisationId, effectiveFrom])
}

/// One authority row. Each carries the clause it came from, so a routing decision
/// can always be traced back to the document that set it.
model AuthorityRule {
  id                String          @id @default(cuid())
  authorityMatrixId String
  authorityMatrix   AuthorityMatrix @relation(fields: [authorityMatrixId], references: [id], onDelete: Cascade)

  /// Stable business key within the matrix.
  ruleKey String

  /// The matter being authorised. A string rather than an enum: an organisation adds
  /// matters without a schema change.
  domain String

  /// Sourcing method the row is confined to. Null means it applies whatever the method.
  method String?

  /// FR-APR-002 (carried from 6.9 to 6.13 Part A step 1): the contract type (ContractType.code) the row is
  /// confined to. Null means it applies whatever the type. A row confined to a type is more specific than one
  /// for any type, as a row confined to a method is.
  contractTypeCode String?

  /// Extra discriminator for rows that differ only by circumstance.
  cond String?

  /// Band on the value of the matter itself.
  minValue Decimal? @db.Decimal(18, 2)
  maxValue Decimal? @db.Decimal(18, 2)

  /// Band on a percentage — variations are authorised by % of contract sum.
  pctMin Decimal? @db.Decimal(9, 4)
  pctMax Decimal? @db.Decimal(9, 4)

  /// Band on the PARENT CONTRACT's value, banded independently of the matter's own.
  contractValueMin Decimal? @db.Decimal(18, 2)
  contractValueMax Decimal? @db.Decimal(18, 2)

  /// Whether this rule's band edges follow the issue's boundary switch
  /// (`boundaryInclusive`) where an edge equals `boundaryValue`. Null means nobody has
  /// decided, which is refused on save wherever an edge sits on the boundary, and
  /// warns at resolution. Requisition bands do not follow it (6.1 ruling OD-4): a
  /// RM300,000.00 requisition routes to the same office under either setting.
  followsBoundarySwitch Boolean?

  labelEn String
  labelMs String?

  proposerCode String?
  approverCode String?

  committeeCode String?
  committeeAct  AuthorityAct?

  /// The row contains a step that cannot be delegated to anyone else.
  nonDelegable Boolean @default(false)

  /// Whether the APPROVAL step specifically is mandatory — act MA rather than A.
  approverMandatory Boolean @default(false)

  /// True where no rule exists for this matter and the routing shown is an
  /// assumption. Gaps rank last and warn loudly; they are never silently promoted.
  isGap   Boolean @default(false)
  gapNote String?

  note String @default("")
  /// Citation of the governing clause.
  clause String

  sortOrder Int @default(0)

  /// Whether this rule's chain is generated from the issue's core routing (FR-APR-004).
  /// Null: nobody has decided, and the route warns that its chain was not checked.
  /// False is a decision ("as entered") and needs `coreChainReason`.
  generateCoreChain Boolean?
  coreChainReason   String?

  recommenders AuthorityRuleStep[]

  @@unique([authorityMatrixId, ruleKey])
  @@index([authorityMatrixId, domain, method])
}

/// A recommending step on a rule. Ordered, because joint recommendations are
/// recorded in a fixed sequence on the routing sheets.
model AuthorityRuleStep {
  id              String        @id @default(cuid())
  authorityRuleId String
  authorityRule   AuthorityRule @relation(fields: [authorityRuleId], references: [id], onDelete: Cascade)

  roleCode String
  act      AuthorityAct
  sequence Int          @default(0)

  @@index([authorityRuleId])
}

/// A committee, board or external body that gates a decision.
model Committee {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Matches AuthorityRole.code where a rule routes to this body.
  code    String
  nameEn  String
  nameMs  String?
  mandate String

  /// The clause or form establishing the body.
  governingSource String

  action CommitteeAction @default(RECOMMENDS)
  /// True for bodies outside the organisation, whose decision is a precondition
  /// rather than an internal authority.
  isExternal Boolean @default(false)

  /// Null means no quorum has been set. That is not the same as zero, and the system
  /// must never infer one.
  quorum           Int?
  quorumProvenance Provenance?

  /// Whether who sits on this body is written down anywhere.
  compositionProvenance Provenance?

  /// Band the body's mandate applies to, where it is confined to one.
  valueScopeMin Decimal? @db.Decimal(18, 2)
  valueScopeMax Decimal? @db.Decimal(18, 2)

  notes String @default("")

  /// Other names the body goes by in the source documents.
  aliases   String[]  @default([])
  /// A retired body schedules nothing and keeps its history.
  retiredOn DateTime?

  /// The office whose holder tables matters before this body. An AuthorityRole.code,
  /// resolved through RoleAssignment on the tabling date. Null means nobody has set
  /// one, and tabling is refused rather than inferred.
  secretariatRoleCode String?

  /// Null means no rule has been set, and no decision can be recorded under it.
  votingRule           VotingRule?
  votingRuleProvenance Provenance?

  /// Whether an alternate may vote in place of a member who has recused on a matter.
  /// Null means nobody has said, and a matter where the question arises cannot be
  /// decided. RSAJ policy, not a product default.
  alternateMayVoteForRecused           Boolean?
  alternateMayVoteForRecusedProvenance Provenance?

  /// What this body calls a carried decision, as the customer writes it (an RSAJ
  /// committee would say "Perlu"). Null renders "Carried": never a borrowed word.
  carriedLabelEn String?
  carriedLabelMs String?

  /// 6.7 (FR-OPN-002): how many members an opening panel of this body has. No default: "two" is a
  /// customer's rule, seeded at go-live. Null blocks starting an opening; another size needs an
  /// override with its authority, reason and Person. A change is audited with a reason.
  panelSize           Int?
  panelSizeProvenance Provenance?
  /// 6.7 (FR-CTE-011, C-6): whether an opening panel of this body excludes members of one unit, and
  /// which (OrgUnit.code). Null rule: not set, and a panel is assigned with the warning "panel not
  /// checked", frozen on the opening.
  panelExclusionRule       Boolean?
  panelExcludesUnitCode    String?
  panelExclusionProvenance Provenance?

  members             CommitteeMember[]
  meetings            Meeting[]
  notApprovedOutcomes NotApprovedOutcome[]
  openings            Opening[]
  /// 6.13 Part A step 4 (FR-VAR-009): the organisations whose funder's consent this body decides.
  funderConsentPolicies PostAwardPolicy[]
  claimsForContractTypes ContractType[] @relation("ContractTypeClaimsCommittee")

  @@unique([organisationId, code])
}

/// A seat on a committee.
model CommitteeMember {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  /// A seat is held one of two ways, and exactly one must be set:
  ///
  ///  - ex officio, by whoever holds an office — `seatRoleCode`. This is how
  ///    composition is usually described: a body chaired by an office, never by
  ///    name. The holder resolves through RoleAssignment at the date of the sitting.
  ///  - by named appointment — `personId`, where a person is appointed to the seat.
  personId     String?
  person       Person? @relation(fields: [personId], references: [id], onDelete: Restrict)
  seatRoleCode String?
  /// How the seat is described in the source, for offices with no role code of their
  /// own because no rule routes to them directly.
  seatLabel    String?

  position    CommitteePosition @default(MEMBER)
  /// True where this person is an alternate for the seat rather than its holder.
  isAlternate Boolean           @default(false)
  provenance  Provenance        @default(ASSUMED)

  appointmentRef String?
  effectiveFrom  DateTime
  effectiveTo    DateTime?

  /// On an alternate, the seat it may cover. Null on an alternate means it may cover
  /// any seat of its position.
  alternateForId     String?
  alternateFor       CommitteeMember?    @relation("AlternateFor", fields: [alternateForId], references: [id], onDelete: SetNull)
  alternates         CommitteeMember[]   @relation("AlternateFor")
  standInAttendances MeetingAttendance[] @relation("StandIn")
  openingPanelSeats  OpeningPanelMember[]

  @@index([committeeId, effectiveFrom])
  @@index([personId])
}

/// A sitting of a committee.
model Meeting {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  reference   String
  meetingDate DateTime
  agenda      String        @default("")
  minutes     String        @default("")
  status      MeetingStatus @default(SCHEDULED)

  /// Why a cancelled sitting did not go ahead.
  cancelledReason String    @default("")
  /// Once minuted, the sitting and everything under it are frozen.
  minutedAt       DateTime?
  /// The register as it stood when minuted: seats, holders, alternates and who sat
  /// where. A minuted sitting renders from this, never from today's configuration.
  registerSnapshot Json?

  attendance  MeetingAttendance[]
  decisions   CommitteeDecision[]
  /// Signed minutes (FR-CTE-004), attached once the sitting is minuted.
  attachments DocumentAttachment[]

  @@unique([committeeId, reference])
  @@index([committeeId, meetingDate])
}

/// Who was present. Quorum counts from this, not from the membership list.
model MeetingAttendance {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Restrict)

  attended Boolean @default(true)
  /// Legacy free text. No longer written: `standingInForSeatId` replaced it.
  standingInFor String?
  /// The seat this person covered, where they sat in place of its holder.
  standingInForSeatId String?
  standingInForSeat   CommitteeMember? @relation("StandIn", fields: [standingInForSeatId], references: [id], onDelete: SetNull)

  @@unique([meetingId, personId])
}

/// A matter put to a committee, and what it decided.
model CommitteeDecision {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// Matches AuthorityRule.domain.
  domain  String
  subject String
  /// Reference of the exercise, contract or variation the matter concerns.
  matterRef String?
  amount    Decimal? @db.Decimal(18, 2)

  /// The authority act this decision discharges. A mandatory recommendation cannot
  /// be delegated or skipped.
  act AuthorityAct @default(R)
  /// The rule that required this body to sit, so the decision cites its source.
  authorityRuleKey String?

  outcome      DecisionOutcome @default(PENDING)
  decisionDate DateTime?

  /// Agenda order.
  sequence   Int         @default(0)
  /// The kind of record the matter concerns. Null is a manual matter.
  matterKind MatterKind?
  /// The requisition the matter concerns, where `matterKind` is REQUISITION. A typed
  /// foreign key per module (6.10 ruling), never a polymorphic pair.
  requisitionId String?
  requisition   Requisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  /// The exercise the matter concerns, where `matterKind` is EXERCISE (6.11): the typed
  /// key 6.10 reserves, linked by the exercise's portal reference when tabled.
  exerciseId    String?
  exercise      SourcingExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  approvalStep  ApprovalStep?
  /// The committee gate this matter answers (FR-REQ-012, ADR 0010). A decision serves
  /// one gate or one route step, never both.
  requisitionGateId String?
  requisitionGate   RequisitionGate? @relation(fields: [requisitionGateId], references: [id], onDelete: Restrict)
  /// The bill of quantities version a SCOPE matter tables for scope approval (6.2 OD-9,
  /// FR-REQ-014): a typed key, set only on a SCOPE matter (CHECK in the migration).
  bqVersionId String?
  bqVersion   BqVersion?       @relation(fields: [bqVersionId], references: [id], onDelete: SetNull)
  /// The late envelope a LATE_TENDER matter decides admission of (6.6 FR-CTE-008): a typed key,
  /// set only on a LATE_TENDER matter (CHECK in the migration). CARRIED admits it, NOT_CARRIED does not.
  bidEnvelopeId String?
  bidEnvelope   BidEnvelope?     @relation(fields: [bidEnvelopeId], references: [id], onDelete: SetNull)
  /// 6.7: the supplementary opening a carried admission opened (OD-5).
  supplementaryOpening Opening?
  /// 6.8 (FR-EVL-005): the evaluation bidder an EVALUATION_STAGE matter decides on, a two-stage
  /// tender's first stage (CHECK: set only on that kind). CARRIED unlocks its second stage.
  evaluationBidderId String?
  evaluationBidder   EvaluationBidder? @relation(fields: [evaluationBidderId], references: [id], onDelete: SetNull)
  /// 6.8 (FR-CTE-009): the evaluation versions a NOT_CARRIED loop on this matter opened.
  evaluationsLooped  Evaluation[]      @relation("EvaluationLoopDecision")
  /// 6.8 fix M-3 (E-8): the evaluation version in force, its bundle checked, when an appointment
  /// matter on an exercise was tabled. The matter is cited at award, and its NOT_CARRIED loop opens a
  /// version, only while that version is still the one in force. Null: tabled without an evaluation
  /// bundle (an exercise not evaluated in the portal), or before the version was recorded.
  evaluationVersion  Int?

  /// Withdrawn from the agenda before the sitting opened (6.10 follow-up). The row is
  /// kept, and the matter is left out of the votes, the quorum and the minuting.
  withdrawnAt     DateTime?
  withdrawnReason String    @default("")

  /// Who tabled the matter, and when. An attestation, not an authenticated act,
  /// until sign-in exists.
  tabledByPersonId String?
  tabledBy         Person?   @relation("TabledBy", fields: [tabledByPersonId], references: [id], onDelete: Restrict)
  tabledAt         DateTime?

  /// 6.13 Part A step 4 (FR-VAR-009, 010, 013; FR-PAD-004): the variation a VARIATION matter decides on, tabled from
  /// the variation's own record (its committee step's recommendation or approval, or the funder's consent): a typed
  /// key, set only on a VARIATION matter (CHECK in the migration).
  variationId String?
  variation   Variation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  /// 6.13 Part B (ADR 0029, OD-B5 A, BD-613-73): the contract matter a CONTRACT matter decides on, tabled from the matter's
  /// own record (its route's committee step), never at a sitting: a typed key, set only on a CONTRACT matter (CHECK
  /// CommitteeDecision_contract_matter in the migration).
  contractMatterId String?
  contractMatter   ContractMatter? @relation(fields: [contractMatterId], references: [id], onDelete: Restrict)

  /// A matter that cannot be decided while this one is pending.
  dependsOnDecisionId String?
  dependsOn           CommitteeDecision?  @relation("DependsOn", fields: [dependsOnDecisionId], references: [id], onDelete: SetNull)
  dependents          CommitteeDecision[] @relation("DependsOn")

  /// Snapshot at recording, so a later configuration change never rewrites a
  /// recorded decision. `presentVoters` is the count the matter's quorum was judged
  /// on (present and entitled on this matter); `recusedCount` is the recusals among
  /// those present.
  quorumRequired       Int?
  presentVoters        Int?
  recusedCount         Int?
  votingRule           VotingRule?
  votingRuleProvenance Provenance?
  /// Committee.alternateMayVoteForRecused as it stood when decided, so clearing or
  /// changing it later cannot unmake a decided matter.
  alternateMayVoteForRecused Boolean?

  /// Required for NOT_CARRIED: what happens to the matter next.
  notApprovedOutcomeId String?
  notApprovedOutcome   NotApprovedOutcome? @relation(fields: [notApprovedOutcomeId], references: [id], onDelete: Restrict)
  /// The outcome as it read when recorded, so a later rename cannot rewrite it.
  notApprovedOutcomeNameEn String?
  notApprovedOutcomeKind   NotApprovedKind?
  /// Required for DEFERRED and NOT_CARRIED.
  outcomeNote          String              @default("")

  votes    Vote[]
  recusals DecisionRecusal[]

  @@index([meetingId])
  @@index([requisitionId])
  @@index([exerciseId])
  @@index([requisitionGateId])
  @@index([bqVersionId])
  @@index([bidEnvelopeId])
  @@index([evaluationBidderId])
}

/// A member standing aside from one matter. Excluded from that matter's vote and
/// quorum only, never from the rest of the sitting.
model DecisionRecusal {
  id         String            @id @default(cuid())
  decisionId String
  decision   CommitteeDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  personId   String
  person     Person            @relation(fields: [personId], references: [id], onDelete: Restrict)

  reason     String
  declaredAt DateTime

  @@unique([decisionId, personId])
}

/// What a matter not carried does next, as the customer's policy names it. The
/// product ships none: they are one customer's options, not a default.
model NotApprovedOutcome {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?
  kind   NotApprovedKind
  /// For a loop, the stage the matter returns to. A stage key for Phase 2.
  returnsToStage String?

  /// Null offers the outcome to every committee.
  committeeId String?
  /// Restrict: deleting a committee must not silently widen its outcomes to every
  /// committee. Retire them first.
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: Restrict)

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  decisions CommitteeDecision[]

  @@unique([organisationId, code])
}

/// One member's vote. Individual, never one aggregate committee position.
model Vote {
  id         String            @id @default(cuid())
  decisionId String
  decision   CommitteeDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  personId   String
  person     Person            @relation(fields: [personId], references: [id], onDelete: Restrict)

  choice  VoteChoice
  comment String     @default("")
  /// The date on the signed voting sheet, as entered.
  votedAt DateTime   @default(now())
  /// When the vote was entered into the system.
  recordedAt DateTime @default(now())

  @@unique([decisionId, personId])
  @@index([decisionId])
}

/// When a reference series starts counting again.
enum NumberingReset {
  NEVER
  CALENDAR_YEAR
  FINANCIAL_YEAR
}

/// Money set aside, against a cost centre and an account code.
///
/// A requisition is checked against this before it may proceed. The period is
/// effective-dated rather than a bare year, because a customer's financial year is
/// not necessarily the calendar's and a supplementary allocation arrives mid-period.
model BudgetAllocation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Matches CostCentre.code and AccountCode.code. Held by code rather than by key
  /// because both are effective-dated and an allocation must keep naming the pair it
  /// was raised against.
  costCentreCode  String
  accountCodeCode String

  /// What the customer calls this period — a financial year, a supplementary vote.
  periodLabel String

  amount Decimal @db.Decimal(18, 2)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  commitments BudgetCommitment[]

  @@index([organisationId, effectiveFrom])
  @@index([organisationId, costCentreCode, accountCodeCode])
}

/// Money already spoken for against an allocation.
///
/// Released rather than deleted: a commitment that was raised and then stood down is
/// part of how the balance moved, and an audit that cannot show it is incomplete.
model BudgetCommitment {
  id           String           @id @default(cuid())
  allocationId String
  allocation   BudgetAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  /// The matter this was committed for, in the customer's own reference.
  reference   String
  description String  @default("")
  amount      Decimal @db.Decimal(18, 2)

  committedOn DateTime  @default(now())
  releasedOn  DateTime?
  releaseNote String    @default("")

  @@index([allocationId])
}

/// How a reference is formed.
///
/// A reference is the primary business key of a matter, so it is configured rather
/// than improvised. The pattern is written with tokens — {SERIAL}, {YEAR} — and the
/// segments around them are the customer's own.
model NumberingSeries {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// What this series numbers — `requisition`, `exercise`, `contract`, `certificate`.
  key    String
  nameEn String

  /// Tokens available: {SERIAL}, {YEAR}, {SHORTYEAR}, {MONTH}. Everything else is
  /// literal.
  pattern String

  /// How wide the serial is padded. 3 gives 001.
  padding Int @default(3)

  resetOn NumberingReset @default(CALENDAR_YEAR)
  /// The month a financial year starts, where the reset follows one. 1 is January.
  financialYearStartMonth Int @default(1)

  /// The next serial to issue. Never decremented and never reused: a gap is recorded
  /// rather than closed up.
  nextSerial Int @default(1)
  /// The period `nextSerial` belongs to, so a reset happens once rather than on every
  /// allocation within the new period.
  serialPeriod String @default("")

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")

  @@unique([organisationId, key])
}

/// A kind of document, and what the organisation must do with it.
model DocumentClass {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?

  /// Null means nobody has set a retention period. That is not the same as zero, and
  /// the system must never dispose of a record on an assumption. A set period is at
  /// least one month: zero is refused by a CHECK in the migration (BD-DS-10 as ruled).
  retentionMonths Int?

  /// Whether issued copies are numbered and recalled.
  controlledCopy Boolean @default(false)
  /// Whether release outside the organisation needs approval.
  releaseNeedsApproval Boolean @default(false)

  /// How a document of this class is classified (NFR-SEC-002). Null means nobody has
  /// set it: an unclassified document is listed but never served (OD-2).
  classification            SecurityClass?
  /// What starts the retention clock. Null: not set, and retention never elapses.
  retentionTrigger          RetentionTrigger?
  disposalMethod            DisposalMethod?
  /// The office whose authority a disposal needs, by AuthorityRole.code.
  disposalAuthorityRoleCode String?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)

  templates DocumentTemplate[]
  documents Document[]

  @@unique([organisationId, code])
}

/// A form the portal issues, and the printed original it has to stand next to.
model DocumentTemplate {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?

  /// The code printed on the controlled form, and the revision it is at.
  formCode     String    @default("")
  revisionDate DateTime?

  /// Whether the form carries both languages on one page.
  bilingual Boolean @default(false)

  documentClassId String?
  documentClass   DocumentClass? @relation(fields: [documentClassId], references: [id], onDelete: SetNull)

  /// The text of the instrument, as plain paragraphs with whitelisted {{field}} merge
  /// fields (ADR 0008). Null: not configured, and nothing can be issued on it. Ships empty.
  bodyMs          String?           @db.Text
  bodyEn          String?           @db.Text
  /// The language issued first. Null with both bodies set: not decided, and issue waits.
  primaryLanguage DocumentLanguage?
  /// Bumped on every audited change of a body, so an issued document names the text it was made from.
  bodyVersion     Int               @default(0)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)

  policiesLoa          AwardPolicy[]              @relation("PolicyLoaTemplate")
  policiesDeclaration  AwardPolicy[]              @relation("PolicyDeclarationTemplate")
  policiesCoveringMemo AwardPolicy[]              @relation("PolicyCoveringMemoTemplate")
  letterVariants       AppointmentLetterVariant[]
  awardDocuments       AwardDocument[]
  tenderPackParts      TenderPackPart[]
  tenderPackDocuments  TenderPackDocument[]
  windowNoticePolicies     WindowPolicy[]     @relation("WindowNoticeTemplate")
  windowInvitationPolicies WindowPolicy[]     @relation("WindowInvitationTemplate")
  windowAddendumPolicies   WindowPolicy[]     @relation("WindowAddendumTemplate")
  invitationLetters        InvitationLetter[]
  evaluationReportPolicies   EvaluationPolicy[] @relation("EvaluationReportTemplate")
  evaluationProposalPolicies EvaluationPolicy[] @relation("EvaluationProposalTemplate")
  proposalPapers             ProposalPaper[]
  /// 6.14 (FR-CRT-001): the form's signature blocks and distribution list; certificates printed on it.
  signatureBlocks      FormSignatureBlock[]
  distributionRows     FormDistribution[]
  certificates         Certificate[]
  certificateDocuments CertificateDocument[]
  routingSheetTypes    RoutingSheetType[]
  /// 6.13 (FR-SUP-003): the delegation letter pair's forms, per variant (certificate forms).
  policiesDelegationLetterConventional PostAwardPolicy[] @relation("PolicyDelegationLetterConventional")
  policiesDelegationNoticeConventional PostAwardPolicy[] @relation("PolicyDelegationNoticeConventional")
  policiesDelegationLetterDesignBuild  PostAwardPolicy[] @relation("PolicyDelegationLetterDesignBuild")
  policiesDelegationNoticeDesignBuild  PostAwardPolicy[] @relation("PolicyDelegationNoticeDesignBuild")
  /// 6.13 Part A step 3: the form each certificate kind prints on (certificate forms).
  kindSettings                         CertificateKindSetting[]
  /// 6.14 increment 2 (FR-CRT-001): the printed form's page count. Null: not recorded, and the fidelity line says so.
  pageCount                            Int?
  /// 6.14 increment 2: the printed form's fields with their label pairs, and the typing corrections that apply to it.
  printedFields                        FormField[]
  correctionForms                      TextCorrectionForm[]

  @@unique([organisationId, code])
}

/// What the portal sends, to whom, and when it chases.
model NotificationRule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The event that fires it — a configuration key, never rendered.
  eventKey String
  nameEn   String

  /// Offices notified, by AuthorityRole.code. Named by office rather than by person
  /// so a change of holder does not silently drop a mandatory recipient.
  recipientRoleCodes String[]

  /// Days before the due date to remind, largest first. Empty means it does not chase.
  reminderOffsetDays Int[]

  /// Where an unactioned step escalates.
  escalatesToRoleCode String?

  /// False where the organisation has decided this event notifies nobody. A rule that
  /// is off is a recorded decision; a rule that is absent is an oversight.
  isActive Boolean @default(true)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)

  @@unique([organisationId, eventKey])
}

/// Something an office may DO, as distinct from what it approves.
///
/// Approval routing comes from the authority matrix and answers "who signs this
/// matter at this value". A capability answers a different question — whether an
/// office may raise a requisition, certify a payment, or configure the portal at all.
/// Which capabilities exist is the customer's own arrangement, so they are rows.
model Capability {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?

  /// How the permissions grid is grouped. A label, not an enum: a customer who
  /// groups by division rather than by process should not need a migration.
  groupLabel String @default("")

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)

  roles RoleCapability[]

  @@unique([organisationId, code])
  @@index([organisationId, sortOrder])
}

/// One tick in the permissions grid.
///
/// A row exists only where the office holds the capability. Absence therefore means
/// "not granted", and an office with no rows at all means nobody has decided yet —
/// which the screen must not render as a deliberate deny.
model RoleCapability {
  id String @id @default(cuid())

  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  /// Matches AuthorityRole.code, by code rather than key for the same reason rules do.
  roleCode String

  grantedOn DateTime @default(now())

  @@unique([capabilityId, roleCode])
  @@index([roleCode])
}

/// One officer standing in for another, for a period.
///
/// Not the same as escalation. AuthorityRole.escalatesToCode moves authority UPWARD
/// when a holder cannot act, and applies to the office. A delegation is the holder's
/// own act: they hand named capabilities to a named person for named dates, possibly
/// under a ceiling. Recorded rather than inferred, because a decision signed under a
/// delegation has to name the delegation that permitted it.
model Delegation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  fromPersonId String
  fromPerson   Person @relation("DelegationFrom", fields: [fromPersonId], references: [id], onDelete: Restrict)
  toPersonId   String
  toPerson     Person @relation("DelegationTo", fields: [toPersonId], references: [id], onDelete: Restrict)

  /// The office the authority is being delegated out of.
  roleCode String

  /// What is handed over, by Capability.code. Empty means the whole office, which is
  /// a different and larger act — the screen says which.
  capabilityCodes String[]

  /// A ceiling on what may be approved under the delegation, where one is set. Null
  /// means no ceiling was set, which is not the same as a ceiling of zero.
  valueCeiling Decimal? @db.Decimal(18, 2)

  reason String @default("")
  /// The same reason in Malay. Recorded rather than translated: a delegation is the
  /// kind of thing that gets read back in the language it was written in.
  reasonMs String @default("")

  effectiveFrom DateTime
  effectiveTo   DateTime?

  /// True where the delegate may not delegate onward. Some offices forbid it outright.
  noSubDelegation Boolean @default(true)

  provenance Provenance @default(ASSUMED)

  /// Where the grantor is away, authority has reverted upward, and a re-delegation is
  /// allowed only on the absent holder's recommendation (FR-APR-012). Recorded as text:
  /// the signed recommendation is not attached until there is document storage.
  holderRecommendation String?
  holderRecommendedOn  DateTime?
  /// True where, when the document store landed, the recommendation was recorded as text
  /// and no signed recommendation had ever been attached (OD-6 legacy). Set once by the
  /// migration's backfill; never written by the application.
  recommendationTextOnlyAtLanding Boolean @default(false)

  approvalSteps ApprovalStep[]
  awardsSigned  Award[]
  /// 6.12: RSAJ contract signatures made under this delegation.
  contractSignatures ContractSignature[] @relation("ContractSignatureDelegation")
  certificateSignatures CertificateSignature[] @relation("CertificateSignatureDelegation")
  /// The absent holder's signed recommendation (FR-APR-012, OD-6).
  attachments   DocumentAttachment[]

  @@index([organisationId, effectiveFrom])
  @@index([fromPersonId])
  @@index([toPersonId])
}

/// What changed, when, and — once there is anybody to name — who changed it.
///
/// Configuration is policy. A threshold that moves without a record of who moved it
/// and why is the failure this product exists to prevent, so every write goes through
/// here. `actorPersonId` is null while sign-in does not exist; `unattributed` says so
/// explicitly, because a null that means "nobody was recorded" and a null that means
/// "the record was lost" must not look alike on a screen.
/// The organisation's logo, one row each. Kept out of the document store because that
/// store serves attachments only and a logo must render inline. Only PNG, JPEG and WebP
/// are accepted, decided by the file's own bytes and never by its name or declared type.
model OrganisationLogo {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  bytes     Bytes
  /// image/png, image/jpeg or image/webp, as sniffed.
  mediaType String
  sizeBytes Int
  /// Fingerprint of the bytes. A new upload is a new address, so nothing needs busting.
  sha256    String
  width     Int
  height    Int
  uploadedAt DateTime @default(now())

  @@index([sha256])
}

/// The picture on the left of the staff sign-in page. Stored as the logo is, and judged as it is: PNG, JPEG or WebP by the file's own bytes,
/// up to the same technical limit. One per organisation; none means the panel is drawn in the product's own colours.
model OrganisationSignInImage {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  bytes     Bytes
  /// image/png, image/jpeg or image/webp, as sniffed.
  mediaType String
  sizeBytes Int
  /// Fingerprint of the bytes. A new upload is a new address, so nothing needs busting.
  sha256    String
  width     Int
  height    Int
  uploadedAt DateTime @default(now())

  @@index([sha256])
}

/// The words and links on the staff sign-in page. Every column is the organisation's own choice and nullable: null means that element is
/// not drawn (the card's title falls back to the product's neutral "Sign in"). Nothing is seeded. Links are web addresses only, checked on
/// save and again when drawn.
model OrganisationSignInPage {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  portalName     String?
  headline       String?
  supportingText String?
  highlight1     String?
  highlight2     String?
  highlight3     String?
  tagline        String?
  privacyUrl     String?
  termsUrl       String?
  helpDeskUrl    String?
  updatedAt      DateTime @updatedAt
}

/// Append-only (ADR 0034 D11): a trigger refuses every UPDATE, DELETE and TRUNCATE, for every database login including the
/// owner, and the running app's login (perolehan_app) holds none of the three. Restrict: an organisation with a trail
/// cannot be deleted.
model AuditEntry {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// The model and row affected. Held as text rather than a relation: the row may be
  /// gone, and the trail has to outlive it.
  entity   String
  entityId String
  /// How the row read at the time, so a deleted entry is still legible.
  entityLabel String

  action AuditAction

  /// Field-level before and after: [{ field, before, after }]. JSON because the shape
  /// differs per entity and the trail must not need a migration to record a new one.
  changes Json

  /// Why the change was made. Required by the forms for a deletion.
  reason String @default("")

  /// Null until sign-in exists. Never inferred from whoever happens to be on record.
  actorPersonId String?
  actorPerson   Person? @relation(fields: [actorPersonId], references: [id], onDelete: Restrict)
  /// True where no sign-in existed to attribute the change to.
  unattributed Boolean @default(true)

  /// Who acted (ADR 0034 D11). Null on every row written before sign-in, and exactly then: the CHECK
  /// AuditEntry_actor_matches_kind holds `actorKind IS NULL` to mean `unattributed`, and holds exactly one
  /// actor reference to match the kind. No foreign key on the supplier account or the session: the trail
  /// has to outlive them, and the supplier tables arrive in Phase 4.
  actorKind              ActorKind?
  actorSupplierAccountId String?
  /// For a SYSTEM actor: what ran, in words ("bootstrap command", "demo loader").
  actorSystemLabel       String?
  actorSessionId         String?
  /// The offices the actor held when they acted: [{ roleCode, scope }].
  actorOffices           Json?
  /// Where the request came from, where one is known.
  sourceAddress          String?

  at DateTime @default(now())

  @@index([organisationId, at])
  @@index([entity, entityId])
}

/// A unit of the organisation: a company, division, department or section.
///
/// Effective-dated, because a reorganisation is a revision and not an overwrite. A
/// requisition raised last year was raised by the structure that existed then, and a
/// screen that re-renders it under today's departments misreports who asked for it.
model OrgUnit {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?
  kind   OrgUnitKind

  /// The unit this one sits under, by code rather than by id: a restructure that
  /// replaces a parent row should not orphan its children, and codes are what the
  /// customer's own charts are drawn in. Null at the top of the structure.
  parentCode String?

  /// The cost centre a unit's own spending is charged to, where it holds one. Units
  /// that hold no budget of their own leave this null.
  costCentreCode String?

  /// Who heads the unit. A Person rather than a role: the structure screen names the
  /// individual, and which role they hold is the roster's business.
  headPersonId String?
  headPerson   Person? @relation("OrgUnitHead", fields: [headPersonId], references: [id], onDelete: SetNull)

  /// Held by a company and by nothing else. On the shared table because a company is
  /// a unit — kind decides which of these a screen may ask for, and an edit to a
  /// department must leave every one of them alone.
  registrationNumber String?
  taxReference       String?
  telephone          String?
  /// The day the financial year turns, as month-day. Not a date: it recurs every
  /// year, and storing one year's instance invites reading it as a deadline.
  financialYearStart String?
  address            String  @default("")
  operatingLicence   String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@unique([organisationId, code, effectiveFrom])
  @@index([organisationId, effectiveFrom])
  @@index([organisationId, parentCode])
}

/// What spending is charged against.
///
/// The format varies by customer and is held as configuration rather than validated
/// against a pattern in code — see `CodeFormat`.
model CostCentre {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The code finance actually posts against. Authoritative: the segments below are
  /// how this system indexes and filters it, never how it is composed. Which
  /// segments a customer's code carries, and in what order, is `CodeFormat`.
  code   String
  nameEn String
  nameMs String?

  /// The unit whose spending it carries.
  orgUnitCode String?
  /// The site it belongs to, where the customer's cost centres name one.
  siteCode String?
  /// What the spending is for. A label rather than a list until a customer needs the
  /// list — reference data is where that would live.
  activity String @default("")

  /// Who answers for it. Null where nobody has been named, which is not nobody.
  ownerPersonId String?
  ownerPerson   Person? @relation("CostCentreOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@unique([organisationId, code, effectiveFrom])
  @@index([organisationId, effectiveFrom])
}

/// What a movement did to a budget code's money.
///
/// One ledger rather than a table per kind: the allocations tab reads the first four
/// and the availability tab reads the last two, and a transfer is two rows that must
/// balance. Splitting them would make that arithmetic cross tables.
enum BudgetMovementKind {
  ORIGINAL /// The allocation as first approved.
  REVISION /// Added to or taken off the original, by decision.
  TRANSFER_IN /// Moved in from another code.
  TRANSFER_OUT /// Moved out to another code.
  COMMITMENT /// Approved but not yet paid. Released without being spent, or realised.
  ACTUAL_SPEND /// Paid.
}

/// One accounting period a budget year is divided into.
///
/// Open and closed are decisions somebody takes, so both are timestamps rather than a
/// status word: a period nobody has opened yet is neither open nor closed, and a
/// single boolean cannot hold that third state.
model BudgetPeriod {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  year Int
  /// The customer's own label for the period — P01, Q1, whatever they run.
  code   String
  nameEn String
  nameMs String?

  startsOn DateTime
  endsOn   DateTime

  /// When it was opened for posting. Null means nobody has opened it yet, which is
  /// not the same as it having been closed.
  openedOn DateTime?
  /// When it was closed. Null while it is open, or before it was ever opened.
  closedOn DateTime?

  sortOrder Int @default(0)

  @@unique([organisationId, year, code])
  @@index([organisationId, year])
}

/// Settings that belong to a budget year rather than to one of its periods.
model BudgetYear {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  year Int

  /// Whether unspent allocation carries into the next year. Null where nobody has
  /// decided — carrying nothing forward is a policy, and so is not carrying it.
  rollUnspentForward Boolean?

  @@unique([organisationId, year])
}

/// A budget code — what a requirement is charged to.
///
/// Identity, kept apart from the money on it. The code is what the customer's finance
/// system knows; what it is worth this year is a ledger of movements, because an
/// allocation is revised and transferred and a single amount column cannot say by
/// whom or when.
model BudgetCode {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code          String
  descriptionEn String
  descriptionMs String?

  /// Capital, Operating — the customer's own vocabulary, so a label rather than an
  /// enum. A customer with a third kind must not need a migration.
  type String @default("")

  /// The unit that answers for it, by OrgUnit.code.
  owningUnitCode String?

  /// The line of the chart of accounts it posts to. Held as a code, like everywhere
  /// else money is referenced, because account codes are effective-dated.
  accountCode String @default("")

  /// Who holds the budget. Null where nobody has been named, which is not nobody.
  holderPersonId String?
  holderPerson   Person? @relation("BudgetHolder", fields: [holderPersonId], references: [id], onDelete: SetNull)

  /// False stops it being offered anywhere in the portal. Distinct from the period:
  /// a code can be inside its dates and still withdrawn.
  isActive Boolean @default(true)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  movements    BudgetMovement[]
  requisitions Requisition[]
  budgetChecks RequisitionBudgetCheck[]

  @@unique([organisationId, code])
  @@index([organisationId, effectiveFrom])
}

/// One movement on a budget code.
model BudgetMovement {
  id           String     @id @default(cuid())
  budgetCodeId String
  budgetCode   BudgetCode @relation(fields: [budgetCodeId], references: [id], onDelete: Cascade)

  kind BudgetMovementKind

  /// The requisition, contract or instrument that caused it.
  reference   String @default("")
  description String @default("")

  /// Positive, and the kind says which way it moves — except REVISION, the one
  /// direction-neutral kind, which is signed: a revision down is stored negative.
  /// Read direction through `ledgerLines`, never from the kind alone.
  amount Decimal @db.Decimal(18, 2)

  occurredOn DateTime

  /// Set when a commitment was released without being spent. A released commitment
  /// stays on the ledger: it held budget for a time and the trail has to show it.
  releasedOn  DateTime?
  releaseNote String    @default("")

  /// The code on the other side of a transfer, by code.
  counterpartCode String?

  @@index([budgetCodeId, kind])
  @@index([budgetCodeId, occurredOn])
}

/// How the portal reconciles with the customer's finance system.
///
/// Named settings rather than a connection: this product is a standalone system of
/// record that integrates behind a façade, so what is configured here is the
/// arrangement, and the adapter that honours it arrives with the integration.
model FinanceIntegration {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Which way records move. The customer's own arrangement, so a label.
  direction String?
  /// How often. Null where nobody has said, which is not the same as never.
  schedule String?
  /// How far apart the two sides may be before it counts as a variance.
  varianceTolerance Decimal? @db.Decimal(18, 2)
  /// Where a requisition's budget check comes from: the portal's own ledger, or
  /// figures typed in from the finance system. Null means nobody has said, and no
  /// check can be run — it never falls back to either.
  budgetCheckSource BudgetCheckSource?
}

/// One reconciliation run.
model FinanceSyncRun {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  startedAt  DateTime
  finishedAt DateTime?

  direction  String @default("")
  recordsIn  Int    @default(0)
  recordsOut Int    @default(0)

  /// What the run could not do, in its own words. Empty on a clean run.
  problem String @default("")

  @@index([organisationId, startedAt])
}

/// A budget code the two systems disagree about.
///
/// The difference is not stored: it is the two figures subtracted, and a column
/// holding it could disagree with them. Kept after it is settled rather than
/// deleted — that the two sides once differed is the thing an audit asks about.
model FinanceVariance {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  budgetCodeCode String
  accountCode    String @default("")

  /// What is being compared — an allocation, a commitment, a payment.
  compares String @default("")

  portalAmount  Decimal @db.Decimal(18, 2)
  financeAmount Decimal @db.Decimal(18, 2)

  /// Why they differ, as far as anyone knows. Empty where nobody has said.
  reason String @default("")

  lastSeenAt DateTime

  /// Set when somebody accepted one side's figure. The row stays.
  resolvedOn   DateTime?
  resolvedNote String    @default("")

  @@index([organisationId, lastSeenAt])
}

/// How this customer wants the budget check to behave.
///
/// Every field is nullable on purpose. A threshold nobody has set is not a threshold
/// of zero, and a screen that renders the two the same way invents a policy.
model BudgetSettings {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Whether an availability check stops a requirement or merely warns about it.
  availabilityCheck String?

  warningThresholdPercent        Int?
  overCommitmentTolerancePercent Int?

  /// Whether approving a requirement commits the budget there and then.
  commitOnApproval Boolean?

  /// Roles that may proceed past a failed check, by AuthorityRole.code.
  overrideRoleCodes String[]

  advanceRecoupmentRatePercent Int?
  minimumInterimCertificate    Decimal? @db.Decimal(18, 2)
  paymentTargetDays            Int?
}

/// A line of the chart of accounts. Paired with a cost centre, this is what a budget
/// availability check is run against.
model AccountCode {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@unique([organisationId, code, effectiveFrom])
  @@index([organisationId, effectiveFrom])
}

/// A place goods are delivered to or works are carried out at. Named on requisitions
/// and on the certificates that follow them.
model Site {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code    String
  nameEn  String
  nameMs  String?
  address String @default("")

  /// What sort of place it is — treatment plant, office, depot. A label, because the
  /// list is the customer's and a new kind must not need a migration.
  kind String @default("")
  town     String @default("")
  district String @default("")

  /// The unit responsible for the site, where one is.
  orgUnitCode String?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@unique([organisationId, code, effectiveFrom])
  @@index([organisationId, effectiveFrom])
}

/// The shape a reference code must take.
///
/// One customer's cost centre is five dot-separated segments and another's is not.
/// A pattern compiled into the application is a hard-coded policy value in the same
/// way a threshold is, so the pattern is configuration and carries an example and a
/// description for the officer who has to satisfy it.
model CodeFormat {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// What this format governs — `cost_centre`, `account_code`. A key, never rendered.
  key String

  /// A regular expression, anchored by the validator rather than by the author.
  pattern String
  /// Shown to the officer entering the value. A pattern nobody can read is not a
  /// requirement anybody can meet.
  example     String @default("")
  description String @default("")

  provenance Provenance @default(ASSUMED)

  @@unique([organisationId, key])
}

/// How a matter is funded.
///
/// The master gate, and the one piece of reference data that changes whether the
/// organisation procures at all: under some routes it appoints nobody and only
/// verifies eligibility, inspects and accepts the asset. Which routes exist, and
/// what each implies, is the customer's own arrangement with its funders — so a
/// table, never a literal.
model FundingRoute {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?

  /// False where the organisation does not run the procurement itself. Such a route
  /// still produces a record — eligibility, inspection, acceptance — but no award.
  organisationProcures Boolean @default(true)

  /// True where an external body, not this organisation, decides the sourcing route.
  /// The organisation still procures; it does not choose how.
  routeDecidedExternally Boolean @default(false)

  /// True where the funder's own guidelines override the approval matrix wherever the
  /// two differ. The engine warns and does not silently re-route: what the external
  /// rule set actually says is not something this system holds.
  supersedesAuthority Boolean @default(false)

  /// What starts a matter down this route, in the customer's own words.
  trigger String @default("")

  /// True where a matter on this route may not progress until an external body's
  /// authority is recorded against it — a funder's execution letter, say (FR-REQ-005).
  requiresExternalAuthorityRef Boolean @default(false)
  /// What that authority is called, as the customer names it. Shown on the field.
  externalAuthorityRefLabel    String?

  /// Whether approving a matter on this route commits the organisation's own budget
  /// (6.1 ruling BD-13). Null: nobody has said, and approval writes no commitment and
  /// says so. Whether the organisation procures is not a proxy for it.
  approvalCommitsBudget           Boolean?
  approvalCommitsBudgetProvenance Provenance?

  /// Whether an approved requisition on this route must pass a committee gate before
  /// its first sourcing exercise (FR-REQ-012, ruling CO-1). Null: nobody has said, and
  /// it blocks opening an exercise. False: no gate. True: the route's gate rules apply.
  committeeGateRequired           Boolean?
  committeeGateProvenance         Provenance?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)

  /// Retired rather than deleted: a matter already routed under this entry must still
  /// render the route it was actually run under.
  retiredOn DateTime?

  @@unique([organisationId, code])
  @@index([organisationId, sortOrder])
}

/// How suppliers are approached for a matter.
///
/// A sourcing method is not a label. It decides what documents are assembled, whether
/// the exercise is advertised or invited, which body sits on it, and what instrument
/// awards it. Value bands are deliberately absent — those live in the authority
/// matrix's policy, and restating them here would create a second place to get them
/// wrong.
model SourcingMethod {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?

  /// Which value regimes this method may be used in. A method available at any value
  /// sets all three; one confined to a band sets only that band. The thresholds
  /// themselves stay in the matrix policy.
  availableInTender    Boolean @default(false)
  availableInQuotation Boolean @default(false)
  availableBelow       Boolean @default(false)

  /// Whether the exercise is advertised openly, and whether named suppliers are
  /// invited. Both may be false — a direct appointment does neither.
  requiresAdvertisement Boolean @default(false)
  invitesNamedSuppliers Boolean @default(false)

  /// False where the method calls off an existing contract instead of sourcing afresh,
  /// as a schedule of rates does. Such a matter has no bids and no evaluation.
  requiresFreshSourcing Boolean @default(true)

  /// The instrument that awards a matter sourced this way, as the customer names it.
  awardInstrument String @default("")

  /// The body that sits on matters sourced this way, matching Committee.code. Null
  /// where the method routes to an individual office instead.
  committeeCode String?

  /// The value of AuthorityRule.method that bands the approval rows for this method.
  /// Held explicitly because several methods commonly share one row.
  authorityMethodKey String?

  /// The method proposed in each regime (FR-MTD-005). At most one per regime is
  /// meant; none means the approver "depends on the method", never a guess.
  defaultInTender    Boolean @default(false)
  defaultInQuotation Boolean @default(false)
  defaultBelow       Boolean @default(false)

  /// What choosing this method asks of the exercise.
  requiresJustification      Boolean @default(false)
  justificationPrompt        String  @default("")
  requiresProposal           Boolean @default(false)
  requiresNameApproval       Boolean @default(false)
  restrictedAccess           Boolean @default(false)
  requiresDossier            Boolean @default(false)
  requiresCoordinationRecord Boolean @default(false)
  /// 6.2 OD-6: whether an exercise sourced this way needs a lodged company estimate before
  /// its documents go for approval. Null: not set, and packFaults blocks naming it. Its
  /// own provenance, since the row's may be STATED while this answer is assumed.
  requiresCompanyEstimate           Boolean?
  requiresCompanyEstimateProvenance Provenance?
  /// 6.2 OD-9, FR-REQ-014: whether an exercise sourced this way has its finalised bill's
  /// scope approved by a committee before its documents go for approval. Null: not set, and
  /// packFaults blocks naming it (never read as "not required"). Its own provenance, as
  /// requiresCompanyEstimate's. The committee (Committee.code) that approves it; unset while
  /// the rule says yes also blocks.
  scopeApprovalRequired             Boolean?
  scopeApprovalProvenance           Provenance?
  scopeCommitteeCode                String?
  /// The act the committee discharges on a scope matter (overrides BD-62-16's officer choice):
  /// tabling writes it, and only a matter carried under it approves the scope. Null: not set,
  /// and tabling and packFaults block naming it. Its own provenance, as the committee's answer.
  scopeAct                          AuthorityAct?
  scopeActProvenance                Provenance?
  /// 6.4 (FR-DOC-001, 013): the tender pack an exercise sourced this way assembles. Null: not
  /// set, and the move into preparation blocks naming it. NONE: no pack (a direct appointment).
  documentPackKind                  PackKind?
  documentPackKindProvenance        Provenance?
  /// 6.6 (OD-5, D9, R11): the committee (Committee.code) that decides whether a late envelope is
  /// admitted. Null: not set, and tabling an admission, and the award where a late envelope
  /// exists, are refused naming it. Never read as "reject".
  lateAdmissionCommitteeCode        String?
  lateAdmissionProvenance           Provenance?
  /// 6.6 (FR-BID-011, B7): the fewest bids the method expects. Null: not set, never "met".
  minimumBids                       Int?
  minimumBidsProvenance             Provenance?
  /// 6.6 (FR-BID-007, OD-8, R12, D10): whether an incomplete bid is eliminated (true) or reported
  /// to the committee (false). Null: not set, and 6.7 cannot finalise an opening.
  completenessEliminates            Boolean?
  completenessProvenance            Provenance?
  /// 6.7 (FR-OPN-001): the committee (Committee.code) whose members open bids sourced this way. Null:
  /// not set, and an opening cannot be started, naming this setting.
  openingCommitteeCode              String?
  openingCommitteeProvenance        Provenance?
  /// 6.7 (OD-4, X-11): what follows from a bid by a bidder with no live sale, or not invited. Null:
  /// not set, and an opening holding such a bid cannot finalise, naming this setting.
  unpurchasedBidConsequence         UnpurchasedConsequence?
  unpurchasedProvenance             Provenance?
  /// 6.8 (FR-EVL-006): the evaluation model (EvaluationModel.code) offered first on the Window card
  /// for an exercise of this method. A suggestion only: the officer chooses, and nothing is pinned
  /// without that choice.
  defaultEvaluationModelCode        String?
  /// The numbering series (NumberingSeries.key) a dossier reference is issued from.
  dossierSeriesKey String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)

  retiredOn DateTime?

  checklistItems MethodChecklistItem[]

  @@unique([organisationId, code])
  @@index([organisationId, sortOrder])
}

/// What is being bought.
///
/// The classification drives a long tail of downstream behaviour — retention, defects
/// liability, the certificates issued. Where no governing document defines it, the
/// classification is reverse-engineered from the clauses that actually differ, which
/// is precisely what `provenance` is for.
model ContractType {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?

  /// Which deliverable this type is the default for (FR-MTD-011). Null: none.
  deliverableKind DeliverableKind?

  /// The downstream behaviours the type drives (FR-MTD-012). Null or empty means not
  /// set: the screen says so rather than reading it as "no".
  pricingBasis                String?
  registrationTest            String?
  administratorRoleCodes      String[] @default([])
  startRequiresSecurities     Boolean?
  eotInstrument               String?
  completionInstrument        String?
  defectsLiabilityApplies     Boolean?
  makingGoodCertificate       Boolean?
  nominationAllowed           Boolean?
  interimPaymentRule          String?
  sumAdjustmentDrivers        String[] @default([])
  claimsApprovalCommitteeCode String?
  /// 6.13 Part A step 1 (A7, FR-MTD-012): the typed twin of `sumAdjustmentDrivers`, which stays as its label:
  /// which of FR-PAD-001's five triggers a contract of this type may adjust its sum by. Empty: not set, and the
  /// adjustment certificate refuses naming the setting (6.13 step 4).
  sumAdjustmentTriggers       SumAdjustmentTrigger[] @default([])
  /// 6.13 (FR-SUP-003): which pair of delegation letters a contract of this type takes: conventional
  /// (Appendix A/1 and A/2) or design and build and turnkey (B/1 and B/2). Null: not set, and a delegation is
  /// refused naming the setting.
  delegationVariant           DelegationVariant?
  /// 6.13 Part B run 1a (FR-MTD-012's remaining behaviours, BD-613-7): the typed twins of `eotInstrument`,
  /// `completionInstrument` and `claimsApprovalCommitteeCode`, which stay as their labels. Null: not set (NOT_SET),
  /// and the act that reads one says so (runs 1b and 2).
  eotInstrumentKind           EotInstrumentKind?
  completionVariant           CompletionVariant?
  /// OD-B20: the committee that approves this type's loss-and-expense claims. Restrict (BD-613-102): a committee a
  /// contract type names for its claims cannot be deleted from under it.
  claimsCommitteeId           String?
  claimsCommittee             Committee?          @relation("ContractTypeClaimsCommittee", fields: [claimsCommitteeId], references: [id], onDelete: Restrict)

  /// The numbering series (NumberingSeries.key) a contract of this type is numbered
  /// from when its award is issued (FR-CON-002, 6.11). Null: not set, and issue refuses.
  contractSeriesKey String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)

  retiredOn DateTime?

  @@unique([organisationId, code])
  @@index([organisationId, sortOrder])
}

/// FR-SUP-003 (SK005 §7.3.1, §7.3.3): the delegation letter pair a contract type takes.
enum DelegationVariant {
  CONVENTIONAL
  DESIGN_AND_BUILD
}

/// FR-PAD-001's five triggers of a contract-sum adjustment (SK013): a closed product vocabulary, rendered by label.
enum SumAdjustmentTrigger {
  VARIATION
  LOSS_AND_EXPENSE
  REMEASUREMENT
  PC_AND_PROVISIONAL_SUMS
  PRICE_FLUCTUATION
}

// ------------------------------------------------------------------ 6.1 requisitions

/// Where a requisition stands (spec §7.3.1). One machine for both entry paths.
enum RequisitionStatus {
  DRAFT
  ENDORSED
  RETURNED
  REGISTERED
  BUDGET_CHECKED
  OVER_BUDGET
  PENDING_APPROVAL
  REJECTED
  RECALLED
  APPROVED
  SOURCING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  CLOSED
}

/// Raised in the portal, or received from the finance system (ADR 0003).
enum RequisitionOrigin {
  PORTAL
  EXTERNAL
}

/// How a finance-system reference reached the portal. Typed in by an officer, or
/// delivered by an adapter once one exists.
enum ExternalRefSource {
  MANUAL
  ADAPTER
}

/// Where a budget check's figures came from (ADR 0004).
enum BudgetCheckSource {
  PORTAL_LEDGER /// Computed from the portal's movement ledger.
  MANUAL_ERP_ENTRY /// Typed in by hand from the finance system, stored exactly as typed.
}

enum BudgetVerdictState {
  WITHIN
  EXCEEDS
  NO_BUDGET
  AMBIGUOUS
}

/// The anti-splitting result. NOT_SET is its own answer: an unconfigured check has
/// cleared nothing, and is never later shown as CLEAR.
enum SplitState {
  CLEAR
  FLAGGED
  NOT_SET
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RECALLED
}

enum StepDecision {
  PENDING
  DONE
  REJECTED
}

/// The comparison applied at a band edge that sat on the boundary value.
enum BoundaryOperator {
  GT /// Above the boundary: a value exactly on it falls in the lower band.
  GTE /// At or above: a value exactly on it falls in the upper band.
}

/// A requisition: a department asking to spend (FR-REQ-001).
///
/// Unit, cost centre, account and site are held by code, like everywhere else money is
/// referenced, because those lists are effective-dated and a requisition must keep
/// naming what it was raised against.
model Requisition {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The portal's own reference, issued atomically from NumberingSeries `requisition`.
  reference String
  origin    RequisitionOrigin @default(PORTAL)

  /// The finance system's requisition number and note number. Consumed, never
  /// minted: recorded when the finance system returns them.
  erpRequisitionNo String?
  erpNoteNo        String?
  erpRefSource     ExternalRefSource?
  erpRefRecordedAt DateTime?

  requestingUnitCode String
  sectionUnitCode    String?
  requestingPersonId String
  requestingPerson   Person  @relation("RequestedBy", fields: [requestingPersonId], references: [id], onDelete: Restrict)

  title         String
  justification String
  needStatement String

  costCentreCode  String
  accountCode     String
  budgetCodeId    String?
  budgetCode      BudgetCode? @relation(fields: [budgetCodeId], references: [id], onDelete: Restrict)
  siteCode        String?
  placeOfDelivery String

  dateRequired   DateTime
  estimatedValue Decimal  @db.Decimal(18, 2)
  /// The organisation's day it was raised. The splitting window counts from this.
  raisedOn       DateTime

  fundingRouteCode String?
  /// The funding route as it read at submission, so a later edit to the route never
  /// rewrites what the requisition was sent down under.
  fundingSupersedesAuthority Boolean?
  sourcingPermitted          Boolean?
  fundingPosture             String?
  /// The external body's authority, where the route requires one (FR-REQ-005).
  externalAuthorityRef String?
  contractTypeCode     String?

  status RequisitionStatus @default(DRAFT)

  /// The completeness return (FR-REQ-010): why, to whom, and when.
  returnedReason     String    @default("")
  returnedToPersonId String?
  returnedTo         Person?   @relation("ReturnedTo", fields: [returnedToPersonId], references: [id], onDelete: Restrict)
  returnedOn         DateTime?
  cancelReason       String    @default("")

  /// The COMMITMENT movement written on approval, where the settings call for one.
  commitmentMovementId String?

  /// When the committee gates were determined (FR-REQ-012), and whether the route
  /// required one then. Both null on a requisition approved before gates existed, or
  /// while the route's setting was unset: undetermined, never passed.
  gatesDeterminedOn      DateTime?
  gateRequired           Boolean?
  gateRequiredProvenance Provenance?
  /// Why an approved requisition was closed without sourcing (a gate ended it).
  closedReason String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines              RequisitionLine[]
  endorsements       RequisitionEndorsement[]
  budgetChecks       RequisitionBudgetCheck[]
  splitChecks        RequisitionSplitCheck[]
  approvalInstances  ApprovalInstance[]
  committeeDecisions CommitteeDecision[]
  exercises          SourcingExercise[]
  gates              RequisitionGate[]

  @@unique([organisationId, reference])
  @@unique([organisationId, erpRequisitionNo])
  @@unique([organisationId, erpNoteNo])
  @@index([organisationId, status])
  @@index([organisationId, raisedOn])
}

model RequisitionLine {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  lineNo             Int
  description        String
  quantity           Decimal? @db.Decimal(18, 4)
  unit               String?
  estimatedUnitPrice Decimal? @db.Decimal(18, 2)
  estimatedAmount    Decimal  @db.Decimal(18, 2)
  catalogueRef       String?

  @@unique([requisitionId, lineNo])
}

/// One tier's endorsement (FR-REQ-003). Names a Person; "named user" waits for sign-in.
model RequisitionEndorsement {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  tier       OrgUnitKind
  unitCode   String
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  endorsedOn DateTime
  recordedAt DateTime @default(now())
  note       String   @default("")

  @@unique([requisitionId, tier])
}

/// One budget check, append-only (FR-REQ-007, ADR 0004).
model RequisitionBudgetCheck {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  checkedAt DateTime          @default(now())
  asAt      DateTime
  source    BudgetCheckSource

  budgetCodeId   String?
  budgetCode     BudgetCode? @relation(fields: [budgetCodeId], references: [id], onDelete: SetNull)
  /// The code as it read at the check.
  budgetCodeCode String?

  requestedAmount Decimal @db.Decimal(18, 2)

  /// The four figures of the request form. Null where the source gave none.
  actualBudget              Decimal?   @db.Decimal(18, 2)
  balanceAsAt               Decimal?   @db.Decimal(18, 2)
  /// Committed plus spent on the portal ledger, ASSUMED until the customer's finance
  /// confirms what the form means by it. Never read by the verdict.
  approvedAccount           Decimal?   @db.Decimal(18, 2)
  approvedAccountProvenance Provenance
  projectedBalance          Decimal?   @db.Decimal(18, 2)

  verdict BudgetVerdictState
  /// Warnings raised alongside the verdict, as keys, space-separated.
  outcome String             @default("")

  approvalInstances ApprovalInstance[]

  @@index([requisitionId, checkedAt])
}

/// One anti-splitting assessment (FR-REQ-015), with the policy it ran under.
model RequisitionSplitCheck {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  checkedAt DateTime   @default(now())
  state     SplitState

  windowDays           Int?
  matchOn              String[]
  aggregateAcrossYear  Boolean?
  policyProvenance     Provenance?
  relatedRequisitionIds String[]
  /// The related requisitions' references as they read, for the screen.
  relatedReferences    String[]
  combinedValue        Decimal?  @db.Decimal(18, 2)
  crossesBand          Boolean?
  /// Why a NOT_SET check could not run: the settings or keys it lacked.
  notSetReasons        String[]  @default([])

  overrideJustification String?
  overriddenOn          DateTime?
  overriddenByPersonId  String?
  overriddenBy          Person?   @relation(fields: [overriddenByPersonId], references: [id], onDelete: Restrict)
  overriddenAt          DateTime?

  approvalInstances ApprovalInstance[]

  @@index([requisitionId, checkedAt])
}

/// How this customer wants requisitions controlled. One per organisation, every field
/// unset until the customer sets it: an unset window is not a window of zero.
model RequisitionPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  splittingWindowDays          Int?
  /// Which fields make two requisitions related: unit, costCentre, accountCode,
  /// budgetCode, contractType. Empty means not set.
  splittingMatchOn             String[]      @default([])
  splittingAggregateAcrossYear Boolean?
  /// A check older than this many days is re-run on submission. Null: never stale.
  budgetRecheckDays            Int?
  /// The tiers whose heads endorse before submission. Empty means not set.
  endorsementTiers             OrgUnitKind[] @default([])
  /// The office whose holder may justify a flagged split (6.1 ruling Q3), by
  /// AuthorityRole.code. Null blocks justification.
  splitJustifyingRoleCode      String?

  provenance Provenance?
  notes      String      @default("")
}

/// A resolved approval route, persisted (ADR 0005). Generic across matters.
///
/// Snapshots every rule it was judged under, so a later edit to the limits, the
/// budget settings or the splitting policy never rewrites what the approvers saw.
model ApprovalInstance {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  matterKind    MatterKind
  requisitionId String?
  requisition   Requisition? @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  /// The exercise, where `matterKind` is EXERCISE (name approval, 6.3).
  exerciseId    String?
  exercise      SourcingExercise? @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  /// The award whose appointment this route approves (6.11): an exercise's award can be
  /// cancelled and another started, and only its own route may approve it.
  awardId       String?
  award         Award?            @relation(fields: [awardId], references: [id], onDelete: Restrict)
  /// 6.15 (OD-2 A): the supplier's application this route decides (a SUPPLIER matter). An application
  /// may carry several routes over time: a refused one is followed by a new one when it is sent again.
  supplierApplicationId String?
  supplierApplication   SupplierApplication? @relation(fields: [supplierApplicationId], references: [id], onDelete: Restrict)
  /// 6.15a (OD-8 A): a blacklisting, or its lifting, asked for on the register.
  standingRequestId     String?
  standingRequest       StandingRequest? @relation(fields: [standingRequestId], references: [id], onDelete: Restrict)
  /// 6.15a (FR-ADV-017): a special permission granted inside the organisation.
  specialPermissionId   String?
  specialPermission     SpecialPermission? @relation(fields: [specialPermissionId], references: [id], onDelete: Restrict)
  /// 6.14 (ADR 0022, 0023): the certificate this route approves (a CERTIFICATE matter). A refused route is
  /// followed by a successor (ADR 0009), so a certificate may carry several.
  certificateId         String?
  certificate           Certificate?      @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  /// 6.13 Part A step 4 (614-C4, FR-VAR-008): the variation this route approves (a VARIATION matter): its prior
  /// approval, an increase, the use of agreed rates, or a re-measurement (VariationApproval says which).
  variationId           String?
  variation             Variation?        @relation(fields: [variationId], references: [id], onDelete: Restrict)
  variationApproval     VariationApproval?
  /// 6.13 Part B (ADR 0029, OD-B5 A): the contract matter this route decides (a CONTRACT matter): CHECK
  /// ApprovalInstance_contract_matter ((matterKind = 'CONTRACT') = (contractMatterId IS NOT NULL)).
  contractMatterId      String?
  contractMatter        ContractMatter?   @relation("ContractMatterRoutes", fields: [contractMatterId], references: [id], onDelete: Restrict)
  /// The matter whose approval of record this route is (its one writer: the route hook, run 1b).
  approvalOfRecordFor   ContractMatter?   @relation("ContractMatterApprovalOfRecord")
  /// 6.13 Part A step 3: who sent a certificate's route (recorded on their behalf, not signed); the self-approval
  /// check bars them from deciding it. Null on every other route.
  submittedByPersonId   String?
  submittedBy           Person?           @relation("RouteSubmittedBy", fields: [submittedByPersonId], references: [id], onDelete: Restrict)

  domain String
  cond   String?
  /// What the matter was routed on. Null only where the matter is not routed on a value (6.15 OD-2 A:
  /// a supplier matter), which matches only a rule with no value band; never an invented 0.
  value  Decimal? @db.Decimal(18, 2)

  /// Null for a trail received from outside.
  authorityMatrixId String?
  authorityMatrix   AuthorityMatrix? @relation("InstanceMatrix", fields: [authorityMatrixId], references: [id], onDelete: Restrict)
  matrixLabel       String?
  ruleKey           String?
  ruleLabel         String?
  ruleClause        String?

  /// The boundary as it stood, and the comparison applied at it. The operator is null
  /// when no edge of the rule sat on the boundary.
  boundaryValue             Decimal?          @db.Decimal(18, 2)
  boundaryInclusive         Boolean?
  ruleFollowsBoundarySwitch Boolean?
  boundaryOperator          BoundaryOperator?

  fundingRouteCode       String?
  fundingOverrideApplied Boolean          @default(false)
  overrideMatrixId       String?
  overrideMatrix         AuthorityMatrix? @relation("InstanceOverrideMatrix", fields: [overrideMatrixId], references: [id], onDelete: Restrict)
  overrideMatrixLabel    String?

  budgetCheckId     String?
  budgetCheck       RequisitionBudgetCheck? @relation(fields: [budgetCheckId], references: [id], onDelete: SetNull)
  budgetVerdict     BudgetVerdictState?
  /// BudgetSettings.availabilityCheck as it stood at submission. Null: not set.
  availabilityCheck String?
  overBudgetInvoked Boolean                 @default(false)

  splitCheckId String?
  splitCheck   RequisitionSplitCheck? @relation(fields: [splitCheckId], references: [id], onDelete: SetNull)
  splitState   SplitState?

  /// False for a trail received from outside: the engine never routed it.
  checkedAgainstMatrix Boolean @default(true)

  /// BudgetSettings.commitOnApproval as it stood when the route closed.
  commitOnApproval Boolean?
  /// FundingRoute.approvalCommitsBudget as it stood when the route closed.
  routeCommitsBudget Boolean?

  warnings Json           @default("[]")
  status   ApprovalStatus @default(PENDING)
  openedAt DateTime

  /// The core routing as it stood when the route opened (FR-APR-004). `coreSnapshotAt`
  /// null: the route predates the snapshot ("not recorded"). Set: the rule's flag as it
  /// stood (null not decided, false as entered with its reason) and, where the chain
  /// was generated, the core row it was generated from.
  coreSnapshotAt      DateTime?
  coreChainFlag       Boolean?
  coreChainReason     String?
  coreRoutingSnapshot Json?
  closedAt DateTime?
  /// When the row was written: orders two routes opened on the same day.
  createdAt DateTime @default(now())

  /// The rejection destination as it stood when the route opened (FR-APR-016, ruling
  /// CO-4). `rejectionSnapshotAt` null: the route predates the snapshot ("not
  /// recorded"). Set with a null kind: nothing was configured ("not set").
  rejectionSnapshotAt       DateTime?
  rejectionDestinationId    String?
  rejectionDestination      RejectionDestination? @relation(fields: [rejectionDestinationId], references: [id], onDelete: Restrict)
  rejectionKind             RejectionDestinationKind?
  rejectionReturnToRoleCode String?
  rejectionProvenance       Provenance?
  /// What was applied when a step rejected, and on whose say.
  rejectionApplied          RejectionDestinationKind?
  rejectionSource           RejectionSource?
  rejectionChosenByPersonId String?
  rejectionChosenBy         Person?                   @relation("RejectionChosenBy", fields: [rejectionChosenByPersonId], references: [id], onDelete: Restrict)
  rejectionReason           String                    @default("")
  /// Offered to the officer when nothing applied (ruling CO-5). Non-empty with nothing
  /// applied means the choice is awaited.
  rejectionChoices          RejectionDestinationKind[] @default([])
  rejectionChoiceWhy        String?
  /// The route this one continues, where a rejection returned the matter to an earlier
  /// step (ADR 0009: re-routing opens a new instance).
  supersedesInstanceId      String?                   @unique
  supersedes                ApprovalInstance?         @relation("Successor", fields: [supersedesInstanceId], references: [id], onDelete: Restrict)
  supersededBy              ApprovalInstance?         @relation("Successor")

  steps ApprovalStep[]
  /// 6.4: the tender pack this Approval for Tendering route approves.
  tenderPack TenderPack?
  /// 6.5: the invitee list a name route approves (ADR 0015), the letters issued on it, and the
  /// closing change or cancellation a window_change route decides.
  nameRouteInvitees  NameRouteInvitee[]
  invitationLetters  InvitationLetter[]  @relation("LetterNameRoute")
  closingChange      ClosingChange?      @relation("ClosingChangeRoute")
  windowCancellation WindowCancellation? @relation("WindowCancellationRoute")
  /// 6.8 (FR-EVL-016): the negotiation a `negotiation` route authorises, and its rounds.
  negotiationRequest  NegotiationRequest? @relation("NegotiationRoute")
  negotiationMeetings EvaluationMeeting[] @relation("NegotiationMeetingRoute")

  @@index([organisationId, matterKind])
  @@index([requisitionId])
  @@index([exerciseId])
  @@index([awardId])
  @@index([supplierApplicationId])
  @@index([certificateId])
  @@index([variationId])
}

/// One step of a persisted route, and who discharged it.
model ApprovalStep {
  id         String           @id @default(cuid())
  instanceId String
  instance   ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  sequence Int
  /// The office, by code, or null on a received trail that names none.
  roleCode  String?
  /// The office's name as it read when the route was opened.
  roleLabel String
  act       AuthorityAct
  committeeCode String?
  nonDelegable  Boolean      @default(false)
  sourceRuleKey String?
  /// Where a generated chain's step came from. Null on a chain as entered, and on a
  /// route that predates core routing.
  chainOrigin   ChainStepOrigin?

  decision          StepDecision @default(PENDING)
  decidedByPersonId String?
  decidedBy         Person?      @relation(fields: [decidedByPersonId], references: [id], onDelete: Restrict)
  /// The name as it read when recorded.
  decidedByName     String?
  decidedOn         DateTime?
  delegationId      String?
  delegation        Delegation?  @relation(fields: [delegationId], references: [id], onDelete: Restrict)
  reason            String       @default("")
  /// The day the matter reached the decider (FR-CTE-014, 6.11 ruling). Optional, on or
  /// before the decision day. Null reads "not recorded".
  receivedOn        DateTime?

  /// One committee decision discharges one step, never two.
  committeeDecisionId String?            @unique
  committeeDecision   CommitteeDecision? @relation(fields: [committeeDecisionId], references: [id], onDelete: Restrict)
  recordedAt          DateTime?

  /// A decision carried onto a successor route from the step it was taken on. Read
  /// only; it renders "decided on the earlier route" and is never a fresh citation.
  carriedFromStepId String?       @unique
  carriedFrom       ApprovalStep? @relation("Carried", fields: [carriedFromStepId], references: [id], onDelete: Restrict)
  carriedTo         ApprovalStep? @relation("Carried")

  /// The office now acting for the step, where it was escalated (FR-APR-009/010).
  /// `roleCode` is never rewritten: holders are judged on `actingRoleCode ?? roleCode`.
  actingRoleCode     String?
  actingRoleLabel    String?
  escalation         StepEscalation?
  escalationReason   String?
  escalatedOn        DateTime?
  escalationCount    Int             @default(0)
  /// Who declared a conflict on the step, recorded on their behalf, not signed.
  declaredByPersonId String?
  declaredBy         Person?         @relation("ConflictDeclaredBy", fields: [declaredByPersonId], references: [id], onDelete: Restrict)

  @@unique([instanceId, sequence])
}

/// Where a step of a generated chain came from (FR-APR-004, 6.9 ruling C1).
enum ChainStepOrigin {
  CORE /// The core routing's step, as the core routing has it.
  CORE_STRENGTHENED /// A core step whose act the rule raised above the core act.
  CORE_ACT_SET /// A core step whose act the rule set to another of the same rank.
  RULE /// A step the rule adds to the core routing.
}

/// One approving office's row of the core routing rule in one issue. Ships empty.
/// A row with no steps means "approves alone", which is not the same as no row.
model CoreRoutingLevel {
  id                String            @id @default(cuid())
  organisationId    String
  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  authorityMatrixId String
  authorityMatrix   AuthorityMatrix   @relation(fields: [authorityMatrixId], references: [id], onDelete: Cascade)
  /// The approving office, by AuthorityRole.code.
  approverCode      String
  clause            String            @default("")
  provenance        Provenance        @default(ASSUMED)
  note              String            @default("")
  sortOrder         Int               @default(0)
  steps             CoreRoutingStep[]

  @@unique([authorityMatrixId, approverCode])
  @@index([organisationId])
}

/// An office beneath the approver, in order. The act is P, JP, R or JR (src/lib).
model CoreRoutingStep {
  id                 String           @id @default(cuid())
  organisationId     String
  organisation       Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  coreRoutingLevelId String
  level              CoreRoutingLevel @relation(fields: [coreRoutingLevelId], references: [id], onDelete: Cascade)
  roleCode           String
  act                AuthorityAct
  sequence           Int
  provenance         Provenance       @default(ASSUMED)
  note               String           @default("")

  @@unique([coreRoutingLevelId, sequence])
  @@unique([coreRoutingLevelId, roleCode])
  @@index([organisationId])
}

// ------------------------------------------------------------ 6.3 method selection

/// Where a sourcing exercise stands (spec §7.3.2). 6.3 builds the first states; 6.5
/// adds the sourcing window. CANCELLED is an assumption: §7.3.2 gives it no SOP path.
enum ExerciseStatus {
  DRAFT
  DOCUMENTS_IN_PREPARATION
  /// 6.4 (§7.3.2): the tender pack is frozen and with the Approval for Tendering route.
  PENDING_APPROVAL_FOR_TENDERING
  /// 6.4 (§7.3.2): approved for tendering, with its start and closing recorded (X-2).
  APPROVED_FOR_TENDERING
  /// 6.5 (§7.3.2): published through every required channel; the window's phases follow from
  /// its stored instants, never a stored state (ADR 0014).
  ADVERTISED
  /// 6.5 (§7.3.2): the approved invitees' letters issued (FR-ADV-002); never published.
  INVITED
  /// 6.7 (§7.3.2): the box opened at the opening, on the second of two authorisations by distinct
  /// present panel members; the envelopes are being opened. Written only by that act.
  OPENING_IN_PROGRESS
  /// 6.7 (§7.3.2): the main opening finalised, its schedule frozen and the estimate disclosed.
  OPENED
  /// 6.8 (§7.3.2): the evaluation started on the pinned model; clarification and negotiation are derived from open meetings (OD-3 A).
  UNDER_EVALUATION
  /// 6.8 (§7.3.2): the evaluation report issued; the committee stages and validity expiry are derived (OD-3 A).
  EVALUATED
  CANCELLED
}

/// The deliverable test behind a contract type (FR-MTD-011).
enum DeliverableKind {
  GOODS_DELIVERED
  MEASURED_CONSTRUCTION
  TERM_PERFORMANCE
}

/// A selected-tender proposal's progress (FR-MTD-006).
enum ProposalState {
  DRAFT
  SUBMITTED
  REVIEWED
}

/// How an exercise's taxonomy value was reached (FR-MTD-014).
enum TaxonomyPick {
  DERIVED
  CHOSEN
}

/// How an exercise's contract type was reached (FR-MTD-011).
enum ContractTypeState {
  DERIVED /// The deliverable test gave it.
  OVERRIDDEN /// The test gave another, and a named Person chose this with a reason.
  CHOSEN /// The test could not give one, and a named Person chose this with a reason.
}

/// A contract terms band on an issue of the limits (FR-MTD-001): which terms set
/// applies, never the retention or defects figures, which belong to the contract.
/// Frozen with its issue, and copied when a new issue is started.
model TermsBand {
  id                String          @id @default(cuid())
  authorityMatrixId String
  authorityMatrix   AuthorityMatrix @relation(fields: [authorityMatrixId], references: [id], onDelete: Cascade)

  bandKey  String
  minValue Decimal? @db.Decimal(18, 2)
  maxValue Decimal? @db.Decimal(18, 2)
  /// The regime (below, quotation, tender) the band applies in. Null: every regime.
  regime   String?

  labelEn String
  labelMs String?

  /// Null: not set, which is not "does not apply".
  retentionApplies        Boolean?
  defectsLiabilityApplies Boolean?
  insuranceNote           String   @default("")

  /// As on a rule: required where an edge equals the boundary value.
  followsBoundarySwitch Boolean?

  clause     String     @default("")
  provenance Provenance @default(ASSUMED)
  sortOrder  Int        @default(0)

  @@unique([authorityMatrixId, bandKey])
}

/// One item of a method's proposal (FR-MTD-006), as the customer words it.
model MethodChecklistItem {
  id               String         @id @default(cuid())
  sourcingMethodId String
  sourcingMethod   SourcingMethod @relation(fields: [sourcingMethodId], references: [id], onDelete: Cascade)

  key       String
  labelEn   String
  labelMs   String?
  required  Boolean   @default(true)
  sortOrder Int       @default(0)
  retiredOn DateTime?

  @@unique([sourcingMethodId, key])
}

/// Why a direct appointment is justified (FR-MTD-009). The customer's own list.
model JustificationReason {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The method it is offered for (SourcingMethod.code). Null: every method that asks.
  sourcingMethodCode String?
  code               String
  nameEn             String
  nameMs             String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  @@unique([organisationId, code])
}

/// Bills of quantities, drawings and specification (FR-MTD-013). Always chosen by the
/// officer: nothing derives it (6.3 ruling).
model ContractBasis {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code              String
  nameEn            String
  nameMs            String?
  /// The standard contract form the basis selects, as the customer names it.
  standardFormLabel String?
  /// 6.2: whether a contract on this basis is let on a bill of quantities. Null: not set,
  /// and packFaults blocks naming it. Its own provenance, as on the method's flag.
  requiresBq           Boolean?
  requiresBqProvenance Provenance?
  /// 6.8 (FR-EVL-005): the evaluation route a contract on this basis takes. Null: not set, and
  /// no evaluation model is pinned on an exercise of this basis (the publication says so).
  evaluationRoute           EvaluationRoute?
  evaluationRouteProvenance Provenance?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  @@unique([organisationId, code])
}

/// One of the other classifications a contract carries (FR-MTD-014).
model ClassificationTaxonomy {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code   String
  nameEn String
  nameMs String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  values TaxonomyValue[]

  @@unique([organisationId, code])
}

model TaxonomyValue {
  id         String                 @id @default(cuid())
  taxonomyId String
  taxonomy   ClassificationTaxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  code      String
  nameEn    String
  nameMs    String?
  sortOrder Int       @default(0)
  retiredOn DateTime?

  @@unique([taxonomyId, code])
}

/// A contract type's value in another taxonomy, optionally only when the basis or
/// another taxonomy's value says so. Held by codes, like every reference.
model TaxonomyMapping {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  contractTypeCode String
  taxonomyCode     String
  valueCode        String
  whenBasisCode    String?
  whenTaxonomyCode String?
  whenValueCode    String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)

  @@index([organisationId, contractTypeCode])
}

/// How mixed scope is classified (FR-MTD-011). None shipped: an unset threshold means
/// no default for mixed scope, and the officer chooses with a reason.
model ClassificationPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The share of value, in percent, the dominant deliverable must strictly exceed.
  dominanceSharePct Decimal?    @db.Decimal(9, 4)
  provenance        Provenance?
  notes             String      @default("")
}

/// A sourcing exercise (spec §7.3.2), classified in Phase 1 (§13.3, ADR 0006).
model SourcingExercise {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Issued from NumberingSeries `exercise`.
  reference     String
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)

  title          String
  estimatedValue Decimal        @db.Decimal(18, 2)
  status         ExerciseStatus @default(DRAFT)
  cancelReason   String         @default("")

  // Method (FR-MTD-004, 005, 010).
  sourcingMethodCode String
  proposedMethodCode String?
  methodReason       String  @default("")
  externalRouteNote  String  @default("")
  parentContractRef  String?

  // Bands, as determined on the last save (FR-MTD-001, 003).
  authorityMatrixId    String?
  matrixLabel          String?
  regime               String?
  requisitionRuleKey   String?
  requisitionRuleLabel String?
  appointmentRuleKey   String?
  appointmentState     String?
  termsBandKey         String?
  termsState           String?
  boundaryValue        Decimal?          @db.Decimal(18, 2)
  boundaryOperator     BoundaryOperator?
  onBoundary           Boolean           @default(false)
  boundaryRuled        Boolean?
  boundaryProvenance   Provenance?
  bandSnapshot         Json              @default("{}")
  bandWarnings         Json              @default("[]")
  determinedAt         DateTime?

  // Contract type and basis (FR-MTD-011, 013).
  contractTypeCode           String?
  derivedContractTypeCode    String?
  derivationState            String?
  dominantSharePct           Decimal?           @db.Decimal(9, 4)
  contractTypeState          ContractTypeState?
  contractTypeOverrideReason String             @default("")
  overriddenByPersonId       String?
  overriddenBy               Person?            @relation("TypeOverriddenBy", fields: [overriddenByPersonId], references: [id], onDelete: Restrict)
  contractBasisCode          String?
  /// Set on award (6.11). After it, the type changes only by a controlled change.
  classificationLockedAt     DateTime?

  // Justification and dossier (FR-MTD-005, 009).
  justificationReasonCode String?
  justificationText       String  @default("")
  evidenceNote            String  @default("")
  dossierReference        String?

  // Emergency coordination record (FR-REQ-013).
  emergencyTrigger      String    @default("")
  coordinationMeetingOn DateTime?
  coordinationAttendees String    @default("")
  coordinationScopeNote String    @default("")
  bqReference           String?

  // Proposal (FR-MTD-006).
  proposalState            ProposalState?
  proposalSubmittedOn      DateTime?
  proposalReviewedOn       DateTime?
  proposalReviewerPersonId String?
  proposalReviewer         Person?        @relation("ProposalReviewer", fields: [proposalReviewerPersonId], references: [id], onDelete: Restrict)
  proposalReviewComment    String         @default("")
  /// The proposal as submitted: each item's key, label and required flag with its
  /// answer. A submitted, reviewed or decided proposal renders from this, whatever
  /// later happens to the method's items. Null while it is being prepared.
  proposalRecord           Json?

  /// The method's restriction as it stood (FR-MTD-007). Not enforced until sign-in.
  restricted Boolean @default(false)

  /// The decided record, written on the move into preparation; the exercise renders
  /// from it afterwards, whatever later happens to the configuration.
  classificationSnapshot Json?
  preparedAt             DateTime?

  /// 6.4: the method's pack kind, written on the move into preparation. Null: prepared before
  /// document assembly existed (never backfilled from configuration); such an exercise keeps
  /// the Phase 1 award path (X-9).
  packKindSnapshot       PackKind?
  /// 6.4 (FR-DOC-012, X-2): DATE START and CLOSING DATE, written by the step that approves
  /// tendering and frozen on the approved pack in the same act. `closingAt` has two writers
  /// only: that step and 6.5's applied closing change (source-scanned).
  tenderingStartOn       DateTime?
  closingAt              DateTime?
  approvedForTenderingAt DateTime?

  /// 6.4 increment 2 (FR-DOC-009): whether the tender is restricted, as the customer's policy
  /// words the restriction. Null: not answered, and submission is refused. Its stamp wording is
  /// configuration (TenderDocumentPolicy), never a literal here.
  restrictedTender       Boolean?
  /// FR-DOC-006: whether the works are the regulated activity that needs the regulator's
  /// permit. Null: not answered. The permit type, from the policy's configured list, is
  /// recorded only where the answer is yes (CHECK in the migration).
  regulatedActivity      Boolean?
  regulatorPermitCode    String?

  /// Founder, 2026-10-05: the officer in charge of the exercise, shown on its Overview.
  /// Null: not named yet. A person removed from the register leaves the exercise unnamed.
  personInChargeId       String?
  personInCharge         Person?            @relation("ExercisePersonInCharge", fields: [personInChargeId], references: [id], onDelete: SetNull)
  /// Founder, 2026-10-05: the work code (field of work) as the customer writes it, free text.
  /// Null: not recorded. No list is configured for it yet.
  workCode               String?

  /// 6.5 (FR-ADV-016): the cancelled exercise this one replaces, a new case linked to it.
  replacesExerciseId     String?
  replaces               SourcingExercise?  @relation("ExerciseReplaces", fields: [replacesExerciseId], references: [id], onDelete: SetNull)
  replacedBy             SourcingExercise[] @relation("ExerciseReplaces")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenderPacks       TenderPack[]
  scopeParts        ExerciseScopePart[]
  proposalAnswers   ExerciseProposalAnswer[]
  taxonomyValues    ExerciseTaxonomyValue[]
  participants      ExerciseParticipant[]
  approvalInstances ApprovalInstance[]
  committeeDecisions CommitteeDecision[]
  awards            Award[]
  /// Dossier evidence (FR-MTD-009) and the coordination scope document (FR-REQ-013).
  attachments       DocumentAttachment[]
  /// 6.2: the bill of quantities' versions, the specification panel and the company
  /// estimates (at most one not void). On the exercise until Project arrives (OD-10).
  bqVersions         BqVersion[]
  specificationPanel SpecificationPanel?
  companyEstimates   CompanyEstimate[]
  /// 6.4 increment 2 (FR-DOC-005): the registrations a bidder must hold.
  registrationRequirements ExerciseRegistrationRequirement[]
  /// 6.5: the invitation window and the parties on the exercise.
  window  ExerciseWindow?
  parties ExerciseParty[]
  /// 6.6: the envelope register, its withdrawals, the box's custody acts and validity extensions.
  bidEnvelopes       BidEnvelope[]
  bidWithdrawals     BidWithdrawal[]
  boxEvents          BoxEvent[]
  validityExtensions ValidityExtension[]
  /// 6.7: the openings and the offers read at them.
  openings           Opening[]
  /// 6.8 (FR-EVL-006, E-2): the evaluation model chosen on the Invitation › Window card while
  /// unpublished, and the issued version's content pinned in the publish transaction. Null
  /// snapshot: published before evaluation models existed, never backfilled (E-1).
  evaluationModelId       String?
  evaluationModel         EvaluationModel? @relation(fields: [evaluationModelId], references: [id], onDelete: Restrict)
  evaluationModelSnapshot Json?
  evaluationModelPinnedAt DateTime?
  /// 6.8: the evaluation, one version after another.
  evaluations             Evaluation[]
  openedBids         OpenedBid[]

  @@unique([organisationId, reference])
  @@unique([organisationId, dossierReference])
  @@index([organisationId, status])
  @@index([requisitionId])
  @@index([personInChargeId])
  specialPermissions SpecialPermission[]
}

model ExerciseScopePart {
  id         String           @id @default(cuid())
  exerciseId String
  exercise   SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  deliverableKind DeliverableKind
  amount          Decimal         @db.Decimal(18, 2)
  description     String          @default("")
  sortOrder       Int             @default(0)
}

model ExerciseProposalAnswer {
  id         String           @id @default(cuid())
  exerciseId String
  exercise   SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  itemKey    String
  text       String
  answeredAt DateTime @default(now())

  @@unique([exerciseId, itemKey])
}

model ExerciseTaxonomyValue {
  id         String           @id @default(cuid())
  exerciseId String
  exercise   SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  taxonomyCode String
  valueCode    String
  pick         TaxonomyPick

  @@unique([exerciseId, taxonomyCode])
}

/// A named participant of a restricted exercise (FR-MTD-007).
model ExerciseParticipant {
  id         String           @id @default(cuid())
  exerciseId String
  exercise   SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  personId   String
  person     Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  capacity   String           @default("")

  @@unique([exerciseId, personId])
}

// ------------------------------------------------------------------- 6.11 award

enum AwardStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  ACCEPTED
  CANCELLED
}

/// The instrument that awards an exercise: which one depends on the regime (AwardPolicy).
enum AwardInstrumentKind {
  LETTER_OF_ACCEPTANCE
  WORK_INDENT
}

enum AwardDocumentKind {
  LETTER_OF_ACCEPTANCE
  SUCCESSFUL_BIDDER_DECLARATION
  APPOINTMENT_LETTER
  INDENT_COVERING_MEMO
}

enum DocumentLanguage {
  MS
  EN
}

enum PeriodUnit {
  DAYS
  WEEKS
  MONTHS
}

enum DeliveryMethod {
  REGISTERED_POST
  COLLECTION
  BY_HAND
}

enum SecurityKind {
  PERFORMANCE_BOND
  ADVANCE_PAYMENT_GUARANTEE
  DESIGN_GUARANTEE_BOND
  RETENTION_BOND
}

enum SecurityForm {
  BANK_GUARANTEE
  INSURANCE_GUARANTEE
  CASH
  BANKERS_DRAFT
}

/// What a performance bond is a percentage of (D4). Never defaulted: chosen per contract.
enum BondBasis {
  CONTRACT_PRICE /// The total contract price.
  ANNUAL_VALUE /// A one-year value of the contract, entered with its provenance.
  STATED_AMOUNT /// An amount stated outright.
}

enum InsuranceKind {
  WORKS
  PUBLIC_LIABILITY
  WORKMENS_COMPENSATION
  CAR
  EAR
}

/// How the workmen's compensation sum is set (D4). A per-award choice, no default.
enum WcBasis {
  UNCOVERED_WAGES
  PERCENT_OF_CONTRACT
}

enum RegisterStatus {
  LODGED
  VERIFIED
  REJECTED
}

enum IssuerKind {
  BANK
  INSURER
  TAKAFUL
}

/// §7.3.3 up to Active (6.12). AWAITING_CONDITIONS and READY_TO_SIGN are derived, never stored
/// (`src/lib/contract/status.ts`). ACTIVE is written only by 6.13's possession act.
enum ContractStatus {
  NUMBER_ALLOCATED
  CANCELLED
  IN_PREPARATION
  PENDING_LEGAL_ENDORSEMENT
  RETURNED_FOR_AMENDMENT
  LEGALLY_ENDORSED
  EXECUTED
  STAMPED
  ACTIVE
  /// 6.13 Part B (ADR 0031): the five stored states after Active, each in its own migration; the rest are derived
  /// (contractStage). Each is written only by its own act.
  PRACTICALLY_COMPLETE
  MAKING_GOOD_COMPLETE
  FINAL_CERTIFICATE_ISSUED
  TERMINATED
  CLOSED
}

enum ContractNumberSource {
  SERIES
  INDENT_NUMBER
}

/// Where a quotation award's contract number comes from (OQ-11).
enum QuotationContractKey {
  INDENT_NUMBER
  CONTRACT_SERIES
}

enum NonCommencement {
  CANCEL_AND_BLACKLIST
  WARNING_LETTER
}

enum CommitmentKind {
  INDENT
  PURCHASE_ORDER
}

/// How this customer awards. One per organisation, every field unset until set: an
/// unset instrument refuses an award in that regime, never assumes one.
model AwardPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  tenderInstrument      AwardInstrumentKind?
  quotationInstrument   AwardInstrumentKind?
  /// Days an indent stays valid from its receipt (FR-AWD-006). Null: validity not set.
  indentValidityDays    Int?
  /// Days after the stated start before non-commencement is raised (FR-AWD-009).
  commencementGraceDays Int?
  /// Days the awardee has to return the signed instrument.
  acceptanceReturnDays  Int?
  /// The units that own a case before and after award (FR-CON-001), by OrgUnit.code.
  preContractUnitCode   String?
  postContractUnitCode  String?
  quotationContractKey  QuotationContractKey?
  /// The customer's words for works that need the regulator's copy (FR-AWD-004).
  regulatedActivityLabel String?
  /// Whether the public Results page shows the awarded value. Null: not set, and not set means not shown.
  publishAwardedValue           Boolean?
  /// Where that choice came from, apart from the controls' own provenance: a disclosure is its own decision.
  publishAwardedValueProvenance Provenance?

  loaTemplateId          String?
  loaTemplate            DocumentTemplate? @relation("PolicyLoaTemplate", fields: [loaTemplateId], references: [id], onDelete: Restrict)
  declarationTemplateId  String?
  declarationTemplate    DocumentTemplate? @relation("PolicyDeclarationTemplate", fields: [declarationTemplateId], references: [id], onDelete: Restrict)
  coveringMemoTemplateId String?
  coveringMemoTemplate   DocumentTemplate? @relation("PolicyCoveringMemoTemplate", fields: [coveringMemoTemplateId], references: [id], onDelete: Restrict)

  provenance Provenance?
  notes      String      @default("")
}

/// An award of a sourcing exercise (spec §6.11). The exercise's method, contract type,
/// regime, terms band and boundary operator are read from the exercise, never copied.
model Award {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Issued from NumberingSeries `award`.
  reference  String
  exerciseId String
  exercise   SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  status            AwardStatus         @default(DRAFT)
  cancelReason      String              @default("")
  /// What cancelling an issued award recorded as its consequence (FR-AWD-009).
  cancelConsequence NonCommencement?
  instrumentKind    AwardInstrumentKind

  // The awardee, as a snapshot: there is no vendor master yet (6.15).
  awardeeName           String
  awardeeRegistrationNo String  @default("")
  awardeeAddress        String  @default("")
  /// 6.15a: the register's supplier. Written from the awardee party's link where there is a party;
  /// `linkAwardToSupplier` only for an award with no party.
  vendorId              String?
  vendor                Supplier? @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// 6.7 (C-7): the exercise's party the award names, on an exercise published through 6.5. The gate
  /// compares parties, never free-text registration; null never matches.
  awardeePartyId        String?
  awardeeParty          ExerciseParty? @relation(fields: [awardeePartyId], references: [id], onDelete: Restrict)

  awardedValue      Decimal    @db.Decimal(18, 2)
  completionPeriod  Int
  completionUnit    PeriodUnit
  startDate         DateTime?
  commencedOn       DateTime?
  /// Whether the works are the regulated activity (FR-AWD-004). Null: not answered.
  regulatedActivity Boolean?

  // The performance bond (D4): decided per contract, never defaulted.
  bondRequired            Boolean?
  bondNotRequiredReason   String      @default("")
  bondBasis               BondBasis?
  bondPercent             Decimal?    @db.Decimal(9, 4)
  bondBasisAmount         Decimal?    @db.Decimal(18, 2)
  bondValidityExtraMonths Int?
  bondBasisProvenance     Provenance?
  bondBasisNote           String      @default("")

  // The letter's terms, per award with their provenance (B3, B8).
  ladAmount           Decimal?    @db.Decimal(18, 2)
  ladUnit             String      @default("")
  retentionPercent    Decimal?    @db.Decimal(9, 4)
  retentionCapPercent Decimal?    @db.Decimal(9, 4)
  dlpMonths           Int?
  termsProvenance     Provenance?
  wcBasis             WcBasis?
  /// 64-C4-b (6.13 Part A step 0, flagged against 6.11): the award's own sums insured, per policy kind (a CAR
  /// or EAR policy accepted for the works counts as works). Null: the award states none, and the tender
  /// Appendix's minimum governs, shown with its source, never 0. Stated, it governs even below the Appendix's
  /// minimum (ADR 0021 precedence), shown with both figures. The readiness gate compares each policy with it.
  worksSumInsured     Decimal?    @db.Decimal(18, 2)
  liabilitySumInsured Decimal?    @db.Decimal(18, 2)
  wcSumInsured        Decimal?    @db.Decimal(18, 2)
  /// 64-C4 (6.4 Q-1 B): why a term differs from the exercise's frozen tender Appendix (the
  /// regulated activity: from the tender's answer). Null: it does not differ, or the
  /// exercise froze no Appendix. Never backfilled.
  ladDiffersReason       String?
  dlpDiffersReason       String?
  regulatedDiffersReason String?
  /// 6.13 Part A ruling on BD-613-2: why a sum insured the award states differs from the figure the frozen
  /// Appendix governs (the works: the awarded value plus its uplift; public liability and workmen's
  /// compensation: its minimums). Null: it does not differ, the award states none, or the Appendix is silent.
  worksInsuredDiffersReason     String?
  liabilityInsuredDiffersReason String?
  wcInsuredDiffersReason        String?
  /// 6.8 (E-9, OD-8 A): why the awarded value or completion period differs from the evaluation's
  /// recommendation, on an exercise evaluated through 6.8. Null: not different, or nothing to compare.
  recValueDiffersReason  String?
  recPeriodDiffersReason String?

  // Who signs, as resolved and recorded at issue.
  signatoryRoleCode     String?
  signatoryRoleLabel    String?
  signatoryRuleKey      String?
  signatoryRuleLabel    String?
  signatoryPersonId     String?
  signatoryPerson       Person?     @relation("AwardSignatory", fields: [signatoryPersonId], references: [id], onDelete: Restrict)
  signatoryName         String?
  signedOn              DateTime?
  signatoryDelegationId String?
  signatoryDelegation   Delegation? @relation(fields: [signatoryDelegationId], references: [id], onDelete: Restrict)

  // The finance system's commitment number (INT-05): consumed, never minted.
  erpCommitmentNo      String?
  erpCommitmentKind    CommitmentKind?
  commitmentRecordedOn DateTime?
  indentReceivedOn     DateTime?

  variantId   String?
  variant     AppointmentLetterVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?

  issuedAt      DateTime?
  /// Every policy value the issue was judged under, with provenance. Rendered from, never re-derived.
  issueSnapshot Json?
  /// The dossier evidence the award was sent for approval on: each pinned version's id,
  /// fingerprint and title (FR-MTD-009). Null for an award sent before attachments existed.
  dossierEvidenceSnapshot Json?
  /// The return scans the award was accepted on (OD-5, NFR-SIG-002). Null on an accepted
  /// award means it was accepted before scans were required, and it is never re-judged.
  returnScanSnapshot      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents         AwardDocument[]
  distributions     AwardDistribution[]
  awardReturn       AwardReturn?
  conditions        AwardCondition[]
  contract          Contract?
  approvalInstances ApprovalInstance[]
  /// Scans of what the awardee returned (FR-AWD-003, 008).
  attachments       DocumentAttachment[]

  @@unique([organisationId, reference])
  @@unique([organisationId, erpCommitmentNo])
  @@index([organisationId, status])
  @@index([exerciseId])
  /// 6.15a: blacklisting asked for from this award's cancellation (FR-AWD-009).
  standingRequests StandingRequest[]
  /// 6.14 (rulings condition, ADR 0023): the pre-award routing sheet over the appointment route, and its checks.
  routingSheet     AwardRoutingSheet?
  routingChecks    RoutingCheck[]
  /// 612-C1: its recorded terms corrected after issue.
  termCorrections  AwardTermCorrection[]
}

/// An issued document, frozen (ADR 0008). Never updated: a reissue is a new version.
model AwardDocument {
  id      String @id @default(cuid())
  awardId String
  award   Award  @relation(fields: [awardId], references: [id], onDelete: Cascade)

  kind                 AwardDocumentKind
  templateId           String
  template             DocumentTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateCode         String
  templateName         String
  templateFormCode     String            @default("")
  templateRevisionDate DateTime?
  templateBodyVersion  Int
  language             DocumentLanguage
  version              Int               @default(1)
  fields               Json
  renderedText         String            @db.Text
  frozenAt             DateTime

  @@unique([awardId, kind, version])
}

/// Who receives a copy of an instrument (FR-AWD-004). The customer's list; ships empty.
model DistributionRecipient {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  instrumentKind    AwardInstrumentKind
  code              String
  nameEn            String
  nameMs            String?
  mandatory         Boolean             @default(true)
  /// Only where the award is the regulated activity.
  onlyWhenRegulated Boolean             @default(false)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  copies AwardDistribution[]

  @@unique([organisationId, code])
}

/// One copy of an issued instrument, and how it went (FR-AWD-004/005).
model AwardDistribution {
  id      String @id @default(cuid())
  awardId String
  award   Award  @relation(fields: [awardId], references: [id], onDelete: Cascade)

  recipientId    String?
  recipient      DistributionRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  recipientName  String
  mandatory      Boolean                @default(true)
  isAwardee      Boolean                @default(false)
  method         DeliveryMethod?
  consignmentRef String                 @default("")
  despatchedOn   DateTime?
  acknowledgedOn DateTime?
  note           String                 @default("")
  sortOrder      Int                    @default(0)
}

/// The awardee's return (FR-AWD-003, 008): what came back, on paper. Nothing is attached.
model AwardReturn {
  id      String @id @default(cuid())
  awardId String @unique
  award   Award  @relation(fields: [awardId], references: [id], onDelete: Cascade)

  signedLetterReceivedOn  DateTime?
  declarationReceivedOn   DateTime?
  authorisationReceivedOn DateTime?
  receivedByPersonId      String?
  receivedBy              Person?   @relation("ReturnReceivedBy", fields: [receivedByPersonId], references: [id], onDelete: Restrict)
  whereHeld               String    @default("")

  // The acceptance page of the appointment letter.
  signatoryName    String   @default("")
  /// Held in full; shown only in the Return tab's field, masked everywhere else (6.11 ruling).
  icNumber         String   @default("")
  occupation       String   @default("")
  address          String   @default("")
  capacity         String   @default("")
  contractorSigned Boolean?
  stampAffixed     Boolean?
  witnessName      String   @default("")
  witnessSigned    Boolean?

  updatedAt DateTime @updatedAt
}

/// A Pemberitahuan Perlantikan variant (FR-AWD-007): contract type plus the exercise's
/// terms band. Value edges live once, in TermsBand.
model AppointmentLetterVariant {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code              String
  nameEn            String
  templateId        String
  template          DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Empty: any contract type.
  contractTypeCodes String[]         @default([])
  /// TermsBand.bandKey. Null: any band.
  termsBandKey      String?
  nonCommencement   NonCommencement?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  awards Award[]

  @@unique([organisationId, code])
}

/// A kind of condition precedent (FR-AWD-014). The customer's list.
model ConditionPrecedentKind {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code              String
  nameEn            String
  /// A delay in meeting it gives no extension of time. Stored now, read by the EOT module.
  excludesEotReason Boolean @default(false)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  conditions AwardCondition[]

  @@unique([organisationId, code])
}

model AwardCondition {
  id      String @id @default(cuid())
  awardId String
  award   Award  @relation(fields: [awardId], references: [id], onDelete: Cascade)

  kindId      String
  kind        ConditionPrecedentKind @relation(fields: [kindId], references: [id], onDelete: Restrict)
  kindName    String
  excludesEot Boolean                @default(false)
  reference   String                 @default("")
  requiredBy  DateTime?
  satisfiedOn DateTime?
  note        String                 @default("")

  /// 6.13 Part B run 1b (carry-in, FR-AWD-014): EOT claims whose delay was put down to this condition.
  eotClaimsExcluded EotClaim[]
}

/// The contract shell created at issue (ADR 0007). 4a extends it.
model Contract {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  number       String
  numberSource ContractNumberSource
  seriesKey    String?
  numberedOn   DateTime
  awardId      String               @unique
  award        Award                @relation(fields: [awardId], references: [id], onDelete: Restrict)
  status       ContractStatus       @default(NUMBER_ALLOCATED)
  contractSum  Decimal              @db.Decimal(18, 2)
  cancelReason String               @default("")

  createdAt DateTime @default(now())

  // 6.12 (§7.3.3, FR-CON-003–014): formation, execution and the baseline.
  /// When preparation started (the server's clock), and what it started under: the legal office, the
  /// front-loading ratio, the stamp wording, the signatory condition, the basis's checks and the document
  /// parts, each as configured that day with its provenance. Read from here afterwards, never live (ADR 0021).
  preparationStartedAt DateTime?
  formationSnapshot    Json?
  /// FR-CON-012: whether a consulting engineer is engaged. Null: not answered, and distribution is refused.
  consultingEngineer   Boolean?
  /// FR-CON-009 (OD-1 A): the organisation's day of the recorded RSAJ signature act, never a form field.
  /// A correction moves it to an earlier day with a reason; the day it was first is kept beside it.
  contractDate                 DateTime?
  contractDateRecordedAt       DateTime?
  contractDateCorrectedFrom    DateTime?
  contractDateCorrectionReason String    @default("")
  /// Everything the RSAJ signature was judged under (the gate, the checks, the legal endorsement, the
  /// signatory and the first day it was ready to sign). Rendered from, never re-derived.
  executedSnapshot Json?
  /// FR-CON-011: stamped at LHDN. STAMPED is refused without both.
  stampedOn   DateTime?
  stampingRef String    @default("")
  stampedAt   DateTime?

  securities      SecurityInstrument[]
  policies        InsurancePolicy[]
  ownershipEvents CaseOwnershipEvent[]
  assemblyParts   ContractAssemblyPart[]
  reconciliations ContractReconciliation[]
  checks          FormationCheck[]
  legalReviews    LegalReview[]
  signatures      ContractSignature[]
  briefing        IntegrityBriefing?
  baselines       ContractBaseline[]
  copies          IssuedCopy[]
  custodyItems    CustodyItem[]
  attachments     DocumentAttachment[]
  /// 6.14: the contract's certificates.
  certificates    Certificate[]
  /// 612-C1: the award's recorded terms corrected after issue.
  awardTermCorrections AwardTermCorrection[]
  /// 6.13 Part A (4b): supervision.
  soAssignments          ContractSoAssignment[]
  soDelegations          SoDelegation[]
  possession             Possession?
  workProgrammes         WorkProgramme[]
  progressRecords        ProgressRecord[]
  siteDiaryEntries       SiteDiaryEntry[]
  diaryEndorsements      DiaryEndorsement[]
  siteMeetings           SiteMeeting[]
  complianceObservations ComplianceObservation[]
  programmeDirections    ProgrammeDirection[]
  pendingDeductions      PendingDeduction[]
  earlyActionDecisions   EarlyActionDecision[]
  contractParties        ContractParty[]
  siteRecordsHandovers   SiteRecordsHandover[]
  /// 6.13 Part A step 3 (4c): interim payment and the damages chain.
  paymentCalendar        PaymentCalendar?
  openingPosition        OpeningPosition?
  interimValuations      InterimValuation[]
  retentionReleases      RetentionRelease[]
  advancePayments        AdvancePayment[]
  ladWarnings            LadWarning[]
  nonCompletions         NonCompletion[]
  /// 6.13 Part A step 4 (4d): variations and the adjustment of the contract sum.
  variations             Variation[]
  matters                ContractMatter[]
  /// 6.13 Part B run 1b: time and damages.
  delayNotices           DelayNotice[]
  eotClaims              EotClaim[]
  lossExpenseClaims      LossExpenseClaim[]
  periodExtensions       PeriodExtension[]
  sumAdjustments         SumAdjustment[]

  @@unique([organisationId, number])
}

/// The case changing hands at award (FR-CON-001), on the same record.
model CaseOwnershipEvent {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  fromUnitCode String?
  toUnitCode   String?
  on           DateTime
  note         String   @default("")
}

/// A bank or insurer on the regulator's approved list (FR-AWD-012). The customer's list.
model ApprovedIssuer {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code       String
  name       String
  kind       IssuerKind
  listSource String     @default("")
  listAsAt   DateTime?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  securities SecurityInstrument[]
  policies   InsurancePolicy[]

  @@unique([organisationId, code])
}

/// A bond or guarantee lodged on a contract (FR-AWD-012).
model SecurityInstrument {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  kind                SecurityKind
  form                SecurityForm
  issuerId            String?
  issuer              ApprovedIssuer? @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  issuerNameAsWritten String          @default("")
  instrumentRef       String          @default("")
  value               Decimal         @db.Decimal(18, 2)
  effectiveFrom       DateTime
  expiresOn           DateTime?
  status              RegisterStatus  @default(LODGED)
  lodgedOn            DateTime
  verifiedOn          DateTime?
  verifiedByPersonId  String?
  verifiedBy          Person?         @relation("SecurityVerifiedBy", fields: [verifiedByPersonId], references: [id], onDelete: Restrict)
  rejectedReason      String          @default("")

  // What it was judged against at verification.
  requiredValue   Decimal?    @db.Decimal(18, 2)
  basis           BondBasis?
  basisPercent    Decimal?    @db.Decimal(9, 4)
  basisAmount     Decimal?    @db.Decimal(18, 2)
  basisProvenance Provenance?
  requiredUntil   DateTime?

  createdAt DateTime @default(now())

  custodyItem CustodyItem?
  /// 6.13 Part A step 3 (B2): the advance payments this guarantee is lodged for.
  advancePayments AdvancePayment[]
}

/// Which policies a contract must carry (FR-AWD-013). The customer's list; ships empty.
model InsuranceRequirement {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code             String
  nameEn           String
  kind             InsuranceKind
  /// Null: every contract type. A type's own row takes the place of the general one.
  contractTypeCode String?
  required         Boolean       @default(true)
  /// For workmen's compensation on a percentage basis.
  percent          Decimal?      @db.Decimal(9, 4)
  /// The tail after completion and defects liability.
  tailMonths       Int?
  tailDays         Int?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  @@unique([organisationId, code])
}

/// The public-liability limit by contract price, (min, max] (FR-AWD-013). Ships empty.
model LiabilityBand {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code        String
  minValue    Decimal? @db.Decimal(18, 2)
  maxValue    Decimal? @db.Decimal(18, 2)
  limitAmount Decimal  @db.Decimal(18, 2)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  @@unique([organisationId, code])
}

/// An insurance policy lodged on a contract (FR-AWD-013).
model InsurancePolicy {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  kind                  InsuranceKind
  /// A CAR or EAR policy accepted in place of the works policy.
  substitutesFor        InsuranceKind?
  issuerId              String?
  issuer                ApprovedIssuer? @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  issuerNameAsWritten   String          @default("")
  policyNo              String          @default("")
  sumInsured            Decimal         @db.Decimal(18, 2)
  appendixAmount        Decimal?        @db.Decimal(18, 2)
  /// Public liability: the limit it must meet, derived from the bands or raised.
  requiredLimit         Decimal?        @db.Decimal(18, 2)
  raisedJustification   String          @default("")
  periodStart           DateTime
  periodEnd             DateTime
  premiumReceiptRef     String          @default("")
  perkesoRegistrationNo String          @default("")
  status                RegisterStatus  @default(LODGED)
  lodgedOn              DateTime
  verifiedOn            DateTime?
  verifiedByPersonId    String?
  verifiedBy            Person?         @relation("PolicyVerifiedBy", fields: [verifiedByPersonId], references: [id], onDelete: Restrict)
  rejectedReason        String          @default("")
  /// What it was judged against at verification.
  requirementSnapshot   Json?
  /// 6.12 (BD-20 carry): workmen's compensation on uncovered wages, checked before signature. Recorded, not
  /// judged: no configured basis compares the declared wages with the sum insured (D4).
  wcCheckedOn              DateTime?
  wcCheckedByPersonId      String?
  wcCheckedBy              Person?   @relation("PolicyWcCheckedBy", fields: [wcCheckedByPersonId], references: [id], onDelete: Restrict)
  wcDeclaredUncoveredWages Decimal?  @db.Decimal(18, 2)
  wcCheckNote              String    @default("")
  wcCheckRecordedAt        DateTime?

  createdAt DateTime @default(now())

  custodyItem CustodyItem?
  /// 6.13 (FR-SUP-013): premiums the employer paid on it by self-help, waiting for the next interim.
  pendingDeductions PendingDeduction[]
}

// ---------------------------------------------------------- Phase 1 close-out

/// Where a rejected matter of one type goes (FR-APR-016, ADR 0009). Effective-dated
/// and snapshotted onto each route when it opens. The product ships none (B4).
model RejectionDestination {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The matter type: an AuthorityRule.domain (requisition, name_approval, appointment).
  domain           String
  kind             RejectionDestinationKind
  /// For RETURN_TO_STEP: the office whose earlier step the matter returns to.
  returnToRoleCode String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime   @default(now())

  instances ApprovalInstance[]

  @@unique([organisationId, domain, effectiveFrom])
  @@index([organisationId, domain])
}

/// A committee gate a funding route's approved requisitions must pass before sourcing
/// (FR-REQ-012, ADR 0010). Outside every approval matrix; the product ships none.
model CommitteeGateRule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  fundingRouteCode String
  /// The body that decides the gate, by Committee.code.
  committeeCode    String
  subjectEn        String
  subjectMs        String?
  act              AuthorityAct
  /// The gate applies to a requisition approved for strictly more than this. Null: any value.
  aboveValue       Decimal?     @db.Decimal(18, 2)

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  sortOrder       Int        @default(0)

  gates RequisitionGate[]

  @@unique([organisationId, fundingRouteCode, committeeCode, effectiveFrom])
  @@index([organisationId, fundingRouteCode])
}

/// One gate a requisition must pass, as the rule read when it was determined.
model RequisitionGate {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  gateRuleId    String
  gateRule      CommitteeGateRule @relation(fields: [gateRuleId], references: [id], onDelete: Restrict)

  committeeCode  String
  committeeLabel String
  subjectEn      String
  act            AuthorityAct
  aboveValue     Decimal?    @db.Decimal(18, 2)
  ruleProvenance Provenance
  determinedOn   DateTime

  decisions CommitteeDecision[]

  @@unique([requisitionId, gateRuleId])
}

/// One export of the audit trail (FR-APR-015). The digest proves the file that was
/// handed over, not the database: the rows are not copied here.
model AuditExport {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The organisation's days the export covers, inclusive.
  fromDay     DateTime
  toDay       DateTime
  rowCount    Int
  /// SHA-256 of the file's bytes, as lowercase hex.
  sha256      String
  fileName    String
  generatedAt DateTime @default(now())

  @@index([organisationId, generatedAt])
}

// ------------------------------------------------------------------ document store
//
// Platform module (ADR 0011, plan platform-document-store.md). Files are immutable,
// content-addressed versions behind a storage façade; owners link to them through
// typed nullable keys, never a polymorphic (type, id). Nothing here is ever deleted
// by the product: a correction is a new version, a withdrawal is recorded with a
// reason, and no disposal run exists.

/// How a record is classified (NFR-SEC-002). One vocabulary, shared with 6.2's
/// company estimate (scope ruling).
enum SecurityClass {
  PUBLIC
  INTERNAL
  SULIT
}

/// What starts a class's retention clock (NFR-RET-001).
enum RetentionTrigger {
  RECEIVED
  OWNER_CLOSED
  CONTRACT_FINAL_ACCOUNT
}

/// What happens to a record once its retention has run and nothing holds it.
enum DisposalMethod {
  DESTROY
  TRANSFER_TO_ARCHIVES
  REVIEW
}

/// STAGED until its first attachment: listed "Received, not filed", never auto-deleted.
enum DocumentStatus {
  STAGED
  FILED
}

/// Every version is NOT_SCANNED: malware scanning is deferred (OD-4).
enum ScanState {
  NOT_SCANNED
  CLEAN
  THREAT
}

/// Why a version is attached to its owner. Closed: a new purpose arrives by migration
/// with its module, and its owner pairing is checked in lib and by a CHECK constraint.
enum AttachmentPurpose {
  SIGNED_MINUTES
  /// Founder, 2026-10-05: a sitting's minutes, uploaded as a file rather than typed, on the sitting.
  SITTING_MINUTES
  /// 6.2 Q-1: the signed specification panel form, on its panel. SULIT.
  SPEC_PANEL_FORM
  /// 6.2 Q-3: a bill of quantities' imported CSV as received, on the bill's version.
  BQ_IMPORT_SOURCE
  /// 6.4: an uploaded part of a tender pack (drawings, a specification), on the pack's part.
  TENDER_PART
  /// 6.5: an addendum's signed copy, on the addendum (FR-ADV-014).
  ADDENDUM_SIGNED
  DOSSIER_EVIDENCE
  COORDINATION_SCOPE
  /// 6.5: proof of an advertisement's publication on a channel, on the exercise (FR-ADV-001).
  PUBLICATION_PROOF
  /// 6.5: a briefing's or site visit's signed attendance sheet, on the exercise (FR-ADV-013).
  ATTENDANCE_SHEET
  /// 6.6 (FR-BID-004, X-11): a bidder's withdrawal letter, on its withdrawal record. SULIT.
  WITHDRAWAL_LETTER
  /// 6.6 (FR-BID-010): the recommended tenderer's written consent to extend its bid's validity, on the extension.
  VALIDITY_CONSENT
  /// 6.7 (FR-OPN-006): the signed paper opening schedule's scan, on its opening, accepted only after
  /// finalising (it carries the estimate's row, 6.2 Q-2). SULIT.
  SIGNED_SCHEDULE
  /// 6.8 (FR-EVL-012, OD-4): the contractor performance report a CPR percentage is entered from, on its evaluation bidder. SULIT.
  CPR_REPORT
  /// 6.8 (FR-EVL-013): a written communication with a tenderer, on its evaluation bidder. SULIT.
  COMMUNICATION
  /// 6.8 (FR-EVL-015, 016): a clarification or negotiation meeting's signed minutes, on the meeting. SULIT.
  MEETING_MINUTES
  /// 6.8 (FR-EVL-015, 016): the tenderer's written confirmation of a meeting's outcome, on the meeting. SULIT.
  TENDERER_CONFIRMATION
  /// 6.8 (FR-EVL-017 annex F): drawings attached to the evaluation report, on the evaluation. SULIT.
  REPORT_DRAWINGS
  /// 6.8 (FR-EVL-017): the signed evaluation report's scan, on the evaluation. SULIT.
  SIGNED_REPORT
  /// 6.8 (FR-CTE-013): the signed Kertas Cadangan's scan, on the evaluation. SULIT.
  SIGNED_PROPOSAL_PAPER
  /// 6.15 (FR-VND-002): a statutory document's scan, on the supplier's document. Not restricted until sign-in.
  SUPPLIER_DOCUMENT
  /// 6.15 (FR-VND-006): the signed paper declaration's scan, on the application. Not restricted until sign-in.
  SUPPLIER_DECLARATION
  /// 6.15 OD-3 B (FR-VND-005): the paper E-Payment form's scan, on the application. SULIT at upload, never downloadable before sign-in.
  SUPPLIER_EPAYMENT_FORM
  HOLDER_RECOMMENDATION
  SIGNED_LETTER
  DECLARATION
  AUTHORISATION
  ACCEPTANCE_PAGE
  /// 6.12 (FR-CON-007): the contractor's company resolution or other proof of signing authority, on the contract.
  COMPANY_RESOLUTION
  /// 6.12 (FR-CON-006): what goes to the legal office for review, on the contract; pinned at each submission.
  LEGAL_SUBMISSION
  /// 6.12 (FR-CON-006): the legal office's written comments on a returned review, on the contract.
  LEGAL_COMMENTS
  /// 6.12 (FR-CON-004): the signed reconciliation record's scan, on the contract.
  RECONCILIATION
  /// 6.12 (FR-CON-009): the signed Contract Document's scan, on the contract.
  SIGNED_CONTRACT
  /// 6.12 (FR-CON-011): the stamping certificate's scan, on the contract.
  STAMPING_CERTIFICATE
  /// 6.13 (FR-SUP-009): the pipe log, kept current on the contract; versioned, handed over.
  PIPE_LOG
  /// 6.13 (FR-SUP-009): the as-built drawings, on the contract; versioned, handed over.
  AS_BUILT
  /// 6.13 (FR-SUP-006): the contractor's work programme (or service schedule) as submitted, on the contract.
  PROGRAMME
  /// 6.13 (FR-SUP-007): a photograph supporting a site diary day, on the contract.
  DIARY_PHOTO
  /// 6.13 (FR-VAR-015): a plan or sketch accompanying the S.O.'s Instruction, on the instruction. Not required at issue.
  INSTRUCTION_SKETCH
  /// 6.15 (615-C2, BD-613-91): a registration body's notice cancelling a supplier's registration, on the record of it.
  REGISTRATION_CANCELLATION_NOTICE
  /// 6.13 Part B run 1b (FR-EOT-001): the contractor's written notice of delay (or the S.O.'s direction), on the notice.
  DELAY_NOTICE
  /// 6.13 Part B run 1b (FR-EOT-005): the meteorological records proving exceptional weather, on the EOT claim.
  METEOROLOGICAL_RECORD
  /// 6.13 Part B run 1b (FR-EOT-006 (a)): how the proposed period was calculated (bar charts or other), on the EOT claim.
  EOT_CALCULATION
}

enum DocumentAccessKind {
  DOWNLOADED
  REFUSED
  VERIFIED
  INTEGRITY_FAILED
}

/// The organisation's upload rules (OD-3). Shipped absent: with no row, or with either
/// value unset, uploads are refused naming the setting. The deployment's own ceiling
/// (DOCUMENT_MAX_BYTES) caps `maxBytes` and is a technical limit, not policy.
model DocumentStorePolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Media types allowed, a subset of those the product can recognise from content.
  allowedMediaTypes String[]
  /// Largest file accepted, in bytes. Null: not set, and nothing is accepted.
  maxBytes          BigInt?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  updatedAt  DateTime   @updatedAt
}

/// The bytes, once per organisation per SHA-256. Kept apart from the metadata so a list
/// never pulls file content, and keyed per organisation so one customer cannot learn
/// that another holds the same file.
model BlobContent {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  sha256   String   @db.Char(64)
  byteSize BigInt
  bytes    Bytes
  storedAt DateTime @default(now())

  versions DocumentVersion[]

  @@id([organisationId, sha256])
}

/// A document: a title, its class, and the classification and retention it was
/// created under, snapshotted so a later class edit never rewrites it.
model Document {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  title           String
  documentClassId String
  documentClass   DocumentClass @relation(fields: [documentClassId], references: [id], onDelete: Restrict)

  /// The class's classification when the document was created; set once afterwards if
  /// it was unset, and raised with a reason. Null: unclassified, never served.
  classificationSnapshot SecurityClass?
  /// The class's retention, trigger, disposal method and authority, as created.
  retentionSnapshot      Json
  status                 DocumentStatus @default(STAGED)
  createdAt              DateTime       @default(now())
  filedAt                DateTime?

  versions DocumentVersion[]
  holds    LegalHold[]

  @@index([organisationId, status])
  @@index([documentClassId])
}

/// One immutable version. No update path: a correction is a new version, a withdrawal
/// is two columns set once with a reason, and the bytes are never deleted. Enforced by a
/// trigger (OD-9, migration 20261007100100) for every database login.
model DocumentVersion {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  versionNo  Int

  sha256   String      @db.Char(64)
  blob     BlobContent @relation(fields: [organisationId, sha256], references: [organisationId, sha256], onDelete: Restrict)
  byteSize BigInt
  /// As sniffed from the bytes, never as declared.
  mediaType        String
  /// The name as the uploader's file had it. Shown, never used as a path.
  originalFilename String
  /// The paper's own received day, in the organisation's days. Never in the future.
  receivedOn       DateTime?
  /// Who recorded it, named: recorded on behalf of, not signed.
  recordedByPersonId String
  recordedBy         Person   @relation("VersionRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  note               String   @default("")
  /// Server time.
  storedAt           DateTime @default(now())
  scanState          ScanState @default(NOT_SCANNED)

  withdrawnAt     DateTime?
  withdrawnReason String    @default("")

  attachments  DocumentAttachment[]
  accessEvents DocumentAccessEvent[]

  @@unique([documentId, versionNo])
  @@index([organisationId, sha256])
}

/// A version pinned to one owner for one purpose. Exactly one owner key is set (CHECK
/// num_nonnulls), and the purpose must suit the owner (CHECK, and attachFault in lib).
model DocumentAttachment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  purpose   AttachmentPurpose
  versionId String
  version   DocumentVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)

  meetingId    String?
  meeting      Meeting?          @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  exerciseId   String?
  exercise     SourcingExercise? @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  awardId      String?
  award        Award?            @relation(fields: [awardId], references: [id], onDelete: Restrict)
  delegationId String?
  delegation   Delegation?       @relation(fields: [delegationId], references: [id], onDelete: Restrict)
  specificationPanelId String?
  specificationPanel   SpecificationPanel? @relation(fields: [specificationPanelId], references: [id], onDelete: Restrict)
  /// 6.2 Q-3: a bill of quantities version, for the CSV it was imported from.
  bqVersionId          String?
  bqVersion            BqVersion?          @relation(fields: [bqVersionId], references: [id], onDelete: Restrict)
  /// 6.4: a tender pack's part, for the file that is the part (drawings, a specification).
  tenderPackPartId     String?
  tenderPackPart       TenderPackPart?     @relation(fields: [tenderPackPartId], references: [id], onDelete: Restrict)
  /// 6.5: an addendum, for its signed copy (FR-ADV-014).
  addendumId           String?
  addendum             Addendum?           @relation(fields: [addendumId], references: [id], onDelete: Restrict)
  /// 6.6 (X-6, X-11): a bid withdrawal, for its letter.
  bidWithdrawalId      String?
  bidWithdrawal        BidWithdrawal?      @relation(fields: [bidWithdrawalId], references: [id], onDelete: Restrict)
  /// 6.6 (X-6, FR-BID-010): a validity extension, for the tenderer's consent.
  validityExtensionId  String?
  validityExtension    ValidityExtension?  @relation(fields: [validityExtensionId], references: [id], onDelete: Restrict)
  /// 6.7 (X-6, FR-OPN-006): an opening, for its signed schedule's scan (accepted only once finalised).
  openingId            String?
  opening              Opening?            @relation(fields: [openingId], references: [id], onDelete: Restrict)
  /// 6.8 (X-6): an evaluation (its report's drawings and signed scan, the signed Kertas Cadangan),
  /// a clarification or negotiation meeting (its minutes, the tenderer's confirmation) and an
  /// evaluation bidder (a CPR report, a written communication). Each SULIT at upload.
  evaluationId         String?
  evaluation           Evaluation?         @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  evaluationMeetingId  String?
  evaluationMeeting    EvaluationMeeting?  @relation(fields: [evaluationMeetingId], references: [id], onDelete: Restrict)
  evaluationBidderId   String?
  evaluationBidder     EvaluationBidder?   @relation(fields: [evaluationBidderId], references: [id], onDelete: Restrict)
  /// 6.15 (X-6): a supplier's document (its scan) and a supplier's application (the signed declaration,
  /// the E-Payment form's scan, SULIT at upload).
  supplierDocumentId    String?
  supplierDocument      SupplierDocument?    @relation(fields: [supplierDocumentId], references: [id], onDelete: Restrict)
  supplierApplicationId String?
  supplierApplication   SupplierApplication? @relation(fields: [supplierApplicationId], references: [id], onDelete: Restrict)
  /// 6.12 (X-6): a contract (the company resolution, what went to legal review and its comments, the
  /// reconciliation's scan, the signed contract, the stamping certificate).
  contractId            String?
  contract              Contract?            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// 6.13 Part A acceptance S-2 (FR-VAR-015): the S.O.'s Instruction of a variation (its plans or sketches).
  variationInstructionId String?
  variationInstruction   VariationInstruction? @relation(fields: [variationInstructionId], references: [id], onDelete: Restrict)
  /// 6.15 (615-C2): a registration cancelled, as recorded (the body's notice).
  standingEventId        String?
  standingEvent          StandingEvent?        @relation(fields: [standingEventId], references: [id], onDelete: Restrict)
  /// 6.13 Part B run 1b (FR-EOT-001): a delay notice (the notice itself).
  delayNoticeId          String?
  delayNotice            DelayNotice?          @relation(fields: [delayNoticeId], references: [id], onDelete: Restrict)
  /// 6.13 Part B run 1b (FR-EOT-005, 006): an EOT claim (the meteorological records, the calculation of the period).
  eotClaimId             String?
  eotClaim               EotClaim?             @relation(fields: [eotClaimId], references: [id], onDelete: Restrict)

  attachedAt   DateTime  @default(now())
  detachedAt   DateTime?
  detachReason String    @default("")

  @@index([meetingId])
  @@index([exerciseId])
  @@index([awardId])
  @@index([delegationId])
  @@index([specificationPanelId])
  @@index([bqVersionId])
  @@index([tenderPackPartId])
  @@index([addendumId])
  @@index([bidWithdrawalId])
  @@index([validityExtensionId])
  @@index([openingId])
  @@index([evaluationId])
  @@index([evaluationMeetingId])
  @@index([evaluationBidderId])
  @@index([delayNoticeId])
  @@index([eotClaimId])
  @@index([supplierDocumentId])
  @@index([supplierApplicationId])
  @@index([contractId])
  @@index([variationInstructionId])
  @@index([standingEventId])
  @@index([versionId])
}

/// A legal hold (NFR-RET-002): placed and released with reasons, and while it stands
/// no disposal may touch the document.
model LegalHold {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  reason           String
  placedByPersonId String
  placedBy         Person   @relation("HoldPlacedBy", fields: [placedByPersonId], references: [id], onDelete: Restrict)
  placedAt         DateTime @default(now())

  releasedAt         DateTime?
  releaseReason      String    @default("")
  releasedByPersonId String?
  releasedBy         Person?   @relation("HoldReleasedBy", fields: [releasedByPersonId], references: [id], onDelete: Restrict)

  @@index([documentId])
}

/// Append-only: every download, refusal, verification and integrity failure. A refused
/// upload has no version, so `versionId` is null and what was offered is kept instead.
model DocumentAccessEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  versionId String?
  version   DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)

  kind       DocumentAccessKind
  reasonCode String             @default("")
  /// For a refused upload: the name and size as offered. Never the bytes.
  offeredFilename String?
  offeredBytes    BigInt?
  at              DateTime @default(now())

  @@index([organisationId, at])
  @@index([versionId])
}

// ------------------------------------------------------------------ 6.2 scope, BQ and company estimate
//
// Plan docs/notes/plans/6.2-scope-bq-estimate.md, rulings OD-1..OD-10 and the sealed-figure
// rule (ADR 0012). The bill, the panel and the estimate sit on the exercise (OD-10). The
// estimate's figure and its amendment reasons are read by one accessor only
// (src/lib/scope/estimate-store.ts); the application client omits them everywhere else.

/// A bill of quantities version's life: one draft at a time, finalised once, superseded
/// when a revision is finalised after it.
enum BqStatus {
  DRAFT
  FINALISED
  SUPERSEDED
}

/// Who scoped the work the bill measures (FR-EST-001).
enum BqScopedBy {
  IMPLEMENTING_DEPARTMENT
  SPECIALIST_CONTRACTOR
  COORDINATION_MEETING
}

/// A measured line, a prime cost sum or a provisional sum (FR-EST-002).
enum BqItemKind {
  MEASURED
  PRIME_COST_SUM
  PROVISIONAL_SUM
}

/// Where a line's rate came from. SCHEDULE arrives with increment 2.
enum BqRateSource {
  ENTERED
  SCHEDULE
}

enum PanelStatus {
  DRAFT
  VERIFIED
}

/// The company estimate's life (FR-EST-006 to 010, OD-2).
enum EstimateState {
  DRAFT
  LODGED
  DISCLOSED
  VOID
}

enum EstimateEventKind {
  PREPARED
  AMENDED
  LODGED
  RETAINED
  LATE_OVERRIDE
  DISCLOSED
  VOIDED
}

/// The organisation's scope and estimate rules. Shipped absent; every field unset blocks
/// what it governs, naming itself, and is never read as a default.
model ScopePolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The measurement standard a bill follows, as the customer names it (FR-EST-003).
  measurementStandardLabel      String?
  measurementStandardProvenance Provenance?
  /// Qualification.code a bill's preparer must hold on the finalising day.
  bqPreparerQualificationCode   String?
  /// Days before the closing day by which the estimate's last version is made (OD-3).
  estimateLeadDays              Int?
  estimateLeadProvenance        Provenance?
  /// Offices that hold the estimate's copies and may audit it (custodyList, for sign-in).
  estimateCustodianRoleCode     String?
  estimateAuditRoleCode         String?
  /// The office that may override a late estimate (6.7). Null: no override.
  estimateOverrideRoleCode      String?
  /// Most verifiers a specification panel names. Null: no limit set (a warning, not a block).
  panelSignatoryLimit           Int?
  panelSignatoryLimitProvenance Provenance?
  /// ClassificationTaxonomy codes the panel's contract kind and project status come from.
  panelContractKindTaxonomyCode  String?
  panelProjectStatusTaxonomyCode String?
  /// What the opening benchmark row is called (OD-8, 6.7).
  benchmarkLabelEn String?
  benchmarkLabelMs String?

  notes     String   @default("")
  updatedAt DateTime @updatedAt
}

/// A qualification the organisation recognises (FR-EST-003), such as a measurer's.
model Qualification {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code            String
  nameEn          String
  nameMs          String?
  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  retiredOn       DateTime?

  @@unique([organisationId, code])
}

/// A person holding a qualification over days (validTo inclusive; null: open-ended).
model PersonQualification {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  personId          String
  person            Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  qualificationCode String
  validFrom         DateTime
  validTo           DateTime?
  evidenceNote      String       @default("")

  @@index([personId])
  @@index([organisationId, qualificationCode])
}

/// The section headings a bill starts from. None shipped.
model BqTemplate {
  id              String           @id @default(cuid())
  organisationId  String
  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code            String
  nameEn          String
  nameMs          String?
  deliverableKind DeliverableKind?
  provenance      Provenance       @default(ASSUMED)
  retiredOn       DateTime?

  sections BqTemplateSection[]

  @@unique([organisationId, code])
}

model BqTemplateSection {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  templateId     String
  template       BqTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  number         String
  titleEn        String
  titleMs        String?
  sortOrder      Int          @default(0)

  @@index([templateId])
}

/// A verification column on the specification panel form (FR-EST-005). None shipped.
model SpecPanelColumn {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String
  labelEn        String
  labelMs        String?
  orgUnitCode    String?
  sortOrder      Int          @default(0)
  provenance     Provenance   @default(ASSUMED)
  retiredOn      DateTime?

  @@unique([organisationId, code])
}

/// One version of an exercise's bill of quantities. Amounts and totals are computed in
/// lib, never keyed; a finalised version is frozen with its totals and preparer snapshot.
model BqVersion {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  versionNo      Int
  status         BqStatus         @default(DRAFT)
  templateCode   String?

  scopedBy       BqScopedBy?
  scopeStatement String      @default("")
  /// Three-state: yes, no (departures required), or not answered (null).
  followsStandard       Boolean?
  departuresText        String   @default("")
  standardLabelSnapshot String?
  preparerPersonId      String?
  preparer              Person?  @relation("BqPreparer", fields: [preparerPersonId], references: [id], onDelete: Restrict)
  /// The qualification the preparer held on the finalising day, as it read then.
  preparerQualificationSnapshot Json?
  /// OD-7: whether provisional quantities are left out of the firm value. Null: not stated.
  provisionalExcludedFromFirm   Boolean?
  finalisedAt    DateTime?
  totalsSnapshot Json?
  revisionReason String    @default("")
  createdAt      DateTime  @default(now())

  sections        BqSection[]
  panels          SpecificationPanel[]
  estimateVersions CompanyEstimateVersion[]
  /// SCOPE matters that table this version (6.2 OD-9).
  scopeMatters    CommitteeDecision[]
  /// The CSV files it was imported from (6.2 Q-3).
  attachments     DocumentAttachment[]
  /// 6.4: the tender packs that issue this version, unpriced.
  tenderPacks     TenderPack[]

  @@unique([exerciseId, versionNo])
}

model BqSection {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  versionId      String
  version        BqVersion    @relation(fields: [versionId], references: [id], onDelete: Restrict)
  number         String
  title          String
  sortOrder      Int          @default(0)

  items BqItem[]

  @@index([versionId])
}

model BqItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  sectionId      String
  section        BqSection    @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  itemRef        String       @default("")
  description    String
  unit           String       @default("")
  kind           BqItemKind   @default(MEASURED)
  quantity       Decimal?     @db.Decimal(18, 3)
  rate           Decimal?     @db.Decimal(18, 2)
  /// Written only from lib (itemAmount), never keyed.
  amount         Decimal?     @db.Decimal(18, 2)
  provisional    Boolean      @default(false)
  rateSource     BqRateSource @default(ENTERED)
  /// FR-EST-004: where rateSource is SCHEDULE, the issue the rate was taken from and what it
  /// said, as it read on the day the line was priced. Superseding the issue never touches them.
  rateScheduleId                String?
  rateSchedule                  RateSchedule? @relation(fields: [rateScheduleId], references: [id], onDelete: Restrict)
  rateItemCode                  String?
  scheduleLabelSnapshot         String?
  scheduleIssueSnapshot         String?
  scheduleEffectiveFromSnapshot DateTime?
  sortOrder      Int          @default(0)

  @@index([sectionId])
  @@index([rateScheduleId])
}

enum RateScheduleStatus {
  DRAFT
  ISSUED
  SUPERSEDED
}

/// FR-EST-004: a schedule of rates, issue by issue. Issues of one schedule share its label;
/// issuing one supersedes the issue in force before it. A draft is edited; an issued or
/// superseded issue is frozen, and a line priced from it keeps what it said.
model RateSchedule {
  id               String             @id @default(cuid())
  organisationId   String
  organisation     Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  label            String
  issueNo          Int
  status           RateScheduleStatus @default(DRAFT)
  /// The organisation's day the issue takes effect from. Set at issue.
  effectiveFrom    DateTime?
  issuedOn         DateTime?
  issuedByPersonId String?
  issuedBy         Person?            @relation("RateScheduleIssuedBy", fields: [issuedByPersonId], references: [id], onDelete: Restrict)
  supersededOn     DateTime?
  governingSource  String             @default("")
  provenance       Provenance
  notes            String             @default("")
  createdAt        DateTime           @default(now())

  items   RateScheduleItem[]
  bqItems BqItem[]

  @@unique([organisationId, label, issueNo])
}

model RateScheduleItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  scheduleId     String
  schedule       RateSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  code           String
  descriptionEn  String
  descriptionMs  String?
  unit           String       @default("")
  rate           Decimal      @db.Decimal(18, 2)
  sortOrder      Int          @default(0)

  @@unique([scheduleId, code])
}

/// The specification panel (FR-EST-005): its form's facts, the bill it certifies, and the
/// verifications attested against each configured column. VERIFIED only with a live SULIT
/// scan of the signed form attached (Q-1).
model SpecificationPanel {
  id                 String           @id @default(cuid())
  organisationId     String
  organisation       Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId         String           @unique
  exercise           SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  contractKindCode   String?
  contractKindOther  String           @default("")
  projectStatusCode  String?
  projectStatusOther String           @default("")
  currentRevisionNo  String?
  currentRevisionOn  DateTime?
  revisedRevisionNo  String?
  revisedRevisionOn  DateTime?
  completionPeriodText String         @default("")
  bqVersionId        String?
  bqVersion          BqVersion?       @relation(fields: [bqVersionId], references: [id], onDelete: Restrict)
  status             PanelStatus      @default(DRAFT)
  verifiedAt         DateTime?
  /// What it was verified on: columns, verifiers, the scan's version, the limit.
  verifiedSnapshot   Json?

  verifications SpecPanelVerification[]
  attachments   DocumentAttachment[]
}

/// One column's verification, attested: recorded on behalf of, not signed. Cleared (never
/// deleted) when the panel is edited after.
model SpecPanelVerification {
  id                  String             @id @default(cuid())
  organisationId      String
  organisation        Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  panelId             String
  panel               SpecificationPanel @relation(fields: [panelId], references: [id], onDelete: Restrict)
  columnCode          String
  columnLabelSnapshot String
  personId            String
  person              Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  verifiedOn          DateTime
  note                String             @default("")
  recordedAt          DateTime           @default(now())
  clearedAt           DateTime?

  @@index([panelId])
}

/// The company estimate (FR-EST-006): SULIT from creation and never lowered (a CHECK). At
/// most one not void per exercise (OD-2): lib, the exercise lock, and a partial unique index.
model CompanyEstimate {
  id               String           @id @default(cuid())
  organisationId   String
  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId       String
  exercise         SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  preparerPersonId String
  preparer         Person           @relation("EstimatePreparer", fields: [preparerPersonId], references: [id], onDelete: Restrict)
  classification   SecurityClass    @default(SULIT)
  state            EstimateState    @default(DRAFT)
  currentVersionNo Int              @default(1)
  lodgedAt         DateTime?
  retainedPlace    String           @default("")
  disclosedAt      DateTime?
  voidedAt         DateTime?
  voidReason       String           @default("")
  createdAt        DateTime         @default(now())

  versions CompanyEstimateVersion[]
  events   EstimateEvent[]

  @@index([exerciseId])
}

/// One immutable version of the estimate. `value` and `reason` are sealed: omitted by the
/// application client, read only through readSealedFigures (ADR 0012).
model CompanyEstimateVersion {
  id               String          @id @default(cuid())
  organisationId   String
  organisation     Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  estimateId       String
  estimate         CompanyEstimate @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  versionNo        Int
  value            Decimal         @db.Decimal(18, 2)
  /// The organisation's day at save, never typed.
  preparedOn       DateTime
  preparerPersonId String
  preparer         Person          @relation("EstimateVersionPreparer", fields: [preparerPersonId], references: [id], onDelete: Restrict)
  reason           String          @default("")
  bqVersionId      String?
  bqVersion        BqVersion?      @relation(fields: [bqVersionId], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())

  @@unique([estimateId, versionNo])
}

/// Append-only custody and lifecycle events. Never a figure.
model EstimateEvent {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  estimateId     String
  estimate       CompanyEstimate   @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  kind           EstimateEventKind
  personId       String?
  person         Person?           @relation(fields: [personId], references: [id], onDelete: Restrict)
  capacity       String            @default("")
  note           String            @default("")
  versionNo      Int?
  copyNo         Int?
  at             DateTime          @default(now())

  @@index([estimateId])
}

// ------------------------------------------------------------------ 6.4 tender documents

/// What a sourcing method assembles for tenderers (FR-DOC-001, 013). Closed product vocabulary.
enum PackKind {
  TENDER
  QUOTATION
  /// No pack: the method appoints without tenderers (direct, emergency).
  NONE
}

/// What a configured part is, so rules can recognise it (BD-DS-4 precedent). Closed vocabulary.
enum PartRole {
  INVITATION
  INSTRUCTIONS
  FORM_OF_TENDER
  CONDITIONS
  APPENDIX
  LOA_SPECIMEN
  BOND_FORMS
  SPECIFICATION
  BILL_OF_QUANTITIES
  SUMMARY_AND_RATES
  REGISTRATION_BACKGROUND
  DECLARATION
  DRAWINGS
  OTHER
}

/// Standard text from the library, bespoke to the exercise, or both (FR-DOC-003).
enum PartContent {
  STANDARD
  BESPOKE
  MIXED
}

/// Where a part's content comes from.
enum PartSource {
  TEMPLATE
  BQ_UNPRICED
  APPENDIX
  UPLOAD
}

enum TenderPackStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  VOID
}

enum PackPartState {
  NOT_STARTED
  READY
  OMITTED
}

enum AppendixStatus {
  DRAFT
  COMPLETE
}

/// How liquidated damages are stated in the Appendix (Q-6): an amount a day, or a percentage
/// of the contract sum a day, resolved at award against the awarded sum.
enum LadKind {
  AMOUNT_PER_DAY
  PERCENT_OF_SUM_PER_DAY
}

enum UpliftKind {
  AMOUNT
  PERCENT
}

/// A part of the tender pack, as the customer configures it per pack kind and contract basis
/// (FR-DOC-001, 002, 013). Ships empty: a customer's part list is a go-live seed (Q-8).
model TenderDocumentPart {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  code              String
  packKind          PackKind
  /// Null: the part applies on any basis. A basis-specific row replaces an any-basis row of the same role.
  contractBasisCode String?
  /// As printed on the pack's list of contents, e.g. "7a".
  printedNumber     String
  sortOrder         Int         @default(0)
  labelEn           String
  labelMs           String?
  role              PartRole
  content           PartContent
  source            PartSource
  /// Null: not set, and a pack using it cannot be submitted (never read as "optional").
  mandatory         Boolean?
  /// Whether the part is in the Tender Table Document (FR-DOC-010). Null: not set.
  inTableDocument   Boolean?
  /// 6.7 (6.6 ruling, FR-BID-007): whether a bidder returns this part with its bid, so the opening
  /// checks each bid for it. Null: not set, and an opening cannot finalise completeness against a
  /// mandatory part whose answer is not set. The declaration is returned by definition (FR-DOC-008).
  returnedByBidder           Boolean?
  returnedByBidderProvenance Provenance?
  /// The office that prepares it (OrgUnit.code). Null: not set.
  ownerOrgUnitCode  String?
  /// The library template a STANDARD or MIXED part draws (DocumentTemplate.code).
  templateCode      String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  retiredOn       DateTime?

  @@unique([organisationId, code])
  @@index([organisationId, packKind])
}

/// The tender documents' policy (FR-DOC-004, 009, 014; §8.3, §8.6, §8.10). One row per
/// organisation, every value nullable: unset blocks or reads "Not set", never a default.
model TenderDocumentPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// The restriction stamp merged into generated parts (FR-DOC-009). The customer's wording.
  restrictionStampTextEn String?
  restrictionStampTextMs String?
  /// Whether the two assurance confirmations are required (FR-DOC-014, increment 2).
  assuranceRequired      Boolean?
  /// §8.6: the daily rate an Appendix's LAD is suggested at, as a percentage of the sum.
  ladDailyPct            Decimal?    @db.Decimal(9, 6)
  ladDailyPctProvenance  Provenance?
  /// §8.3: the first interim certificate's minimum: the lesser of a floor and a percentage of the value.
  firstCertificateFloor      Decimal?    @db.Decimal(18, 2)
  firstCertificatePct        Decimal?    @db.Decimal(9, 4)
  firstCertificateProvenance Provenance?
  /// §8.10: how far insurance runs beyond the defects liability period.
  insuranceExtraMonths       Int?
  insuranceExtraDays         Int?
  insuranceExtraProvenance   Provenance?
  /// The same for a design-and-build contract.
  dbInsuranceExtraMonths     Int?
  dbInsuranceExtraDays       Int?
  dbInsuranceExtraProvenance Provenance?
  /// FR-DOC-006 (increment 2): the taxonomy listing regulator permits.
  regulatorPermitTaxonomyCode String?
  /// FR-DOC-009 (increment 2): the restriction as the organisation words it on screens (the
  /// stamp above is what is printed), and where the wording comes from.
  restrictionLabelEn     String?
  restrictionProvenance  Provenance?
  /// FR-DOC-014: where the answer on assurance comes from.
  assuranceProvenance    Provenance?

  governingSource String @default("")
  notes           String @default("")
}

/// A version of an exercise's tender pack (FR-DOC-001). At most one DRAFT or SUBMITTED per
/// exercise (lib and lock; a partial unique index behind them). Frozen on submission; a
/// returned pack stays as it was and a new DRAFT is copied from it (Q-3, ADR 0013).
model TenderPack {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  versionNo      Int
  status         TenderPackStatus @default(DRAFT)

  packKind            PackKind
  contractBasisCode   String
  /// The parts as resolved from configuration when the pack started, with their provenance.
  compositionSnapshot Json
  /// The standard form the conditions part names (FR-MTD-013).
  formLabelSnapshot   String?

  /// The bill of quantities version issued unpriced, pinned at submission.
  bqVersionId String?
  bqVersion   BqVersion? @relation(fields: [bqVersionId], references: [id], onDelete: Restrict)

  proposedStartOn   DateTime?
  proposedClosingAt DateTime?
  submittedAt       DateTime?
  frozenAt          DateTime?
  /// Per part: what it was frozen from (template and body version, bill version, Appendix,
  /// document version and sha256).
  manifest          Json?
  /// The readiness findings it was submitted under (none blocking).
  faultsSnapshot    Json?

  approvalInstanceId String?           @unique
  approvalInstance   ApprovalInstance? @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)

  returnedReason String    @default("")
  returnedAt     DateTime?
  /// A draft or submitted pack ends VOID when its exercise is cancelled.
  voidReason     String    @default("")
  /// X-2: the dates the approving step recorded, frozen here in the same act.
  approvedStartOn   DateTime?
  approvedClosingAt DateTime?
  approvedAt        DateTime?

  /// The returned pack this draft was started from.
  copiedFromPackId String?     @unique
  copiedFrom       TenderPack? @relation("PackCopiedFrom", fields: [copiedFromPackId], references: [id], onDelete: Restrict)
  copiedInto       TenderPack? @relation("PackCopiedFrom")

  /// 6.4 increment 2: what the pack was judged under at submission, in words: eligibility and
  /// its validity window, restriction and stamp, regulator permit, assurance (policy and
  /// confirmations), mandatory clauses and overrides, the Tender Table Document's parts.
  /// Null: frozen before increment 2 (never backfilled from configuration).
  conditionsSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts     TenderPackPart[]
  documents TenderPackDocument[]
  appendix  ConditionsAppendix?
  clauseOverrides ClauseOverride[]
  assurances      PackAssurance[]

  @@unique([exerciseId, versionNo])
  @@index([organisationId, status])
}

/// A part of a pack, as resolved from configuration when the pack started.
model TenderPackPart {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  packId         String
  pack           TenderPack   @relation(fields: [packId], references: [id], onDelete: Restrict)

  partCode         String
  printedNumber    String
  sortOrder        Int
  labelSnapshot    String
  labelMsSnapshot  String?
  role             PartRole
  content          PartContent
  source           PartSource
  /// As configured when the pack started. Null: not set (blocks submission).
  mandatory        Boolean?
  inTableDocument  Boolean?
  /// 6.7 (6.6 ruling): as configured when the pack started, with its provenance, as `mandatory` is.
  /// Null: not set (or started before the answer existed); never backfilled.
  returnedByBidder           Boolean?
  returnedByBidderProvenance Provenance?
  ownerOrgUnitCode String?
  /// The configured template's code, and the template picked for this pack.
  templateCode     String?
  templateId       String?
  template         DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  state         PackPartState @default(NOT_STARTED)
  omittedReason String        @default("")

  attachments DocumentAttachment[]

  @@unique([packId, partCode])
}

/// A part's text as frozen at submission (ADR 0008 shape): a template rendered with its
/// fields, the unpriced bill, or the Appendix. Never re-rendered.
model TenderPackDocument {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  packId         String
  pack           TenderPack   @relation(fields: [packId], references: [id], onDelete: Restrict)

  partCode             String
  source               PartSource
  templateId           String?
  template             DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateCode         String?
  templateName         String?
  templateFormCode     String            @default("")
  templateRevisionDate DateTime?
  templateBodyVersion  Int?
  language             DocumentLanguage
  fields               Json
  renderedText         String            @db.Text
  frozenAt             DateTime

  @@unique([packId, partCode, language])
}

/// The Appendix to the Conditions of Contract (FR-DOC-004, §8.10): the contract baseline the
/// award reads (Q-1). Every field three-state: null reads "Not set". Copied forward on return.
model ConditionsAppendix {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  packId         String         @unique
  pack           TenderPack     @relation(fields: [packId], references: [id], onDelete: Restrict)
  status         AppendixStatus @default(DRAFT)

  /// Officers empowered, by AuthorityRole.code with the office's name as it stood.
  ladOfficerRoleCode          String?
  ladOfficerLabel             String?
  eotOfficerRoleCode          String?
  eotOfficerLabel             String?
  terminationOfficerRoleCode  String?
  terminationOfficerLabel     String?
  warRiskOfficerRoleCode      String?
  warRiskOfficerLabel         String?
  arbitrationOfficerRoleCode  String?
  arbitrationOfficerLabel     String?

  /// Prime cost sums for works: whether any apply (null: not answered) and what they are.
  pcSumWorksApply Boolean?
  pcSumWorksText  String   @default("")

  tplMinimum                 Decimal?    @db.Decimal(18, 2)
  wcMinimum                  Decimal?    @db.Decimal(18, 2)
  worksInsuranceUpliftKind   UpliftKind?
  worksInsuranceUpliftAmount Decimal?    @db.Decimal(18, 2)
  worksInsuranceUpliftPct    Decimal?    @db.Decimal(9, 4)
  insuranceExcess            Decimal?    @db.Decimal(18, 2)

  ladKind   LadKind?
  ladAmount Decimal? @db.Decimal(18, 2)
  ladPct    Decimal? @db.Decimal(9, 6)

  sectionalCompletion Boolean?
  dlpApplies          Boolean?
  dlpMonths           Int?

  firstInterimMinimum      Decimal? @db.Decimal(18, 2)
  subsequentInterimMinimum Decimal? @db.Decimal(18, 2)
  honourCertificateDays    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variationLimits AppendixVariationLimit[]
  sections        AppendixSection[]
}

/// A variation limit in the Appendix: an office or a committee, and its limit.
model AppendixVariationLimit {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  appendixId     String
  appendix       ConditionsAppendix @relation(fields: [appendixId], references: [id], onDelete: Restrict)

  roleCode      String?
  committeeCode String?
  /// The office's or committee's name as it stood.
  label         String
  /// Null: not set.
  limit         Decimal? @db.Decimal(18, 2)
  sortOrder     Int      @default(0)
}

/// A section for sectional completion, with its own LAD.
model AppendixSection {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  appendixId     String
  appendix       ConditionsAppendix @relation(fields: [appendixId], references: [id], onDelete: Restrict)

  description String
  ladKind     LadKind?
  ladAmount   Decimal? @db.Decimal(18, 2)
  ladPct      Decimal? @db.Decimal(9, 6)
  sortOrder   Int      @default(0)
}

// ------------------------------------------------------------------ 6.4 increment 2

/// A body a bidder registers with (FR-DOC-005; ruling: configured bodies, never columns per
/// regulator). Ships empty. `qualifierLabelEn` names what an exercise states with it (a grade,
/// category and specialisation; field codes); null: the body takes no qualifier.
model RegistrationBody {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  code             String
  labelEn          String
  labelMs          String?
  qualifierLabelEn String?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  /// 6.15 (FR-VND-003): the body's values (grades, categories, codes) and the document types it issues.
  values        RegistrationValue[]
  documentTypes SupplierDocumentType[]
  /// 615-C2: the supplier registrations this body cancelled, as recorded.
  cancellations StandingEvent[]

  @@unique([organisationId, code])
}

/// A registration an exercise requires of bidders (FR-DOC-005). Requirements in one
/// `alternativeGroup` are alternatives (any one is enough); every group is required.
model ExerciseRegistrationRequirement {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  bodyCode               String
  /// The body's name and qualifier label as they stood when entered.
  bodyLabelSnapshot      String
  qualifierLabelSnapshot String?
  /// What is stated with the body (a grade, category, specialisation, field codes). Empty: none.
  qualifiers             String @default("")
  alternativeGroup       Int    @default(1)
  sortOrder              Int    @default(0)
  createdAt              DateTime @default(now())

  @@index([exerciseId])
  specialPermissions SpecialPermission[]
}

/// A clause every agreement must carry (FR-DOC-011), cited in a template as {{clause:code}}.
/// Ships empty. `bodyVersion` counts each change to its text, as a template's does.
model ClauseText {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  code        String
  titleEn     String
  titleMs     String?
  bodyEn      String  @db.Text
  bodyMs      String? @db.Text
  bodyVersion Int     @default(1)
  /// Whether every agreement must carry it. Null: not set, and a pack cannot be submitted.
  mandatoryInAgreements Boolean?
  /// 6.13 Part A step 4 (FR-VAR-020): Variation Order Certificates valued under this clause.
  variationCertificates VariationCertificate[]

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, code])
}

/// A legal endorsement that lets one pack version go without a mandatory clause (FR-DOC-011):
/// a named Person and the reason, recorded on their behalf, not signed. Not carried to the
/// next version.
model ClauseOverride {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  packId         String
  pack           TenderPack   @relation(fields: [packId], references: [id], onDelete: Restrict)

  clauseCode          String
  clauseTitleSnapshot String
  personId            String
  person              Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  reason              String
  recordedAt          DateTime

  @@unique([packId, clauseCode])
}

/// The two document-assurance confirmations (FR-DOC-014).
enum AssuranceKind {
  NO_AMBIGUITY
  DRAWINGS_COORDINATED
}

/// One assurance confirmation on one pack version: a named Person and the day, recorded on
/// their behalf, not signed. Not carried to the next version.
model PackAssurance {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  packId         String
  pack           TenderPack    @relation(fields: [packId], references: [id], onDelete: Restrict)
  kind           AssuranceKind
  personId       String
  person         Person        @relation(fields: [personId], references: [id], onDelete: Restrict)
  confirmedOn    DateTime
  note           String        @default("")
  recordedAt     DateTime

  @@unique([packId, kind])
}

// ------------------------------------------------- 6.5 advertisement, invitation and the window

/// How an exercise reaches its tenderers (FR-ADV-001, 002), from its method's flags when the
/// window is first written.
enum WindowPath {
  ADVERTISED
  INVITED
}

/// A line of the document fee's cost basis (FR-ADV-008).
enum FeeCostKind {
  PAPER_A4
  PAPER_A3
  PAPER_A1
  PAPER_A0
  COPYING
  BINDING
  ADMIN
  OTHER
}

enum SiteEventKind {
  BRIEFING
  SITE_VISIT
}

/// What the purchaser's representative showed of the restriction's status certificate (FR-ADV-010).
enum CertSighted {
  ORIGINAL
  CERTIFIED_COPY
  NOT_SHOWN
}

/// A check the portal cannot make yet reads NOT_CHECKED, never CLEAR (6.5 OD-9).
enum CheckState {
  NOT_CHECKED
  CLEAR
  FAILED
}

/// How a party first came onto the exercise.
enum PartySource {
  PROPOSED_INVITEE
  ATTENDEE
  PURCHASER
  /// 6.7: named for the first time at opening, from the bid itself (no sale, no letter, no attendance).
  BIDDER_AT_OPENING
}

/// Which day is the advertisement day when channels publish on different days (6.5 OD-3).
enum AdvertisementDayRule {
  LATEST_REQUIRED_CHANNEL
  NAMED_CHANNEL
}

/// A change to the closing after approval for tendering (X-2: 6.4's approved dates are the
/// pack's, so there is no APPROVED kind). A correction fixes a date the rules refuse before
/// publication; an extension moves it later after publication (FR-ADV-015).
enum ClosingChangeKind {
  CORRECTION
  EXTENSION
}

enum AddendumStatus {
  DRAFT
  ISSUED
  VOID
}

/// The organisation's invitation-window rules (FR-ADV-004–008, 013). One row, shipped empty:
/// every null is "not set", shown as such, and blocks the act it governs (6.5 OD-3, OD-7, OD-8).
model WindowPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// Days from the advertisement day to the closing day: the floor refused, the target warned.
  minAdvertisementDays    Int?
  targetAdvertisementDays Int?
  /// The margin a late newspaper may take before the floor is breached: warned within it.
  newspaperWarnDays       Int?
  /// The last day the documents are sold is at least this many days before the closing day.
  purchaseCutoffDays      Int?
  dateRulesProvenance     Provenance?
  /// "HH:MM", prefilled for every regime; another time needs a reason (FR-ADV-006).
  defaultClosingTime      String?
  closingTimeProvenance   Provenance?
  advertisementDayRule    AdvertisementDayRule?
  /// The channel whose day is the advertisement day, where the rule names one.
  advertisementChannelId  String?
  advertisementChannel    PublicationChannel?   @relation("PolicyAdvertisementChannel", fields: [advertisementChannelId], references: [id], onDelete: Restrict)
  dayRuleProvenance       Provenance?
  /// The weekend days and public holidays a closing day is judged against (FR-ADV-005).
  calendarId              String?
  calendar                HolidayCalendar?      @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  /// Whether an event may be made mandatory at all (D8, OQ-03). Null: not set, so none is.
  mandatoryAttendancePermitted Boolean?
  attendanceProvenance         Provenance?
  noticeTemplateId     String?
  noticeTemplate       DocumentTemplate? @relation("WindowNoticeTemplate", fields: [noticeTemplateId], references: [id], onDelete: Restrict)
  invitationTemplateId String?
  invitationTemplate   DocumentTemplate? @relation("WindowInvitationTemplate", fields: [invitationTemplateId], references: [id], onDelete: Restrict)
  addendumTemplateId   String?
  addendumTemplate     DocumentTemplate? @relation("WindowAddendumTemplate", fields: [addendumTemplateId], references: [id], onDelete: Restrict)
  /// The written source the date rules are cited by in their messages. Empty: no citation.
  dateRuleSource String   @default("")
  notes          String   @default("")
  updatedAt      DateTime @updatedAt
}

/// A channel an open tender is published through (FR-ADV-001). Shipped empty.
model PublicationChannel {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  code   String
  nameEn String
  nameMs String?
  /// Whether every advertised exercise must be published here. Null: not set, and blocks.
  requiredWhenAdvertised Boolean?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  policiesNaming WindowPolicy[]      @relation("PolicyAdvertisementChannel")
  publications   PublicationRecord[]

  @@unique([organisationId, code])
}

/// The least a set of documents is sold for, per regime (FR-ADV-008, 6.5 OD-6). Shipped empty.
model DocumentFeeFloor {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// As SourcingExercise.regime: below, quotation, tender.
  regime  String
  minimum Decimal @db.Decimal(18, 2)

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")

  @@unique([organisationId, regime])
}

/// A maintained calendar of weekend days and public holidays (FR-ADV-005). Shipped empty.
model HolidayCalendar {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  code String
  name String
  /// ISO weekdays, 1 Monday to 7 Sunday. Empty: not set, and blocks.
  weekendDays        Int[]       @default([])
  weekendProvenance  Provenance?

  governingSource String     @default("")
  provenance      Provenance @default(ASSUMED)
  notes           String     @default("")
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  years    HolidayCalendarYear[]
  holidays PublicHoliday[]
  policies WindowPolicy[]

  @@unique([organisationId, code])
}

/// Whether a year's holidays are maintained in full. A closing in a year not complete blocks (6.5 OD-7).
model HolidayCalendarYear {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  calendarId     String
  calendar       HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)

  year     Int
  complete Boolean    @default(false)
  /// Where the year's list was taken from (a gazette, a circular).
  source     String     @default("")
  provenance Provenance @default(ASSUMED)

  @@unique([calendarId, year])
}

model PublicHoliday {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  calendarId     String
  calendar       HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)

  day        DateTime
  nameEn     String
  nameMs     String?
  gazetteRef String     @default("")
  provenance Provenance @default(ASSUMED)

  @@unique([calendarId, day])
}

/// An exercise's invitation window (§7.1): the notice's items, the fee and its basis, the purchase
/// days. One per exercise. No status column: the exercise's status records the acts (ADVERTISED,
/// INVITED, CANCELLED) and the phases are derived from the stored instants (ADR 0014).
model ExerciseWindow {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String           @unique
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  path WindowPath
  /// Why the closing time differs from the policy's default (FR-ADV-006). Empty: it does not.
  closingTimeReason String    @default("")
  purchaseFromDay   DateTime?
  purchaseCloseDay  DateTime?
  // The notice's items (FR-ADV-003): (b), (c), (d), (g). (a) is the exercise's registrations
  // (6.4, OD-13); (e) and (f) are the site events.
  inspectionPlace   String    @default("")
  purchasePlace     String    @default("")
  inspectionHours   String    @default("")
  feeAmount         Decimal?  @db.Decimal(18, 2)
  feePaymentMethods String    @default("")
  submissionPlace   String    @default("")
  /// 6.6 (FR-BID-009): the days a bid stays valid from the closing day, as the tender documents
  /// state it. No default: null is not set, warned on the window and blocking the award.
  bidValidityDays       Int?
  bidValidityProvenance Provenance?
  /// 6.6 (FR-BID-006): whether the documents permit alternative bids. Null: not stated.
  alternativesPermitted Boolean?
  /// 6.15a (FR-ADV-017): whether the notice offers special permission. Null: not stated, and no
  /// special permission is granted on the exercise until it is.
  specialPermissionOffered Boolean?

  /// Derived at publication from the publication records (OD-3) or the invitation day, then kept.
  advertisementDay DateTime?
  publishedAt      DateTime?
  /// Every rule value the publication was judged under, with its provenance.
  policySnapshot   Json?
  /// The notice as published (advertised path), frozen from the configured template (ADR 0008).
  noticeText          String? @db.Text
  noticeTemplateCode  String?
  noticeTemplateBodyVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeLines       WindowFeeLine[]
  closingChanges ClosingChange[]
  cancellations  WindowCancellation[]
  publications   PublicationRecord[]
  letters        InvitationLetter[]
  sales          DocumentSale[]
  events         SiteEvent[]
  addenda        Addendum[]
}

/// A line of the fee's cost basis. The amount is written only from src/lib (quantity × unit cost,
/// rounded once, or a lump sum).
model WindowFeeLine {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  windowId       String
  window         ExerciseWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)

  kind        FeeCostKind
  description String      @default("")
  quantity    Decimal?    @db.Decimal(18, 3)
  unitCost    Decimal?    @db.Decimal(18, 2)
  amount      Decimal     @db.Decimal(18, 2)
  sortOrder   Int         @default(0)
}

/// A change to the closing after approval for tendering, decided on its own route (domain
/// window_change, OD-5). Append-only. `SourcingExercise.closingAt` is written from it only when
/// it is applied (X-2: the closing's second writer).
model ClosingChange {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  windowId       String
  window         ExerciseWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)

  kind                 ClosingChangeKind
  fromClosingAt        DateTime
  toClosingAt          DateTime
  fromPurchaseCloseDay DateTime?
  toPurchaseCloseDay   DateTime?
  reason               String
  approvalInstanceId   String?           @unique
  approvalInstance     ApprovalInstance? @relation("ClosingChangeRoute", fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  requestedOn          DateTime
  appliedAt            DateTime?
  /// Refused when its route was refused, or when the approving step found the rules now refuse it.
  refusedAt            DateTime?
  refusedReason        String            @default("")
  /// The date rules as judged when it was requested, in words.
  faultsSnapshot       Json              @default("[]")
  createdAt            DateTime          @default(now())

  notices WindowNotice[]
  addenda Addendum[]
}

/// Cancelling an advertised or invited exercise (FR-ADV-016), decided on the window_change route.
model WindowCancellation {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  windowId       String
  window         ExerciseWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)

  reason             String
  /// Whether the document fees are refunded. Answered before it is asked for.
  feeRefund          Boolean
  approvalInstanceId String?           @unique
  approvalInstance   ApprovalInstance? @relation("WindowCancellationRoute", fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  requestedOn        DateTime
  appliedAt          DateTime?
  refusedAt          DateTime?
  refusedReason      String            @default("")
  createdAt          DateTime          @default(now())

  notices WindowNotice[]
}

/// One publication of an advertised exercise on a channel (FR-ADV-001). Proof is attached to the
/// exercise (purpose PUBLICATION_PROOF).
model PublicationRecord {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  windowId       String
  window         ExerciseWindow     @relation(fields: [windowId], references: [id], onDelete: Restrict)
  channelId      String
  channel        PublicationChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  /// The channel's name as it read when recorded.
  channelName        String
  publishedOn        DateTime
  /// The title and edition, the board, or the address it was published at.
  reference          String   @default("")
  recordedByPersonId String
  recordedBy         Person   @relation("PublicationRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedAt         DateTime @default(now())

  @@unique([windowId, channelId])
}

/// A contractor on an exercise: proposed for invitation, attending an event, or buying the
/// documents. The one row sales, attendance, letters, addenda and 6.6's envelopes point at.
/// `vendorId` has no key until the supplier register exists (6.15).
model ExerciseParty {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  source         PartySource
  name           String
  registrationNo String
  address        String   @default("")
  phone          String   @default("")
  fax            String   @default("")
  email          String   @default("")
  /// 6.15a (OD-9): the register's supplier, linked by an explicit audited act only (`linkPartyToSupplier`).
  vendorId       String?
  vendor         Supplier? @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  letters          InvitationLetter[]
  specialPermissions SpecialPermission[]
  sales            DocumentSale[]
  attendance       SiteEventAttendance[]
  addendumCopies   AddendumRecipient[]
  notices          WindowNotice[]
  /// 6.6: written only by 6.7's opening (OD-2): a register names no bidder before opening.
  envelopes        BidEnvelope[]
  consents         ValidityExtension[]
  /// 6.7: the bids it was named on at opening, and the awards naming it as the awardee (C-7).
  openedBids       OpenedBid[]
  awards           Award[]

  @@unique([exerciseId, registrationNo])
  /// 6.15a fix R-12: one register supplier is one party on an exercise (unlinked parties, null, are not compared).
  @@unique([exerciseId, vendorId])
}

/// The invitee list a name route approves, written once when the name is requested (ADR 0015).
model NameRouteInvitee {
  id                 String           @id @default(cuid())
  organisationId     String
  organisation       Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  approvalInstanceId String
  approvalInstance   ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)

  name           String
  registrationNo String
  sortOrder      Int    @default(0)

  @@unique([approvalInstanceId, registrationNo])
}

/// One addressed letter of invitation (FR-ADV-002), its text frozen at issue (ADR 0008).
model InvitationLetter {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  windowId       String
  window         ExerciseWindow   @relation(fields: [windowId], references: [id], onDelete: Restrict)
  partyId        String
  party          ExerciseParty    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  /// The approved name route the invitee was on. Null where the method asks no approval of the name.
  nameRouteId    String?
  nameRoute      ApprovalInstance? @relation("LetterNameRoute", fields: [nameRouteId], references: [id], onDelete: Restrict)

  method         DeliveryMethod?
  consignmentRef String          @default("")
  despatchedOn   DateTime?
  acknowledgedOn DateTime?

  templateId          String?
  template            DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateCode        String
  templateBodyVersion Int
  language            DocumentLanguage
  fields              Json
  renderedText        String           @db.Text
  frozenAt            DateTime

  @@unique([windowId, partyId])
}

/// One sale of the documents (FR-ADV-009–012). Checks are what was sighted, attested; the register
/// checks read NOT_CHECKED until the supplier register exists (OD-9).
model DocumentSale {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  windowId       String
  window         ExerciseWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  partyId        String
  party          ExerciseParty  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  /// The organisation's day the sale was recorded on, stamped by the server.
  soldOn      DateTime
  collectedBy String
  authoritySighted          Boolean
  /// Asked only where the exercise is restricted (FR-DOC-009).
  restrictionCertSighted    CertSighted?
  restrictionCertValidUntil DateTime?
  registrationCheck CheckState @default(NOT_CHECKED)
  suspensionCheck   CheckState @default(NOT_CHECKED)
  checkNote         String     @default("")
  /// 6.15a (FR-ADV-010): the register's reading at the sale, frozen. Null: sold before the register
  /// read sales, or to a party not linked to it. Never backfilled.
  eligibilitySnapshot Json?
  /// 6.15a residual 2: recorded under the register with no supplier named for the contractor (so its
  /// checks were not made by the register at this sale). False: a linked sale (it holds the snapshot) or
  /// one made before the register read sales. Written at the sale, never backfilled.
  noSupplierNamed     Boolean    @default(false)
  /// The window's fee as it stood.
  amount            Decimal    @db.Decimal(18, 2)
  paymentMethod     String
  /// The finance system's receipt number, consumed, never minted (OD-11). Null: not yet recorded.
  financeReceiptNo  String?
  receiptRecordedOn DateTime?
  issuedByPersonId  String
  issuedBy          Person     @relation("SaleIssuedBy", fields: [issuedByPersonId], references: [id], onDelete: Restrict)
  /// FR-ADV-011: the purchaser's particulars and the closing as stated, with the issuing officer.
  annotation        Json
  voidedAt          DateTime?
  voidReason        String     @default("")
  createdAt         DateTime   @default(now())

  @@unique([organisationId, financeReceiptNo])
  @@index([windowId])
}

/// A tender briefing or site visit (FR-ADV-003 (e)/(f), FR-ADV-013).
model SiteEvent {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  windowId       String
  window         ExerciseWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)

  kind     SiteEventKind
  startsAt DateTime
  place    String
  /// Answered per event, only where the policy permits mandatory attendance (OD-8). Null: not answered.
  mandatory    Boolean?
  heldOn       DateTime?
  notes        String    @default("")
  cancelledAt  DateTime?
  cancelReason String    @default("")
  createdAt    DateTime  @default(now())

  attendance SiteEventAttendance[]
}

model SiteEventAttendance {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  eventId        String
  event          SiteEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  partyId        String
  party          ExerciseParty @relation(fields: [partyId], references: [id], onDelete: Restrict)

  representative     String
  recordedByPersonId String
  recordedBy         Person   @relation("AttendanceRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedAt         DateTime @default(now())

  @@unique([eventId, partyId])
}

/// A corrigendum or addendum issued during the window (FR-ADV-014). Numbered per exercise when
/// issued, under the window's lock; the signed copy is attached (purpose ADDENDUM_SIGNED).
model Addendum {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  windowId       String
  window         ExerciseWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)

  number          Int?
  title           String
  whatChanged     String         @db.Text
  status          AddendumStatus @default(DRAFT)
  issuedOn        DateTime?
  closingChangeId String?
  closingChange   ClosingChange? @relation(fields: [closingChangeId], references: [id], onDelete: Restrict)
  renderedText        String?    @db.Text
  templateCode        String?
  templateBodyVersion Int?
  frozenAt            DateTime?
  voidReason      String         @default("")
  createdAt       DateTime       @default(now())

  recipients  AddendumRecipient[]
  attachments DocumentAttachment[]

  @@unique([windowId, number])
}

/// One copy of an addendum and how it went: recorded, not sent (INT-09 is not built).
model AddendumRecipient {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  addendumId     String
  addendum       Addendum      @relation(fields: [addendumId], references: [id], onDelete: Restrict)
  partyId        String
  party          ExerciseParty @relation(fields: [partyId], references: [id], onDelete: Restrict)

  /// Given with the documents to a later purchaser, rather than sent.
  withDocuments  Boolean         @default(false)
  method         DeliveryMethod?
  consignmentRef String          @default("")
  despatchedOn   DateTime?
  acknowledgedOn DateTime?
  note           String          @default("")

  @@unique([addendumId, partyId])
}

/// One purchaser's or invitee's notice of a closing change or of the cancellation: recorded, not sent.
model WindowNotice {
  id             String              @id @default(cuid())
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  closingChangeId String?
  closingChange   ClosingChange?      @relation(fields: [closingChangeId], references: [id], onDelete: Restrict)
  cancellationId  String?
  cancellation    WindowCancellation? @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  partyId        String
  party          ExerciseParty       @relation(fields: [partyId], references: [id], onDelete: Restrict)

  method         DeliveryMethod?
  consignmentRef String          @default("")
  despatchedOn   DateTime?
  acknowledgedOn DateTime?
  note           String          @default("")

  @@unique([closingChangeId, partyId])
  @@unique([cancellationId, partyId])
}

// ------------------------------------------------------------------ 6.6 bid receipt

/// What an envelope in the register is (6.6). Closed product vocabulary.
enum EnvelopeKind {
  BID
  /// Marked on the envelope as an alternative bid (FR-BID-006); may name its parent envelope.
  ALTERNATIVE
  /// The implementing department's company estimate, copy 1, lodged into the box (6.2). Never a bid.
  COMPANY_ESTIMATE
}

/// How an envelope reached the organisation.
enum EnvelopeChannel {
  COUNTER
  POST
  COURIER
  /// In the tender box. A bid's BOX envelope is registered only by 6.7 at opening (OD-4); the
  /// company estimate's lodgement goes into the box and is recorded at lodgement.
  BOX
}

/// Where the received instant came from (OD-3 amended): the server's clock when the officer recorded
/// the receipt, or that stamp with the officer's stated time of an earlier receipt beside it.
enum ReceiptSource {
  SERVER
  ENTERED
  /// 6.7 (OD-4, C-3): a bid found in the tender box at opening, registered then. Its time is the
  /// box's LOCKED event (the server's stamp), an upper bound, never a receipt time.
  BOX_AT_OPENING
}

enum EnvelopeStatus {
  RECEIVED
  WITHDRAWN
  /// 6.7: opened at an opening (its offer is on the OpenedBid, never here).
  OPENED
}

/// The tender box's custody acts. Append-only.
enum BoxEventKind {
  LOCKED
  /// Written by 6.7 when the box is opened at the opening.
  UNLOCKED_FOR_OPENING
}

/// One envelope in the register (FR-BID-001 paper register, ADR 0016). It records the envelope,
/// never the offer: there is no price, sum, period, score or document-content column, and nothing
/// edits it but a clerical correction of its markings, channel or receiving officer before closing.
/// `receivedAt`, `sequence`, `late` and `kind` are never corrected. A late one is never deleted,
/// rejected or set aside: its admission is a committee's decision (LATE_TENDER).
model BidEnvelope {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  /// Receipt order on the exercise, allocated under the exercise's lock.
  sequence Int
  kind     EnvelopeKind
  channel  EnvelopeChannel
  /// The server's clock when the receipt was recorded, to the second (FR-BID-002). It alone
  /// decides lateness (OD-3 amended).
  receivedAt     DateTime
  receivedSource ReceiptSource
  /// ENTERED: the time the officer states it was received, with the reason. Shown, never judged.
  statedReceivedAt DateTime?
  entryReason      String    @default("")
  recordedAt       DateTime  @default(now())
  receivedByPersonId String
  receivedBy         Person   @relation("EnvelopeReceivedBy", fields: [receivedByPersonId], references: [id], onDelete: Restrict)
  /// The markings as written on the envelope.
  markings String
  /// The bidder, named only by 6.7's opening (OD-2): null before it.
  partyId String?
  party   ExerciseParty? @relation(fields: [partyId], references: [id], onDelete: Restrict)
  /// FR-BID-003: received after the closing, judged to the second against `closingAtJudged`.
  late                 Boolean
  /// The closing it was judged against, as it stood. Null only for a company estimate lodged
  /// before any closing was set (CHECK in the migration).
  closingAtJudged      DateTime?
  recordedAfterClosing Boolean
  /// An alternative's parent envelope, where its markings name one.
  parentEnvelopeId String?
  parentEnvelope   BidEnvelope?  @relation("EnvelopeParent", fields: [parentEnvelopeId], references: [id], onDelete: Restrict)
  alternatives     BidEnvelope[] @relation("EnvelopeParent")
  status           EnvelopeStatus @default(RECEIVED)
  /// The day a withdrawn envelope was handed back unopened; null while held unopened.
  returnedUnopenedOn DateTime?
  returnNote         String    @default("")
  correctedAt        DateTime?
  createdAt          DateTime  @default(now())
  /// 6.7 (OD-4): a bid found in the box, registered at this opening (BOX_AT_OPENING only, CHECK).
  registeredAtOpeningId String?
  registeredAtOpening   Opening?  @relation("EnvelopeRegisteredAtOpening", fields: [registeredAtOpeningId], references: [id], onDelete: Restrict)

  withdrawal      BidWithdrawal?
  admissionMatters CommitteeDecision[]
  openedBids       OpenedBid[]

  @@unique([exerciseId, sequence])
  @@index([organisationId])
}

/// A bidder's withdrawal (FR-BID-004, X-11): its own record, the letter attached (SULIT), stamped by
/// the server when recorded, and refused after the closing. `envelopeId` names the envelope where it
/// was received over the counter or by post; one in the box is matched by 6.7 at opening, which
/// refuses to open it.
model BidWithdrawal {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  /// The server's clock when the letter was recorded.
  receivedAt         DateTime
  recordedAt         DateTime  @default(now())
  receivedByPersonId String
  receivedBy         Person    @relation("WithdrawalReceivedBy", fields: [receivedByPersonId], references: [id], onDelete: Restrict)
  /// How the letter identifies the envelope, quoted.
  markings           String
  closingAtJudged    DateTime
  envelopeId         String?      @unique
  envelope           BidEnvelope? @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())
  /// 6.7 (X-11): a withdrawal no envelope in the box matched, explained before the opening is
  /// finalised: the finding, its server stamp and who recorded it (on their behalf, not signed).
  unmatchedFinding   String       @default("")
  findingRecordedAt  DateTime?
  findingByPersonId  String?
  findingBy          Person?      @relation("WithdrawalFindingBy", fields: [findingByPersonId], references: [id], onDelete: Restrict)

  attachments DocumentAttachment[]

  @@index([exerciseId])
}

/// The tender box's custody acts (6.6): locked at the closing by a named officer. Append-only. The
/// box, its lock and its key remain the control; the portal records the acts, it does not enforce them.
model BoxEvent {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  kind           BoxEventKind
  /// The server's clock when it was recorded.
  occurredAt     DateTime
  recordedAt     DateTime         @default(now())
  personId       String
  person         Person           @relation("BoxEventBy", fields: [personId], references: [id], onDelete: Restrict)
  note           String           @default("")

  @@index([exerciseId])
}

/// An extension of the bids' validity (FR-BID-010), on the recommended tenderer's written consent
/// (attached, purpose VALIDITY_CONSENT). Append-only; the latest applied extension governs. Before
/// 6.8 the officer names the recommended tenderer, attested and not yet checked against an
/// evaluation (OD-7).
model ValidityExtension {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  /// The expiry it moves from and to (days).
  fromExpiry        DateTime
  toExpiry          DateTime
  reason            String
  consentPartyId    String
  consentParty      ExerciseParty @relation(fields: [consentPartyId], references: [id], onDelete: Restrict)
  /// The day the consent was received.
  consentReceivedOn DateTime
  recordedByPersonId String
  recordedBy         Person    @relation("ExtensionRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedAt         DateTime  @default(now())
  /// Set when it is applied, once the consent is attached.
  appliedAt          DateTime?
  createdAt          DateTime  @default(now())

  attachments DocumentAttachment[]

  @@index([exerciseId])
}

// ------------------------------------------------------------------ 6.7 bid opening

/// The main opening of an exercise, or a supplementary opening of one late envelope its committee
/// admitted (FR-CTE-008, OD-5). Closed product vocabulary.
enum OpeningKind {
  MAIN
  SUPPLEMENTARY
}

/// What the panel recorded for one checklist item of one bid (FR-OPN-008).
enum ChecklistAnswer {
  PRESENT
  ABSENT
  NOT_APPLICABLE
}

/// The opening's verdict on one bid: carried to evaluation, or not (FR-OPN-008, 009).
enum OpeningVerdict {
  PASS
  REJECT
}

/// Whether the bidder held a live sale of the documents (X-11), or, on the invited path, an
/// invitation letter. Computed at opening, never typed.
enum SaleFinding {
  LIVE_SALE
  NO_LIVE_SALE
  NOT_ON_INVITEE_LIST
}

/// FR-DOC-009 on paper: whether the restriction's certificate sighted at the sale was valid on the
/// closing day. Computed at opening, never typed.
enum RestrictionFinding {
  NOT_RESTRICTED
  EVIDENCED
  NOT_EVIDENCED
}

/// OD-9: what the schedule's count of tenderers invited reads. A customer's switch, shipped unset.
enum InvitedCountReading {
  PURCHASERS
  INVITEES
}

/// OD-4: what follows from a bid by a bidder with no live sale (or not invited). A customer's
/// choice per method, shipped unset.
enum UnpurchasedConsequence {
  ELIMINATE
  REPORT
}

/// C-1: the paper estimate in the box against the lodged version, compared only in the finalising
/// transaction, after every other check passed.
enum CopyCheck {
  MATCH
  MISMATCH
  NOT_IN_BOX
}

/// FR-BID-006: an alternative bid as the opening marks it, under the window's frozen answer.
enum AlternativeConsideration {
  CONSIDERED
  NOT_CONSIDERED
}

/// One opening (ADR 0017, OD-6: its own record, not a committee sitting). Every act on it is a
/// server write, audited in its transaction; a finalised opening has no update path but the one
/// attachment it accepts, the signed schedule's scan (FR-OPN-011, source-scanned).
model Opening {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  kind       OpeningKind
  /// 1 for the main opening, then each supplementary opening in turn: the schedule's version.
  sequenceNo Int
  committeeId           String
  committee             Committee @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  committeeNameSnapshot String
  /// SUPPLEMENTARY: the carried LATE_TENDER decision that admitted its envelope (CHECK).
  admissionDecisionId String?            @unique
  admissionDecision   CommitteeDecision? @relation(fields: [admissionDecisionId], references: [id], onDelete: Restrict)

  /// The server's stamp when it was started, and by whom it was recorded (on their behalf, not signed).
  startedAt         DateTime
  startedByPersonId String
  startedBy         Person    @relation("OpeningStartedBy", fields: [startedByPersonId], references: [id], onDelete: Restrict)
  /// The second authorisation's stamp: the box opened (MAIN) or the envelope released (SUPPLEMENTARY).
  unsealedAt        DateTime?
  finalisedAt       DateTime?

  /// MAIN: the box's LOCKED event as judged at start (C-3), and the seconds from the closing to it.
  boxLockedAt    DateTime?
  lockGapSeconds Int?

  /// FR-OPN-002: the committee's panel size as it stood at start; null where it was not set.
  panelSizeRequired       Int?
  /// A panel of another size: the authority it was assigned under, why, and who recorded it.
  panelOverrideAuthority  String  @default("")
  panelOverrideReason     String  @default("")
  panelOverrideByPersonId String?
  panelOverrideBy         Person? @relation("OpeningPanelOverrideBy", fields: [panelOverrideByPersonId], references: [id], onDelete: Restrict)

  /// FR-EST-007: the 6.2 lead check at start and, where it was late, the override (Person, reason).
  estimateLead       Json?
  /// C-1: the paper estimate's figure as typed at finalising (null: not in the box), the lodged
  /// version's figure, and the outcome; written only by the finalising transaction, after disclosure.
  estimatePaperAmount  Decimal?   @db.Decimal(18, 2)
  estimateLodgedAmount Decimal?   @db.Decimal(18, 2)
  estimateCopyCheck    CopyCheck?

  /// The checklist (6.6 `checklistFor` with the parts a bidder returns) and every rule the opening
  /// is judged under, with provenance, as they stood at start (LESSONS: snapshot the rules).
  checklistSnapshot Json
  policySnapshot    Json
  minutes           String @default("") @db.Text
  /// OD-9: the signed schedule's pages, entered.
  schedulePages     Int?
  /// Frozen at finalising (ADR 0008 style): the schedule, its Grand Summary and the faults judged.
  scheduleSnapshot     Json?
  grandSummarySnapshot Json?
  faultsSnapshot       Json?
  createdAt            DateTime @default(now())

  sittings        OpeningSitting[]
  panel           OpeningPanelMember[]
  authorisations  OpeningAuthorisation[]
  bids            OpenedBid[]
  signatures      OpeningSignature[]
  boxEnvelopes    BidEnvelope[]          @relation("EnvelopeRegisteredAtOpening")
  copyExplanation EstimateCopyExplanation?
  attachments     DocumentAttachment[]
  /// 6.8 (E-7): the evaluation versions its finalising opened.
  evaluationsOpened Evaluation[] @relation("EvaluationFromSupplementary")

  @@unique([exerciseId, sequenceNo])
  @@index([organisationId])
}

/// One sitting of an opening: the first from its start, each later one from a resumption. Adjourning
/// ends it, with the reason; nothing recorded is lost (FR-OPN-011, C-2).
model OpeningSitting {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  openingId      String
  opening        Opening      @relation(fields: [openingId], references: [id], onDelete: Restrict)

  sittingNo      Int
  /// The server's stamps.
  startedAt      DateTime
  resumeReason   String    @default("")
  adjournedAt    DateTime?
  adjournReason  String    @default("")
  recordedByPersonId String
  recordedBy         Person @relation("OpeningSittingRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)

  @@unique([openingId, sittingNo])
}

/// A panel member assigned to an opening from its committee's seats in force on the day (FR-OPN-001),
/// with their unit and presence as recorded at start.
model OpeningPanelMember {
  id                  String           @id @default(cuid())
  organisationId      String
  organisation        Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  openingId           String
  opening             Opening          @relation(fields: [openingId], references: [id], onDelete: Restrict)
  personId            String
  person              Person           @relation("OpeningPanelPerson", fields: [personId], references: [id], onDelete: Restrict)
  committeeMemberId   String?
  committeeMember     CommitteeMember? @relation(fields: [committeeMemberId], references: [id], onDelete: SetNull)
  seatLabelSnapshot   String
  /// The member's unit as recorded on the person at start (C-6); null: not recorded.
  orgUnitCodeSnapshot String?
  present             Boolean

  @@unique([openingId, personId])
}

/// One panel member's authorisation to open (FR-OPN-003, C-2), a separate act stamped by the
/// server, recorded on their behalf, not signed. Append-only; keyed per sitting, so resuming needs
/// two fresh ones; an unpaired one is marked lapsed when its sitting is adjourned, never removed.
model OpeningAuthorisation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  openingId      String
  opening        Opening      @relation(fields: [openingId], references: [id], onDelete: Restrict)
  personId       String
  person         Person       @relation("OpeningAuthorisedBy", fields: [personId], references: [id], onDelete: Restrict)
  sittingNo      Int
  recordedAt     DateTime
  lapsedAt       DateTime?

  @@unique([openingId, sittingNo, personId])
}

/// One offer as read at an opening (FR-OPN-005). The only table holding a bid's figure; written only
/// by `openEnvelope`, `recordAlternative` and `correctAsRead` (source scan). SULIT, not restricted
/// until sign-in (C-4).
model OpenedBid {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  openingId      String
  opening        Opening          @relation(fields: [openingId], references: [id], onDelete: Restrict)
  envelopeId     String
  envelope       BidEnvelope      @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  /// Bil.: opening order across the exercise's openings, never the receipt sequence.
  listingNo      Int
  partyId        String
  party          ExerciseParty    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  openedAt       DateTime

  bidderNameAsRead         String
  registrationClassAsRead  String @default("")
  registrationStatusAsRead String @default("")
  priceAsRead              Decimal     @db.Decimal(18, 2)
  completionPeriod         Int?
  completionUnit           PeriodUnit?
  validityDaysStated       Int?

  isAlternative     Boolean                   @default(false)
  parentOpenedBidId String?
  parentOpenedBid   OpenedBid?                @relation("OpenedBidAlternative", fields: [parentOpenedBidId], references: [id], onDelete: Restrict)
  alternatives      OpenedBid[]               @relation("OpenedBidAlternative")
  alternativeStatus AlternativeConsideration?

  saleFinding        SaleFinding
  restrictionFinding RestrictionFinding
  /// 6.15a (FR-BID-008 on paper, OD-6 A): the register's eligibility of a linked bidder, frozen when the
  /// envelope is opened. Null: the bidder was not linked to the register then.
  eligibilityFinding Json?
  /// At the verdict: the items missing and the grounds that eliminate it, as judged.
  completeness       Json?
  verdict            OpeningVerdict?
  verdictReason      String    @default("")
  verdictAt          DateTime?
  asReadCorrectedAt  DateTime?
  /// How many times what was read has been corrected (OD-10). An initial counts only if it was
  /// recorded on the latest reading: its correctionNo equals this (6.7 review M-2, never stamp order).
  asReadCorrections  Int       @default(0)

  initials OpenedBidInitial[]
  answers  OpeningChecklistAnswer[]
  /// 6.8: the evaluation versions it was carried into (`evaluationSet`).
  evaluationBidders EvaluationBidder[]

  @@unique([exerciseId, listingNo])
  @@index([openingId])
  @@index([envelopeId])
}

/// A present panel member's initial on one bid as read (FR-OPN-006), attested.
model OpenedBidInitial {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  openedBidId    String
  openedBid      OpenedBid    @relation(fields: [openedBidId], references: [id], onDelete: Restrict)
  personId       String
  person         Person       @relation("OpenedBidInitialBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt     DateTime
  /// The bid's asReadCorrections when this initial was recorded: it initials that reading (review M-2).
  correctionNo   Int          @default(0)

  @@unique([openedBidId, personId])
}

/// What the panel found for one checklist item of one bid (FR-OPN-008).
model OpeningChecklistAnswer {
  id                String          @id @default(cuid())
  organisationId    String
  organisation      Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  openedBidId       String
  openedBid         OpenedBid       @relation(fields: [openedBidId], references: [id], onDelete: Restrict)
  itemKey           String
  itemLabelSnapshot String
  answer            ChecklistAnswer
  recordedAt        DateTime

  @@unique([openedBidId, itemKey])
}

/// A present panel member's signature on the paper schedule (FR-OPN-006), with the paper's day.
model OpeningSignature {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  openingId      String
  opening        Opening      @relation(fields: [openingId], references: [id], onDelete: Restrict)
  personId       String
  person         Person       @relation("OpeningSignedBy", fields: [personId], references: [id], onDelete: Restrict)
  signedOn       DateTime
  recordedAt     DateTime

  @@unique([openingId, personId])
}

/// C-1: the explanation of a MISMATCH or NOT_IN_BOX copy finding. Append-only, one per opening;
/// until it is recorded the finding holds evaluation and the award back.
model EstimateCopyExplanation {
  id                 String       @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  openingId          String       @unique
  opening            Opening      @relation(fields: [openingId], references: [id], onDelete: Restrict)
  explanation        String       @db.Text
  recordedByPersonId String
  recordedBy         Person       @relation("CopyExplainedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedAt         DateTime
}

/// The organisation's opening rules (OD-9, FR-OPN-010). One row, shipped absent: every null reads
/// "not set" and blocks what it governs; an unset label renders the product's English words.
model OpeningPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  invitedCountReading     InvitedCountReading?
  invitedCountProvenance  Provenance?
  qualifiedLabelEn        String?
  qualifiedLabelMs        String?
  notQualifiedLabelEn     String?
  notQualifiedLabelMs     String?
  lowestLabelEn           String?
  lowestLabelMs           String?
  labelsProvenance        Provenance?
  governingSource         String   @default("")
  updatedAt               DateTime @updatedAt
}

// ------------------------------------------------------------------ 6.8 evaluation

/// The evaluation route a contract basis takes (FR-EVL-005). Closed product vocabulary.
enum EvaluationRoute {
  /// One envelope, every stage evaluated by the joint team.
  TRADITIONAL
  /// A first stage the committee decides on per bidder, then the rest (FR-EVL-005).
  TWO_STAGE
}

/// The kinds of computation a stage is (FR-EVL-008): the code knows only these; every number is
/// the model's configuration (D1, ADR 0018).
enum EvaluationStageKind {
  /// Pass-or-fail items; passed when every item passes.
  CHECKLIST
  /// Which bidders go on, chosen under the stage's shortlist rule.
  SHORTLIST
  /// Entered marks against each criterion's maximum, as a percentage of the stage's total.
  SCORED
  /// The four aspects of FR-EVL-003, a verdict and narrative per bidder per aspect.
  ASPECTS
  /// A minimum-capital test (FR-EVL-010): average balances against a base and a factor, banded.
  FINANCIAL_TEST
  /// Variances against the estimate and the lowest, and a CPR band (FR-EVL-011, 012); display only unless it must be passed.
  COMMERCIAL
  /// A weighted sum of earlier stages' percentages (FR-EVL-008).
  COMPOSITE
  /// A two-stage tender's first stage: one committee matter per bidder (FR-EVL-005).
  COMMITTEE_DECISION
  /// Where the recommendation is formed.
  RECOMMENDATION
}

/// Who acts on a stage (FR-EVL-001, 002).
enum EvaluationSide {
  IMPLEMENTING_DEPARTMENT
  CONTRACT_PROCUREMENT
  COMMITTEE
}

enum CriterionScale {
  ENTERED_MARKS
  PASS_FAIL
  /// A value computed (or entered, for CPR) and placed in the criterion's band set.
  BANDED
}

enum ComputedInput {
  NONE
  MIN_CAPITAL_RATIO
  VARIANCE_VS_ESTIMATE
  VARIANCE_VS_LOWEST
  CPR_PERCENT
}

enum CapitalBase {
  TENDER_AMOUNT
  COMPANY_ESTIMATE
}

enum ShortlistRule {
  COUNT_RANGE
  DECIDED_BY_OFFICE
  NONE
}

enum EvaluationModelStatus {
  DRAFT
  ISSUED
  RETIRED
}

enum AspectKind {
  COMPLETENESS
  PRICE_VS_ESTIMATE
  COMPLETION_PERIOD
  CAPABILITY
  OTHER
}

enum AspectVerdict {
  SATISFACTORY
  NOT_SATISFACTORY
}

enum BandOutcome {
  PASS
  FAIL
  NONE
}

enum EvaluationMeetingKind {
  CLARIFICATION
  NEGOTIATION
}

/// Where an evaluation version stands. Clarification, negotiation and the committee stages are
/// derived from their records (OD-3 A).
enum EvaluationState {
  OPEN
  ISSUED
  SUPERSEDED
  CANCELLED
}

/// What opened an evaluation version (FR-CTE-009, E-7).
enum EvaluationTrigger {
  START
  LOOP
  SUPPLEMENTARY_OPENING
}

enum CommunicationDirection {
  TO_TENDERER
  FROM_TENDERER
}

/// The written channels a communication went by (FR-EVL-013). The portal sends nothing (INT-09).
enum CommunicationChannel {
  LETTER
  EMAIL
  FAX
}

/// A versioned evaluation model (FR-EVL-006): drafted, issued (its content frozen in
/// `contentSnapshot`, never edited after), retired. A change is a new version. Ships with no rows:
/// every model is the customer's (D1, rule 1).
model EvaluationModel {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  code    String
  version Int
  nameEn  String
  nameMs  String?
  route   EvaluationRoute
  status  EvaluationModelStatus @default(DRAFT)
  issuedAt  DateTime?
  retiredAt DateTime?
  /// Stages, criteria, factor options, band sets and the aspects in force, as issued.
  contentSnapshot Json?

  provenance      Provenance @default(ASSUMED)
  governingSource String     @default("")
  notes           String     @default("")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  stages    EvaluationStage[]
  bandSets  EvaluationBandSet[]
  exercises SourcingExercise[]

  @@unique([organisationId, code, version])
}

/// One stage of a model, in order (FR-EVL-002, 008, 009).
model EvaluationStage {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  modelId        String
  model          EvaluationModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  order   Int
  code    String
  labelEn String
  labelMs String?
  kind    EvaluationStageKind
  side    EvaluationSide
  /// Scores on this stage are refused until the stage of this order is submitted (FR-EVL-002).
  unlocksAfterOrder Int?
  /// SCORED: the total its top-level criteria's maximum marks sum to.
  maxMarks        Decimal? @db.Decimal(9, 4)
  passMark        Decimal? @db.Decimal(9, 4)
  /// Whether a figure exactly on the pass mark passes. Null with a pass mark: not set (PASS_RULE_NOT_SET).
  passInclusive   Boolean?
  /// Failing this stage puts the bidder out of the running ("must pass each individually").
  mustPass        Boolean?
  /// The weight this stage's percentage carries in the COMPOSITE stage.
  compositeWeight Decimal? @db.Decimal(9, 4)
  /// COMMITTEE_DECISION: the committee (Committee.code) each bidder's matter goes to.
  committeeCode   String?
  shortlistRule       ShortlistRule?
  shortlistMin        Int?
  shortlistMax        Int?
  /// DECIDED_BY_OFFICE: the office (AuthorityRole.code) whose holder decides the shortlist.
  shortlistOfficeCode String?
  /// FINANCIAL_TEST: what the minimum capital is a percentage of.
  capitalBase         CapitalBase?

  provenance      Provenance @default(ASSUMED)
  governingSource String     @default("")

  criteria      EvaluationCriterion[]
  factorOptions EvaluationFactorOption[]

  @@unique([modelId, code])
  @@unique([modelId, order])
}

/// A criterion of a stage; a group (a 40-mark block) holds criteria as children.
model EvaluationCriterion {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  stageId        String
  stage          EvaluationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         EvaluationCriterion?  @relation("CriterionGroup", fields: [parentId], references: [id], onDelete: Cascade)
  children       EvaluationCriterion[] @relation("CriterionGroup")

  order    Int
  code     String
  labelEn  String
  labelMs  String?
  maxMarks Decimal?       @db.Decimal(9, 4)
  scale    CriterionScale
  computedInput ComputedInput @default(NONE)
  /// BANDED: the model's band set (EvaluationBandSet.code) the value is placed in.
  bandSetCode   String?
  /// The criterion needs a named contractor (a key person, a nominated sub-contractor) to be judged.
  needsNamedContractor Boolean @default(false)

  provenance      Provenance @default(ASSUMED)
  governingSource String     @default("")

  @@unique([stageId, code])
}

/// A factor a FINANCIAL_TEST stage may apply, chosen per bidder and recorded (FR-EVL-010).
model EvaluationFactorOption {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  stageId        String
  stage          EvaluationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  code      String
  labelEn   String
  labelMs   String?
  factorPct Decimal @db.Decimal(9, 4)

  provenance      Provenance @default(ASSUMED)
  governingSource String     @default("")

  @@unique([stageId, code])
}

/// A model's set of bands a value is placed in (FR-EVL-010, 011, 012). A gap leaves a value
/// NOT_BANDED, never a guess (OD-5 A).
model EvaluationBandSet {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  modelId        String
  model          EvaluationModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  code   String
  nameEn String

  provenance      Provenance @default(ASSUMED)
  governingSource String     @default("")

  bands EvaluationBand[]

  @@unique([modelId, code])
}

/// One band: its edges, each inclusive or not, or open; an edge may be the stage's floor (the
/// minimum capital's factor) rather than a number.
model EvaluationBand {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  setId          String
  set            EvaluationBandSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  labelEn        String
  labelMs        String?
  lower          Decimal? @db.Decimal(9, 4)
  lowerInclusive Boolean  @default(true)
  lowerIsFloor   Boolean  @default(false)
  upper          Decimal? @db.Decimal(9, 4)
  upperInclusive Boolean  @default(false)
  upperIsFloor   Boolean  @default(false)
  outcome        BandOutcome
  sortOrder      Int      @default(0)
}

/// An aspect of FR-EVL-003, assessed per bidder on an ASPECTS stage. Required on a route by
/// configuration; frozen into a model's content when it is issued.
model EvaluationAspect {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  code            String
  kind            AspectKind
  labelEn         String
  labelMs         String?
  requiredOnRoute EvaluationRoute?

  provenance      Provenance @default(ASSUMED)
  governingSource String     @default("")
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  @@unique([organisationId, code])
}

/// The organisation's evaluation policy. One row, shipped absent: each null blocks the act it
/// governs, naming it.
model EvaluationPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// The numbering series (NumberingSeries.key) the report's reference is issued from (§9.5).
  reportSeriesKey         String?
  /// How many decimal places a score is shown and judged at (E-5, OD-9). Frozen at the start.
  scoreDecimals           Int?
  scoreDecimalsProvenance Provenance?
  /// The offices whose holders check and recommend the Kertas Cadangan (FR-CTE-013).
  checkerRoleCode         String?
  recommenderRoleCode     String?
  reportTemplateId        String?
  reportTemplate          DocumentTemplate? @relation("EvaluationReportTemplate", fields: [reportTemplateId], references: [id], onDelete: Restrict)
  proposalTemplateId      String?
  proposalTemplate        DocumentTemplate? @relation("EvaluationProposalTemplate", fields: [proposalTemplateId], references: [id], onDelete: Restrict)
  /// The annexes' labels, A to F, English and Malay. Null: the product's English labels.
  annexLabels             Json?
  annexLabelsProvenance   Provenance?

  governingSource String   @default("")
  notes           String   @default("")
  updatedAt       DateTime @updatedAt
}

/// One evaluation version of an exercise (FR-EVL-017, FR-CTE-009, E-7). Its report is issued
/// once, frozen, and superseded by the next version, never edited. SULIT: not restricted until
/// sign-in (E-3).
model Evaluation {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId     String
  exercise       SourcingExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  version   Int
  state     EvaluationState
  trigger   EvaluationTrigger
  startedAt DateTime
  /// Who started it (START, or the officer finalising a supplementary opening); null where a
  /// committee's decision opened it (LOOP), which names no person (CHECK).
  startedByPersonId String?
  startedBy         Person? @relation("EvaluationStartedBy", fields: [startedByPersonId], references: [id], onDelete: Restrict)
  /// The organisation's rules this version is judged under, frozen when it started (E-5).
  policySnapshot Json
  /// LOOP: the matter not carried, and the product key it returned to (FR-CTE-009).
  loopDecisionId String?
  loopDecision   CommitteeDecision? @relation("EvaluationLoopDecision", fields: [loopDecisionId], references: [id], onDelete: Restrict)
  loopStageKey   String?
  /// SUPPLEMENTARY_OPENING: the opening whose finalising opened it (E-7).
  supplementaryOpeningId String?
  supplementaryOpening   Opening? @relation("EvaluationFromSupplementary", fields: [supplementaryOpeningId], references: [id], onDelete: Restrict)

  reportReference    String?
  issuedAt           DateTime?
  issuedByPersonId   String?
  issuedBy           Person?   @relation("EvaluationIssuedBy", fields: [issuedByPersonId], references: [id], onDelete: Restrict)
  /// Annexes A–E rendered, F listed, the recommendation and the saving, as issued (ADR 0008).
  reportSnapshot     Json?
  /// FR-BID-010 (6.6 OD-7): each applied extension's consent party against the recommendation.
  consentCheckSnapshot Json?
  supersededAt       DateTime?
  cancelledAt        DateTime?
  cancelledByPersonId String?
  cancelledBy         Person? @relation("EvaluationCancelledBy", fields: [cancelledByPersonId], references: [id], onDelete: Restrict)
  createdAt          DateTime  @default(now())

  team           EvaluationTeamMember[]
  bidders        EvaluationBidder[]
  submissions    StageSubmission[]
  results        StageResult[]
  meetings       EvaluationMeeting[]
  communications TendererCommunication[]
  negotiations   NegotiationRequest[]
  recommendation Recommendation?
  proposalPaper  ProposalPaper?
  attachments    DocumentAttachment[]

  @@unique([exerciseId, version])
  @@unique([organisationId, reportReference])
  @@index([organisationId])
}

/// A team member on one side (FR-EVL-001), with their unit as recorded on the day.
model EvaluationTeamMember {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String
  evaluation     Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  personId       String
  person         Person         @relation("EvaluationTeamPerson", fields: [personId], references: [id], onDelete: Restrict)
  side           EvaluationSide
  orgUnitCodeSnapshot String?
  appointedOn    DateTime
  recordedAt     DateTime

  @@unique([evaluationId, personId])
}

/// A bid carried to evaluation (`evaluationSet`), and what is recorded of it there. SULIT.
model EvaluationBidder {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String
  evaluation     Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  openedBidId    String
  openedBid      OpenedBid    @relation(fields: [openedBidId], references: [id], onDelete: Restrict)

  /// FR-EVL-019: excluded above the exercise's own ceiling, with the reason and what it was judged on.
  excludedReason  String @default("")
  ceilingSnapshot Json?
  /// The price after arithmetic correction, why, and by whom.
  correctedPrice        Decimal? @db.Decimal(18, 2)
  correctionReason      String   @default("")
  correctedAt           DateTime?
  correctedByPersonId   String?
  correctedBy           Person?  @relation("EvaluationCorrectedBy", fields: [correctedByPersonId], references: [id], onDelete: Restrict)
  shortlisted           Boolean?
  shortlistedAt         DateTime?
  shortlistedByPersonId String?
  shortlistedBy         Person?  @relation("EvaluationShortlistedBy", fields: [shortlistedByPersonId], references: [id], onDelete: Restrict)
  /// FR-EVL-010: the factor option chosen, and three monthly balances (E-6).
  factorOptionCode String?
  balanceMonth1    Decimal? @db.Decimal(18, 2)
  balanceMonth2    Decimal? @db.Decimal(18, 2)
  balanceMonth3    Decimal? @db.Decimal(18, 2)
  /// FR-EVL-012 (OD-4): entered from the attached performance report, not from the register.
  cprPercent       Decimal? @db.Decimal(9, 4)
  inputsRecordedAt       DateTime?
  inputsRecordedByPersonId String?
  inputsRecordedBy       Person? @relation("EvaluationInputsBy", fields: [inputsRecordedByPersonId], references: [id], onDelete: Restrict)
  /// E-7: the bidder of the version before, where this one carried its record forward.
  carriedFromId String?
  carriedFrom   EvaluationBidder?  @relation("BidderCarried", fields: [carriedFromId], references: [id], onDelete: Restrict)
  carriedTo     EvaluationBidder[] @relation("BidderCarried")

  scores         EvaluationScore[]
  results        StageResult[]
  aspects        AspectAssessment[]
  meetings       EvaluationMeeting[]
  communications TendererCommunication[]
  negotiations   NegotiationRequest[]
  recommendations Recommendation[]
  stageMatters   CommitteeDecision[]
  attachments    DocumentAttachment[]

  @@unique([evaluationId, openedBidId])
}

/// One score on one criterion of one bidder (FR-EVL-001): append-only, a rescore is a new row
/// superseding the last; recorded on the scorer's behalf, not signed, stamped by the server.
model EvaluationScore {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         EvaluationBidder @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  stageCode      String
  criterionCode  String
  marks          Decimal? @db.Decimal(9, 4)
  passed         Boolean?
  note           String   @default("")
  scoredByPersonId String
  scoredBy         Person  @relation("EvaluationScoredBy", fields: [scoredByPersonId], references: [id], onDelete: Restrict)
  recordedAt     DateTime
  supersedesId   String?  @unique
  supersedes     EvaluationScore? @relation("ScoreSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy   EvaluationScore? @relation("ScoreSupersedes")
  /// E-7: carried from the version before for an unchanged bidder, and labelled so.
  carriedFromScoreId String?
  carriedFromScore   EvaluationScore?  @relation("ScoreCarried", fields: [carriedFromScoreId], references: [id], onDelete: Restrict)
  carriedTo          EvaluationScore[] @relation("ScoreCarried")

  @@index([bidderId, stageCode, criterionCode])
}

/// A stage's submission by a team member on its side (FR-EVL-002), stamped by the server.
model StageSubmission {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String
  evaluation     Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  stageCode      String
  side           EvaluationSide
  submittedByPersonId String
  submittedBy         Person    @relation("StageSubmittedBy", fields: [submittedByPersonId], references: [id], onDelete: Restrict)
  submittedAt    DateTime

  @@unique([evaluationId, stageCode])
}

/// A bidder's result on a submitted stage, frozen with the submission: the percentage to four
/// places, the figure shown and judged (E-5), passed or not, the band, and whether it is out of
/// the running.
model StageResult {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String
  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         EvaluationBidder @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  stageCode      String
  percent        Decimal? @db.Decimal(9, 4)
  shown          Decimal? @db.Decimal(9, 4)
  passed         Boolean?
  bandLabel      String?
  outOfRunning   Boolean  @default(false)
  /// What else the stage computed for this bidder (variances, the minimum capital), as words and
  /// fixed-point strings, never a float.
  detail         Json?

  @@unique([bidderId, stageCode])
  @@index([evaluationId])
}

/// One aspect's verdict and narrative on one bidder (FR-EVL-003): append-only, a reassessment
/// supersedes the last.
model AspectAssessment {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         EvaluationBidder @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  aspectCode     String
  verdict        AspectVerdict
  narrative      String @db.Text
  assessedByPersonId String
  assessedBy         Person @relation("AspectAssessedBy", fields: [assessedByPersonId], references: [id], onDelete: Restrict)
  recordedAt     DateTime
  supersedesId   String?  @unique
  supersedes     AspectAssessment? @relation("AspectSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy   AspectAssessment? @relation("AspectSupersedes")

  @@index([bidderId, aspectCode])
}

/// A negotiation asked for on the engine's `negotiation` route (FR-EVL-016), with one bidder.
model NegotiationRequest {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String
  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         EvaluationBidder @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  reason         String @db.Text
  approvalInstanceId String           @unique
  approvalInstance   ApprovalInstance @relation("NegotiationRoute", fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  requestedByPersonId String
  requestedBy         Person @relation("NegotiationRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: Restrict)
  requestedAt    DateTime
}

/// A clarification or negotiation meeting with one bidder (FR-EVL-015, 016): held, then closed
/// with its minutes and the tenderer's written confirmation; closed, it is frozen.
model EvaluationMeeting {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String
  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         EvaluationBidder @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  kind           EvaluationMeetingKind
  round          Int
  heldOn         DateTime
  place          String
  minutes        String   @default("") @db.Text
  /// NEGOTIATION: the price before and after the round. SULIT.
  priceBefore    Decimal? @db.Decimal(18, 2)
  priceAfter     Decimal? @db.Decimal(18, 2)
  approvalInstanceId String?
  approvalInstance   ApprovalInstance? @relation("NegotiationMeetingRoute", fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  openedByPersonId String
  openedBy         Person   @relation("EvaluationMeetingOpenedBy", fields: [openedByPersonId], references: [id], onDelete: Restrict)
  openedAt       DateTime
  closedAt       DateTime?
  closedByPersonId String?
  closedBy         Person?  @relation("EvaluationMeetingClosedBy", fields: [closedByPersonId], references: [id], onDelete: Restrict)

  attachments DocumentAttachment[]

  @@unique([evaluationId, bidderId, kind, round])
}

/// A written communication with a tenderer during evaluation (FR-EVL-013). The portal sends
/// nothing: the log is complete only for what is recorded.
model TendererCommunication {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String
  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         EvaluationBidder @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  direction      CommunicationDirection
  channel        CommunicationChannel
  sentOn         DateTime?
  receivedOn     DateTime?
  subject        String
  content        String @db.Text
  recordedByPersonId String
  recordedBy         Person @relation("CommunicationRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedAt     DateTime
}

/// The evaluation's recommendation (FR-EVL-004, 017, 018): one per version. SULIT.
model Recommendation {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String           @unique
  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         EvaluationBidder @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  price            Decimal     @db.Decimal(18, 2)
  completionPeriod Int?
  completionUnit   PeriodUnit?
  topRanked        Boolean
  justification    String      @default("") @db.Text
  formedByPersonId String
  formedBy         Person      @relation("RecommendationFormedBy", fields: [formedByPersonId], references: [id], onDelete: Restrict)
  formedAt         DateTime
}

/// The Kertas Cadangan (FR-CTE-013): rendered from the issued report through the configured
/// template and frozen; checked and recommended by the holders of two offices, two different people.
model ProposalPaper {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  evaluationId   String           @unique
  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  templateId          String
  template            DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateCode        String
  templateBodyVersion Int
  language            DocumentLanguage
  renderedText        String @db.Text
  frozenAt            DateTime
  renderedByPersonId  String
  renderedBy          Person @relation("ProposalRenderedBy", fields: [renderedByPersonId], references: [id], onDelete: Restrict)
  /// The offices as they stood when it was rendered (frozen).
  checkerRoleCode     String
  recommenderRoleCode String
  checkedByPersonId     String?
  checkedBy             Person?   @relation("ProposalCheckedBy", fields: [checkedByPersonId], references: [id], onDelete: Restrict)
  checkedOn             DateTime?
  checkedRecordedAt     DateTime?
  recommendedByPersonId String?
  recommendedBy         Person?   @relation("ProposalRecommendedBy", fields: [recommendedByPersonId], references: [id], onDelete: Restrict)
  recommendedOn         DateTime?
  recommendedRecordedAt DateTime?
}

// ------------------------------------------------------------------ 6.15 supplier register (ADR 0019)

/// FR-VND-003: what a registration body's value is. Closed product vocabulary; the values are configuration.
enum RegistrationValueKind {
  GRADE
  CATEGORY
  SPECIALISATION
  FIELD_CODE
  CLASS
  PERMIT_TYPE
}

/// Where a supplier stands as a registrant. Standing (suspended, blacklisted) is derived, never stored.
enum SupplierStatus {
  APPLICANT
  REGISTERED
  REJECTED
}

enum ApplicationKind {
  NEW
  RENEWAL
  UPGRADE
}

/// How an application reached the organisation. PORTAL is the public form, with no officer behind it.
enum ApplicationChannel {
  COUNTER
  POST
  EMAIL
  PORTAL
}

enum ApplicationStatus {
  RECEIVED
  RESUBMISSION_REQUESTED
  APPROVED
  REJECTED
}

/// FR-VND-007. LAPSE is the rejection a lapsed resubmission deadline records.
enum ApplicationOutcome {
  APPROVE
  RESUBMIT
  REJECT
  LAPSE
}

enum VerificationState {
  NOT_CHECKED
  VERIFIED
  NOT_IN_ORDER
}

/// The register's own lists (step 0: not classification taxonomies, which classification reads).
enum SupplierListKind {
  ENTITY_TYPE
  COUNTRY
}

/// A value under a registration body (FR-VND-003): a grade, a category, a specialisation (under a
/// category), a field code, a class or a permit type. The published lists are an RSAJ seed, never shipped.
model RegistrationValue {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  bodyId         String
  body           RegistrationBody @relation(fields: [bodyId], references: [id], onDelete: Restrict)

  kind       RegistrationValueKind
  code       String
  nameEn     String
  nameMs     String?
  /// A specialisation's category, by its code under the same body.
  parentCode String?
  /// A grade's place in the body's order (the higher, the more it covers). Configuration, never inferred.
  rank       Int?
  /// A grade's value ceiling as the body publishes it: shown only, never compared with the sealed estimate (OD-10 A).
  valueCeiling      Decimal?    @db.Decimal(18, 2)
  ceilingProvenance Provenance?

  governingSource String     @default("")
  provenance      Provenance
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  documentValues SupplierDocumentValue[]

  @@unique([bodyId, kind, code])
}

/// A statutory document type (FR-VND-002): configured, never an enum or a column per regulator. Its
/// switches are null until set, and each blocks the act it governs while unset.
model SupplierDocumentType {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  code   String
  nameEn String
  nameMs String?
  /// The body whose values it records. Null: none.
  bodyId     String?
  body       RegistrationBody?       @relation(fields: [bodyId], references: [id], onDelete: Restrict)
  valueKinds RegistrationValueKind[] @default([])
  expires                 Boolean?
  mandatoryAtRegistration Boolean?
  notApplicableAllowed    Boolean?

  governingSource String     @default("")
  provenance      Provenance
  sortOrder       Int        @default(0)
  retiredOn       DateTime?

  documents         SupplierDocument[]
  resubmissionItems ResubmissionItem[]

  @@unique([organisationId, code])
  restrictionPolicies SupplierPolicy[] @relation("RestrictionEvidence")
}

/// An entry on one of the register's lists: an entity type or a country.
model SupplierListValue {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  list       SupplierListKind
  code       String
  nameEn     String
  nameMs     String?
  provenance Provenance
  sortOrder  Int       @default(0)
  retiredOn  DateTime?

  @@unique([organisationId, list, code])
}

/// The register's policy, one per organisation. Every field nullable, nothing shipped.
model SupplierPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// FR-VND-004: what the supplier is told about verification (shown to the vendor in 6.15b). Null: not set.
  verificationNoticeEn String?
  verificationNoticeMs String?
  noticeProvenance     Provenance?

  /// FR-VND-008 (a2): the expiry bands, in days left. Null: not set, and nothing is banded (never "valid").
  /// Each band includes its own figure: with critical 30, a document 30 days from expiry is critical.
  criticalDays      Int?
  warningDays       Int?
  upcomingDays      Int?
  bandsProvenance   Provenance?
  /// OD-4: whether a document expiring on the closing day still counts as valid for the window.
  /// Null: not set, and that one case reads "not assessed".
  expiryOnClosingDayCounts Boolean?
  closingDayProvenance     Provenance?
  /// OD-7: whether a registered supplier with an expired mandatory document stands suspended (derived
  /// on read, never stored). Null: not set, and it reads "Active — lapse rule not set".
  autoSuspendOnLapse Boolean?
  /// The reason a suspension on lapse is shown with.
  lapseReasonId      String?
  lapseReason        StandingReason? @relation("LapseReason", fields: [lapseReasonId], references: [id], onDelete: Restrict)
  lapseProvenance    Provenance?
  /// Condition (4), FR-TRM-017: how long a first-offence blacklisting lasts, in months. A later offence
  /// lasts until further notice. Null: not set, and a first-offence blacklisting cannot be recorded.
  blacklistFirstOffenceMonths Int?
  blacklistProvenance         Provenance?
  /// OD-5: whether a document may be sold only to a purchaser on the register. Null: not set.
  registerRequiredForSale Boolean?
  saleProvenance          Provenance?
  /// FR-DOC-009: the document type that evidences a restricted tender's restriction. Null: not set.
  restrictionEvidenceTypeId String?
  restrictionEvidenceType   SupplierDocumentType? @relation("RestrictionEvidence", fields: [restrictionEvidenceTypeId], references: [id], onDelete: Restrict)
  restrictionProvenance     Provenance?
  /// The notice an applicant reads before sending the public form (PDPA 2010 s.7), in the customer's own words.
  /// Null: not set, and the public form stays closed.
  personalDataNoticeEn   String?
  personalDataNoticeMs   String?
  personalDataProvenance Provenance?
  /// How many online applications the form takes in any 24 hours, and how many for one registration number.
  /// Null: not set, and the public form stays closed (nothing is assumed).
  portalDailyLimit          Int?
  portalDailyLimitPerNumber Int?
  portalLimitProvenance     Provenance?
  /// OD-6 A: what follows at an opening from a linked bidder found not eligible. Null: not set, and an
  /// opening holding such a bid cannot finalise, naming this setting.
  ineligibleBidConsequence IneligibleBidConsequence?
  ineligibleProvenance     Provenance?

  governingSource String   @default("")
  updatedAt       DateTime @updatedAt
}

/// A supplier on the register (ADR 0019): recorded by an officer from its paper application. Its
/// standing is derived, never a column. Its people are `SupplierContact` rows, never `Person`.
model Supplier {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// Issued from NumberingSeries `supplier`.
  reference         String
  registeredName    String
  registrationNo    String
  /// The number as compared for duplicates (spaces collapsed, capitals): the database's backstop.
  registrationNoKey String
  /// Codes on the register's lists, rendered by their names.
  entityTypeCode    String
  countryCode       String
  registeredAddress String
  companyEmail      String

  status       SupplierStatus @default(APPLICANT)
  /// The organisation's day the first registration was approved.
  registeredOn DateTime?

  /// INT-03: the finance system's vendor code, entered by an officer (manual adapter). Null: not synced.
  erpVendorCode String?
  erpSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts     SupplierContact[]
  applications SupplierApplication[]
  documents    SupplierDocument[]
  /// a2: its standing, as recorded acts (append-only); suspension on lapse is derived, never stored.
  standingEvents   StandingEvent[]
  standingRequests StandingRequest[]
  /// a2 (OD-9): the parties and awards explicitly linked to it. Never inferred.
  parties ExerciseParty[]
  awards  Award[]
  /// The online application an officer recorded this supplier from, where it came through the portal.
  portalApplications PortalApplication[]

  @@unique([organisationId, reference])
  @@unique([organisationId, registrationNoKey])
  @@unique([organisationId, erpVendorCode])
}

/// A person at a supplier, as the supplier names them. Not a `Person` (NFR-SEC-005; 6.15b attaches a
/// vendor account to a contact, ADR 0020). Not restricted until sign-in.
model SupplierContact {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  name        String
  designation String    @default("")
  email       String    @default("")
  phone       String    @default("")
  isPrimary   Boolean   @default(false)
  retiredOn   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([supplierId])
}

/// A paper application recorded by an officer (FR-VND-001, 006, 007).
model SupplierApplication {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  kind       ApplicationKind
  /// The organisation's day the paper arrived, as the officer records it (never after the day recorded).
  receivedOn DateTime
  channel    ApplicationChannel
  /// The officer who recorded the application, from the paper or from the staged online application. Every write names one.
  /// Nullable only for the one test record the superseded direct portal path made (rejected, kept as history): the CHECK
  /// SupplierApplication_recorder_portal_only refuses a null on any channel but PORTAL.
  recordedByPersonId String?
  recordedBy         Person?  @relation("SupplierApplicationRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  /// The server's time it was recorded or received.
  recordedAt         DateTime
  /// FR-VND-006 (paper): the day the signed declaration was signed; its scan is attached on the application.
  declarationSignedOn    DateTime?
  /// OD-3 B: only that the paper E-Payment form was received; no bank field before sign-in.
  epaymentFormReceivedOn DateTime?

  status           ApplicationStatus @default(RECEIVED)
  resubmitBy       DateTime?
  /// When the rejection a lapsed deadline means was recorded (server). The lapse itself is derived.
  lapsedRecordedAt DateTime?
  /// Who sent it for decision last: the route's requester (FR-APR-008).
  submittedByPersonId String?
  submittedBy         Person?   @relation("SupplierApplicationSubmittedBy", fields: [submittedByPersonId], references: [id], onDelete: Restrict)
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())

  routes      ApprovalInstance[]
  decisions   ApplicationDecision[]
  documents   SupplierDocument[]
  attachments DocumentAttachment[]

  @@index([supplierId])
}

enum PortalApplicationStatus {
  /// Sent, and waiting for an officer.
  RECEIVED
  /// An officer recorded the supplier from it.
  RECORDED
  /// An officer set it aside, with a reason.
  DISCARDED
}

/// An application sent through the public form, before an officer has looked at it. It is not a supplier:
/// it holds no registration number's place on the register, spends no supplier reference and fails no
/// one else's application. An officer checks it against the certificate and records the supplier from
/// it (the register's own duplicate check applies then), or discards it. The applicant's own words are
/// erased once it is decided: what remains is the reference, the days and the outcome.
model PortalApplication {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// Issued from NumberingSeries `portal_application`. Shown once to the applicant, who has no way to look it up.
  reference  String
  status     PortalApplicationStatus @default(RECEIVED)
  /// The organisation's day it was sent, and the server's time.
  receivedOn DateTime
  receivedAt DateTime

  /// As typed. Blank once erased.
  registeredName     String    @default("")
  registrationNo     String    @default("")
  /// The number as compared (spaces collapsed, capitals). Not unique: anyone may send any number.
  registrationNoKey  String    @default("")
  entityTypeCode     String    @default("")
  countryCode        String    @default("")
  registeredAddress  String    @default("")
  companyEmail       String    @default("")
  contactName        String    @default("")
  contactDesignation String    @default("")
  contactEmail       String    @default("")
  contactPhone       String    @default("")
  erasedAt           DateTime?

  decidedAt          DateTime?
  decidedByPersonId  String?
  decidedBy          Person?   @relation("PortalApplicationDecidedBy", fields: [decidedByPersonId], references: [id], onDelete: Restrict)
  /// Why it was set aside, as the officer wrote it. Never holds the applicant's details.
  discardReason      String    @default("")
  acceptedSupplierId String?
  acceptedSupplier   Supplier? @relation(fields: [acceptedSupplierId], references: [id], onDelete: Restrict)

  @@unique([organisationId, reference])
  @@index([organisationId, status, receivedAt])
  @@index([organisationId, registrationNoKey])
}

/// An outcome recorded on an application (FR-VND-007). Append-only. `policySnapshot` holds what the
/// outcome was judged under (the mandatory types and their states, with provenance), rendered from, never re-derived.
model ApplicationDecision {
  id             String              @id @default(cuid())
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  applicationId  String
  application    SupplierApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  outcome    ApplicationOutcome
  /// As written, verbatim (FR-VND-007).
  remarks    String    @default("")
  resubmitBy DateTime?
  /// Null on a lapse (derived and recorded, nobody's decision) and on an approval recorded by its route.
  decidedByPersonId String?
  decidedBy         Person?   @relation("ApplicationDecidedBy", fields: [decidedByPersonId], references: [id], onDelete: Restrict)
  decidedOn         DateTime
  decidedAt         DateTime
  policySnapshot    Json?

  items ResubmissionItem[]

  @@index([applicationId])
}

/// One thing a resubmission asks for: a document on file, or a type not lodged yet, with its remarks.
model ResubmissionItem {
  id             String              @id @default(cuid())
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  decisionId     String
  decision       ApplicationDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  supplierDocumentId String?
  supplierDocument   SupplierDocument?     @relation(fields: [supplierDocumentId], references: [id], onDelete: Restrict)
  documentTypeId     String?
  documentType       SupplierDocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  /// What it is about, as it read when asked.
  labelSnapshot      String
  remarks            String

  @@index([decisionId])
}

/// A lodged statutory document (FR-VND-002, 004, 008). A renewal is a new row that supersedes the
/// one it renews; it takes effect only once verified. Its state on a day is derived.
model SupplierDocument {
  id             String               @id @default(cuid())
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  supplierId     String
  supplier       Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  typeId         String
  type           SupplierDocumentType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// The type's name as it stood when lodged.
  typeLabelSnapshot String
  /// The application it was lodged with, where it was.
  applicationId  String?
  application    SupplierApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  reference        String    @default("")
  issuingAuthority String    @default("")
  issuedOn         DateTime?
  validFrom        DateTime?
  expiresOn        DateTime?
  notApplicable    Boolean   @default(false)
  supersedesId     String?   @unique
  supersedes       SupplierDocument? @relation("DocumentRenewal", fields: [supersedesId], references: [id], onDelete: Restrict)
  renewedBy        SupplierDocument? @relation("DocumentRenewal")

  /// The organisation's day it was lodged, and who recorded it (on their behalf, not signed).
  lodgedOn           DateTime
  recordedAt         DateTime
  recordedByPersonId String
  recordedBy         Person   @relation("SupplierDocumentRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)

  verification       VerificationState @default(NOT_CHECKED)
  verifiedByPersonId String?
  verifiedBy         Person?           @relation("SupplierDocumentVerifiedBy", fields: [verifiedByPersonId], references: [id], onDelete: Restrict)
  verifiedOn         DateTime?
  verifiedAt         DateTime?
  verificationNote   String            @default("")
  note               String            @default("")

  values            SupplierDocumentValue[]
  attachments       DocumentAttachment[]
  resubmissionItems ResubmissionItem[]

  @@index([supplierId])
}

/// A registration value recorded on a document, with its code and name as they stood.
model SupplierDocumentValue {
  id                  String            @id @default(cuid())
  organisationId      String
  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  documentId          String
  document            SupplierDocument  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  registrationValueId String
  registrationValue   RegistrationValue @relation(fields: [registrationValueId], references: [id], onDelete: Restrict)
  kind                RegistrationValueKind
  codeSnapshot        String
  labelSnapshot       String

  @@unique([documentId, registrationValueId])
}

/// 6.15a (FR-VND-010): what a standing event records.
enum StandingEventKind {
  SUSPEND
  REINSTATE
  BLACKLIST
  BLACKLIST_LIFT
  REGISTRATION_CANCELLED
}

/// 6.15a: which act a standing reason may be given for.
enum StandingReasonUse {
  SUSPEND
  BLACKLIST
}

/// 6.15a (OD-8 A): what a standing request asks its route for.
enum StandingRequestKind {
  BLACKLIST
  BLACKLIST_LIFT
}

/// 6.15a (OD-6 A): what follows at an opening from a linked bidder found not eligible. A customer's
/// choice, shipped unset.
enum IneligibleBidConsequence {
  ELIMINATE
  REPORT
}

/// 6.15a (FR-ADV-017): which condition a special permission relaxes.
enum PermissionRelaxes {
  GRADE
  FIELD_CODE
}

/// 6.15a (FR-VND-010): the maintained list of reasons for a suspension or a blacklisting.
model StandingReason {
  id              String            @id @default(cuid())
  organisationId  String
  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  code            String
  nameEn          String
  nameMs          String            @default("")
  appliesTo       StandingReasonUse
  governingSource String            @default("")
  provenance      Provenance        @default(ASSUMED)
  sortOrder       Int               @default(0)
  retiredOn       DateTime?
  createdAt       DateTime          @default(now())

  events        StandingEvent[]
  requests      StandingRequest[]
  lapsePolicies SupplierPolicy[]  @relation("LapseReason")

  @@unique([organisationId, code])
}

/// 6.15a (OD-8 A): a blacklisting, or its lifting, asked for and routed on `supplier_blacklist`. The
/// event is recorded from it once its route has approved it.
model StandingRequest {
  id                  String              @id @default(cuid())
  organisationId      String
  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  kind                StandingRequestKind
  reasonId            String?
  reason              StandingReason?     @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonSnapshot      String              @default("")
  /// What the officer wrote, verbatim.
  note                String              @default("")
  /// FR-AWD-009: the cancelled award it was asked for from, where it was.
  sourceAwardId       String?
  sourceAward         Award?              @relation(fields: [sourceAwardId], references: [id], onDelete: Restrict)
  /// The blacklisting a lift asks to end.
  liftsEventId        String?
  liftsEvent          StandingEvent?      @relation("LiftRequest", fields: [liftsEventId], references: [id], onDelete: Restrict)
  requestedByPersonId String
  requestedBy         Person              @relation("StandingRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: Restrict)
  requestedAt         DateTime
  /// 6.15a fix R-7: withdrawn by an officer, with the reason, where it can no longer be recorded (its route
  /// approved it, but the supplier's standing moved on) or is no longer wanted. A withdrawn request no
  /// longer holds the supplier open; it is never recorded. Audited; recorded on their behalf, not signed.
  withdrawnAt         DateTime?
  withdrawnReason     String              @default("")
  withdrawnByPersonId String?
  withdrawnBy         Person?             @relation("StandingWithdrawnBy", fields: [withdrawnByPersonId], references: [id], onDelete: Restrict)

  routes ApprovalInstance[]
  event  StandingEvent?     @relation("RecordedFrom")

  @@index([supplierId])
}

/// 6.15a (FR-VND-010, FR-TRM-017): a supplier's standing, as recorded acts. Append-only. Suspension on
/// lapse is never stored: it is derived on read (OD-7 A).
model StandingEvent {
  id                 String            @id @default(cuid())
  organisationId     String
  organisation       Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  supplierId         String
  supplier           Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  kind               StandingEventKind
  reasonId           String?
  reason             StandingReason?   @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonSnapshot     String            @default("")
  /// The organisation's day it takes effect.
  effectiveOn        DateTime
  /// A first-offence blacklisting's end, exclusive (6.15a fix S-1, as every period in the project): the
  /// day the supplier is free from; its last blacklisted day is the day before. From the policy's months
  /// as they stood. Null: until further notice.
  endsOn             DateTime?
  /// Which blacklisting of this supplier it is (1 is the first offence).
  offenceNo          Int?
  /// The months the period was computed with, frozen.
  periodMonths       Int?
  /// The request (and so the route) a blacklisting or a lift was recorded from.
  requestId          String?           @unique
  request            StandingRequest?  @relation("RecordedFrom", fields: [requestId], references: [id], onDelete: Restrict)
  /// A suspension's documents it was imposed for; a reinstatement needs each verified.
  flaggedDocumentIds String[]
  /// A reinstatement's checklist, as answered: the documents seen verified.
  checklist          Json?
  /// The suspension a reinstatement ends.
  reinstatesEventId  String?           @unique
  reinstatesEvent    StandingEvent?    @relation("Reinstates", fields: [reinstatesEventId], references: [id], onDelete: Restrict)
  reinstatedBy       StandingEvent?    @relation("Reinstates")
  /// The blacklisting a lift ends.
  liftsEventId       String?           @unique
  liftsEvent         StandingEvent?    @relation("Lifts", fields: [liftsEventId], references: [id], onDelete: Restrict)
  liftedBy           StandingEvent?    @relation("Lifts")
  liftRequests       StandingRequest[] @relation("LiftRequest")
  note               String            @default("")
  recordedByPersonId String
  recordedBy         Person            @relation("StandingRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedAt         DateTime
  /// 615-C2 (BD-613-91, ADR 0019 Amendment 1): a registration cancelled is a registration body's fact, recorded with the
  /// body (its label frozen) and the body's reference; CHECK StandingEvent_cancellation_source. Null and empty for every
  /// other kind.
  cancellingBodyId    String?
  cancellingBody      RegistrationBody? @relation(fields: [cancellingBodyId], references: [id], onDelete: Restrict)
  bodyLabelSnapshot   String            @default("")
  externalReference   String            @default("")
  /// 6.13 Part B Run 0 fix round (M-1, BD-613-109): the registration a cancellation cancels, as the supplier's registeredOn
  /// when it was recorded. A new registration moves registeredOn on and so ends it (standing's rule), and a later
  /// cancellation then cancels the new registration: one live cancellation per registration (the partial unique index
  /// StandingEvent_one_live_cancellation). Set on a REGISTRATION_CANCELLED row only (CHECK StandingEvent_cancels_registration).
  cancelsRegistrationOn DateTime?
  /// 615-C2: a cancellation recorded in error, withdrawn with a reason by a named officer; the row is kept and read as
  /// never in effect. Only a REGISTRATION_CANCELLED row, all three together (CHECK StandingEvent_withdrawn).
  withdrawnAt         DateTime?
  withdrawnReason     String            @default("")
  withdrawnByPersonId String?
  withdrawnBy         Person?           @relation("CancellationWithdrawnBy", fields: [withdrawnByPersonId], references: [id], onDelete: Restrict)
  /// The body's notice (REGISTRATION_CANCELLATION_NOTICE), through the document store.
  attachments         DocumentAttachment[]

  @@index([supplierId])
}

/// 6.15a (FR-ADV-017): a special permission for one party on one exercise, relaxing one condition of one
/// registration requirement, only where the exercise's notice offers it. Granted by bodies outside the
/// organisation (recorded) and/or inside it (a route on `special_permission`).
model SpecialPermission {
  id                       String                          @id @default(cuid())
  organisationId           String
  organisation             Organisation                    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exerciseId               String
  exercise                 SourcingExercise                @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  partyId                  String
  party                    ExerciseParty                   @relation(fields: [partyId], references: [id], onDelete: Restrict)
  requirementId            String
  requirement              ExerciseRegistrationRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  requirementLabelSnapshot String
  relaxes                  PermissionRelaxes
  /// Registration bodies outside the organisation that granted it, with their names as they stood.
  grantingBodyIds          String[]
  grantingBodyLabels       String[]
  /// Whether a route inside the organisation must approve it too.
  internalApproval         Boolean
  existingClassConfirmed   Boolean
  goodRecordConfirmed      Boolean
  note                     String                          @default("")
  requestedByPersonId      String
  requestedBy              Person                          @relation("PermissionRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: Restrict)
  requestedAt              DateTime
  /// The organisation's day it was granted. Null: not granted yet.
  grantedOn                DateTime?
  grantedByPersonId        String?
  grantedBy                Person?                         @relation("PermissionGrantedBy", fields: [grantedByPersonId], references: [id], onDelete: Restrict)
  grantedAt                DateTime?

  routes ApprovalInstance[]

  @@index([exerciseId])
  @@index([partyId])
}

// ------------------------------------------------------------------ 6.12 contract formation and baseline

/// Where a baseline value came from (OD-5). ENTERED: keyed at baseline by an officer, not from a tender
/// Appendix, with the provenance the officer chose. DERIVED: computed from other baseline values and a
/// configured policy (the first interim minimum from the builders' works value).
enum BaselineSource {
  APPENDIX
  AWARD
  BQ
  DERIVED
  ENTERED
}

/// Why a baseline version exists (OD-2 A). POSSESSION is written by 6.13's possession act.
enum BaselineReason {
  CONFIRMED
  EXECUTED
  POSSESSION
  CORRECTION
  /// 6.13 Part B run 1b (ADR 0030, ADR 0021 Amendment 2): written only by the EOT certificate's issue hook.
  EXTENSION_OF_TIME
  /// 6.13 Part B run 1b (ADR 0030, ADR 0021 Amendment 2): written only by the period agreement's issue hook.
  PERIOD_EXTENSION
}

enum AssemblyPartState {
  READY
  CANCELLED_BY_ALTERNATIVE
}

/// FR-CON-004: the three comparisons a reconciliation records.
enum ReconciliationComparison {
  TENDER_DOCUMENT
  TENDER_TABLE_DOCUMENT
  DRAWINGS
}

enum ReconciliationOutcome {
  MATCHES
  AMENDED
}

/// FR-CON-005: the four checks; the last two by the basis.
enum FormationCheckKind {
  ARITHMETIC
  FRONT_LOADING
  RATE_UNIFORMITY
  SOR_ADJUSTMENT
}

enum LegalDecision {
  ENDORSED
  RETURNED
}

enum SignatureParty {
  RSAJ
  CONTRACTOR
  WITNESS
}

enum CustodyItemKind {
  CONTRACT
  SECURITY
  POLICY
}

enum CustodyDirection {
  OUT
  IN
}

/// How this customer forms contracts (6.12). One per organisation; every value unset until set, and an
/// unset value refuses the act it governs, naming the setting. Ships empty.
model ContractPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// FR-CON-006: the legal office a contract is reviewed by, as OrgUnit.code. Null refuses submission.
  legalOfficeCode       String?
  /// FR-CON-005: a tendered rate above this multiple of the estimate rate is listed as front-loaded.
  /// Null: no ratio, the officer's judgement only.
  frontLoadingRatio     Decimal? @db.Decimal(9, 4)
  /// FR-CON-012: the words stamped on a controlled copy. Null refuses issuing a copy.
  controlledCopyStampEn String?
  controlledCopyStampMs String?
  /// OD-4 A: the `award_signatory` rows' condition for the contract agreement. Null refuses the RSAJ signature.
  signatoryCond         String?

  provenance Provenance?
  notes      String      @default("")
}

/// A part of the Contract Document for a basis, in its prescribed order (FR-CON-003). The customer's
/// list, as 6.4's part model; ships empty.
model ContractDocumentPart {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  contractBasisCode String
  code              String
  labelEn           String
  labelMs           String?
  printedNumber     String  @default("")

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  @@unique([organisationId, contractBasisCode, code])
}

/// A part of one contract's assembly, copied from configuration when preparation started.
model ContractAssemblyPart {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  partCode           String
  labelSnapshot      String
  labelMsSnapshot    String?
  printedNumber      String            @default("")
  sortOrder          Int               @default(0)
  state              AssemblyPartState @default(READY)
  /// What the accepted alternative proposal cancels, as the document states it. Required when cancelled.
  cancelledStatement String            @default("")

  @@unique([contractId, partCode])
}

/// One of the three comparisons of FR-CON-004, with the tender-stage addenda it took in.
model ContractReconciliation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  comparison        ReconciliationComparison
  outcome           ReconciliationOutcome
  /// The exercise's issued addenda as they stood when recorded (number, title, issued day).
  addendaSnapshot   Json
  checkedByPersonId String
  checkedBy         Person                   @relation("ReconciliationCheckedBy", fields: [checkedByPersonId], references: [id], onDelete: Restrict)
  checkedOn         DateTime
  note              String                   @default("")
  recordedAt        DateTime

  amendments ReconciliationAmendment[]

  @@unique([contractId, comparison])
}

/// An amendment to recorded information, signed by both sides (FR-CON-004), recorded on their behalf.
model ReconciliationAmendment {
  id               String                 @id @default(cuid())
  organisationId   String
  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reconciliationId String
  reconciliation   ContractReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)

  description             String
  contractorSignatoryName String
  contractorSignedOn      DateTime
  officerPersonId         String
  officer                 Person   @relation("AmendmentSignedBy", fields: [officerPersonId], references: [id], onDelete: Restrict)
  officerSignedOn         DateTime
  recordedAt              DateTime
}

/// One of the four checks of FR-CON-005, complete with the officer and the day.
model FormationCheck {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  kind                FormationCheckKind
  completedByPersonId String?
  completedBy         Person?            @relation("FormationCheckBy", fields: [completedByPersonId], references: [id], onDelete: Restrict)
  completedOn         DateTime?
  completedAt         DateTime?
  note                String             @default("")
  /// FRONT_LOADING: the ratio it was judged under, as configured when preparation started. Null: none set.
  ratioSnapshot       Decimal?           @db.Decimal(9, 4)

  corrections ArithmeticCorrection[]
  rates       RateComparison[]

  @@unique([contractId, kind])
}

/// An arithmetical correction (FR-CON-005 a): tendered and corrected; the variance is their difference.
model ArithmeticCorrection {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  checkId        String
  check          FormationCheck @relation(fields: [checkId], references: [id], onDelete: Restrict)

  itemRef     String
  description String   @default("")
  tendered    Decimal  @db.Decimal(18, 2)
  corrected   Decimal  @db.Decimal(18, 2)
  reason      String
  recordedAt  DateTime
}

/// A tendered rate set against the estimate rate (FR-CON-005 b). The estimate rate is SULIT.
model RateComparison {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  checkId        String
  check          FormationCheck @relation(fields: [checkId], references: [id], onDelete: Restrict)

  itemRef      String
  description  String   @default("")
  provisional  Boolean  @default(false)
  tenderedRate Decimal  @db.Decimal(18, 2)
  estimateRate Decimal  @db.Decimal(18, 2)
  recordedAt   DateTime
}

/// One iteration of legal review (FR-CON-006): submitted with the versions it went with, then endorsed
/// or returned with comments. No limit and no timeout.
model LegalReview {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  iteration           Int
  officeCode          String
  officeLabel         String
  submittedAt         DateTime
  submittedOn         DateTime
  submittedByPersonId String
  submittedBy         Person   @relation("LegalSubmittedBy", fields: [submittedByPersonId], references: [id], onDelete: Restrict)
  /// The LEGAL_SUBMISSION versions live at submission: id, document title, version number, sha256.
  pinnedVersions      Json

  decision         LegalDecision?
  decidedOn        DateTime?
  decidedAt        DateTime?
  reviewerPersonId String?
  reviewer         Person?        @relation("LegalReviewedBy", fields: [reviewerPersonId], references: [id], onDelete: Restrict)
  comments         String         @default("")

  @@unique([contractId, iteration])
}

/// A signature on the Contract Document, recorded on the signer's behalf, not signed (no sign-in).
model ContractSignature {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  party        SignatureParty
  /// RSAJ: the officer who signs. The contractor's signatory and the witness are not Persons.
  personId     String?
  person       Person?        @relation("ContractSignedBy", fields: [personId], references: [id], onDelete: Restrict)
  name         String
  /// Held in full; shown masked everywhere but the Signing section's own field (6.11 R20).
  icNumber     String         @default("")
  capacity     String         @default("")
  signedOn     DateTime
  recordedAt   DateTime
  // RSAJ: who the matrix resolved, as resolved at the act.
  roleCode     String?
  roleLabel    String?
  ruleKey      String?
  ruleLabel    String?
  delegationId String?
  delegation   Delegation?    @relation("ContractSignatureDelegation", fields: [delegationId], references: [id], onDelete: Restrict)

  @@unique([contractId, party])
}

/// The Integrity Pact Stage Three briefing at signing (FR-CON-010).
model IntegrityBriefing {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String       @unique
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  heldOn              DateTime
  /// RSAJ's participants, as Person ids with their names as recorded.
  participantIds      String[]
  participantNames    String[]
  /// The contractor's attendees, by name (not Persons).
  contractorAttendees String[]
  note                String   @default("")
  recordedAt          DateTime
}

/// The contract baseline (FR-CON-014, ADR 0021). The draft (version null) is built when preparation
/// starts; a version is confirmed before the first valuation (CONFIRMED), re-versioned at execution with
/// only the Contract Date added (EXECUTED), and any other change is a CORRECTION version with a reason.
/// Versions are never updated. Every later calculation reads a pinned version through `baselineFor`.
model ContractBaseline {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  version          Int?
  reason           BaselineReason?
  correctionReason String          @default("")
  /// The server's clock when the version was recorded, and the organisation's day it fell on.
  recordedAt       DateTime?
  recordedOn       DateTime?

  contractSum       Decimal    @db.Decimal(18, 2)
  contractDate      DateTime?
  possessionDate    DateTime?
  completionPeriod  Int
  completionUnit    PeriodUnit
  dateForCompletion DateTime?

  dlpApplies Boolean?
  dlpMonths  Int?
  dlpSource  BaselineSource?

  ladKind   LadKind?
  ladAmount Decimal?        @db.Decimal(18, 2)
  ladPct    Decimal?        @db.Decimal(9, 6)
  ladUnit   String          @default("")
  ladDaily  Decimal?        @db.Decimal(18, 2)
  ladSource BaselineSource?

  retentionApplies    Boolean?
  retentionPercent    Decimal?        @db.Decimal(9, 4)
  retentionCapPercent Decimal?        @db.Decimal(9, 4)
  retentionSource     BaselineSource?

  pcSums             Decimal?        @db.Decimal(18, 2)
  provisionalSums    Decimal?        @db.Decimal(18, 2)
  sumsSource         BaselineSource?
  buildersWorksValue Decimal?        @db.Decimal(18, 2)

  firstInterimMinimum      Decimal?        @db.Decimal(18, 2)
  firstInterimSource       BaselineSource?
  subsequentInterimMinimum Decimal?        @db.Decimal(18, 2)
  subsequentInterimSource  BaselineSource?
  honourCertificateDays    Int?
  honourSource             BaselineSource?

  unfixedMaterialsPct Decimal? @db.Decimal(9, 4)
  onCostPct           Decimal? @db.Decimal(9, 4)
  designWorkValue     Decimal? @db.Decimal(18, 2)

  sectionalCompletion Boolean?
  sectionalSource     BaselineSource?

  /// 6.13 Part B run 1b (ADR 0030, flagged against 6.12): the days extensions of time (and of the contract period) have
  /// added to the whole works' date for completion, so a later correction that derives the date again from possession
  /// and the period keeps them. 0 on every version before an extension: none had been granted (a fact, not a policy).
  extensionDays       Int             @default(0)

  /// Per entered field: the provenance the officer chose (OD-5, no default) and a note.
  entered  Json
  /// Every policy value it was built under, with provenance (the band, the type's behaviours, the
  /// Appendix's pack version, the interim-minimum policy).
  snapshot Json

  sections ContractSection[]
  /// 6.14: the certificates that read this version (ADR 0021 §3).
  certificates Certificate[]
  /// 612-C1: the correction of the award's recorded terms that wrote this version.
  awardTermCorrection AwardTermCorrection?
  /// 6.13 (FR-SUP-005): the possession of site that wrote this version.
  possession          Possession?
  /// 6.13 Part B run 1b (ADR 0030): the extension of time or period agreement whose issue wrote this version.
  extensionOfTime     ExtensionOfTime? @relation("ExtensionOfTimeVersion")
  periodAgreement     PeriodAgreement? @relation("PeriodAgreementVersion")

  @@unique([contractId, version])
  @@index([contractId])
}

/// A section for sectional completion, with its own LAD, copied with each baseline version.
model ContractSection {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  baselineId     String
  baseline       ContractBaseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)

  ref         String
  description String
  ladKind     LadKind?
  ladAmount   Decimal? @db.Decimal(18, 2)
  ladPct      Decimal? @db.Decimal(9, 6)
  ladDaily    Decimal? @db.Decimal(18, 2)
  /// 6.13 Part B run 1b (ADR 0030): the days an extension of time on this section alone added to its date for
  /// completion (the whole works' date plus these). 0 before any.
  extensionDays Int      @default(0)
  sortOrder   Int      @default(0)

  certificates Certificate[]
}

/// A term of the Letter of Acceptance a baseline reads, as the award records it (612-C1).
enum AwardTerm {
  LAD
  DLP
  RETENTION
  COMPLETION
}

/// 612-C1 (6.13 Part A step 0, flagged against 6.11; ADR 0021 Amendment 1): the award's recorded terms corrected
/// after issue, where one was recorded wrongly from the signed letter. Append-only. The issued letter, earlier
/// baseline versions and the certificates pinned to them are never touched: the correction writes a CORRECTION
/// version whose source stays AWARD, shown "corrected from …". A change to the terms themselves is a variation.
model AwardTermCorrection {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  awardId        String
  award          Award        @relation(fields: [awardId], references: [id], onDelete: Restrict)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  term       AwardTerm
  /// The term's columns on the award before and after, money and percentages as decimal strings.
  before     Json
  after      Json
  /// Both in words, as recorded (the screen and the trail read these).
  beforeText String
  afterText  String
  reason     String
  /// The CORRECTION version it wrote.
  baselineId String           @unique
  baseline   ContractBaseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  recordedAt DateTime
  recordedOn DateTime

  @@index([awardId])
  @@index([contractId])
}

/// Who receives a controlled copy of an executed contract (FR-CON-012). The customer's list; ships empty.
model ControlledCopyRecipient {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code                       String
  nameEn                     String
  nameMs                     String?
  /// What the recipient receives ("one original with drawings and a PDF").
  copyForm                   String  @default("")
  mandatory                  Boolean @default(true)
  /// Only where a consulting engineer is engaged on the contract.
  onlyWithConsultingEngineer Boolean @default(false)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  copies IssuedCopy[]

  @@unique([organisationId, code])
}

/// A numbered controlled copy and how it went (FR-CON-012). Its owner is a contract or (6.14, FR-CRT-006) a
/// certificate: exactly one owner, a CHECK built by hand. Recalled copies stay; a reissue is a new number.
model IssuedCopy {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       Contract?    @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// 6.14 (FR-CRT-006): a certificate's addressed copy, from its pinned distribution list. The row's code
  /// and flags as pinned; all four null on a contract's copy (CHECK).
  certificateId    String?
  certificate      Certificate? @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  distributionCode String?
  mandatory        Boolean?
  ackRequired      Boolean?
  isOriginal       Boolean?

  copyNo         Int
  recipientId    String?
  recipient      ControlledCopyRecipient? @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  recipientName  String
  copyForm       String                   @default("")
  addressedTo    String                   @default("")
  /// The stamp's words as configured when the copy was issued.
  stampText      String
  method         DeliveryMethod?
  despatchedOn   DateTime?
  acknowledgedOn DateTime?
  recordedAt     DateTime
  recalledOn     DateTime?
  recallReason   String                   @default("")
  reissueOfId    String?                  @unique
  reissueOf      IssuedCopy?              @relation("CopyReissue", fields: [reissueOfId], references: [id], onDelete: Restrict)
  reissuedAs     IssuedCopy?              @relation("CopyReissue")

  @@unique([contractId, copyNo])
  @@unique([certificateId, copyNo])
}

/// A physical original in custody (FR-CON-013): the contract, a security or a policy. CHECK: the kind
/// names exactly its own key.
model CustodyItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  kind       CustodyItemKind
  securityId String?             @unique
  security   SecurityInstrument? @relation(fields: [securityId], references: [id], onDelete: Restrict)
  policyId   String?             @unique
  policy     InsurancePolicy?    @relation(fields: [policyId], references: [id], onDelete: Restrict)

  location          String
  custodianPersonId String
  custodian         Person   @relation("CustodyHeldBy", fields: [custodianPersonId], references: [id], onDelete: Restrict)
  recordedAt        DateTime

  movements CustodyMovement[]
}

/// A check-out or check-in of an original (FR-CON-013). Append-only.
model CustodyMovement {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  itemId         String
  item           CustodyItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  direction  CustodyDirection
  personId   String
  person     Person           @relation("CustodyMovedBy", fields: [personId], references: [id], onDelete: Restrict)
  on         DateTime
  purpose    String           @default("")
  recordedAt DateTime
}

// ------------------------------------------------------------------ 6.14 certificates (increment 1, ADR 0022, 0023)

/// 6.14 (FR-CRT, ADR 0022): what a certificate is. A closed product vocabulary (BD-DS-4 precedent), rendered by label.
/// Increment 1 ships 6.13 Part A's kinds; each later kind arrives in its own migration before use (X-6).
enum CertificateKind {
  DELEGATION_LETTER
  DELEGATION_NOTICE
  INTERIM_PAYMENT
  ADVANCE_PAYMENT
  LAD_WARNING
  NON_COMPLETION
  VARIATION_APPLICATION
  SO_INSTRUCTION
  VARIATION
  SUM_ADJUSTMENT
  /// 6.13 Part B (intake 2): each added in its own migration.
  EOT
  CONTRACT_PERIOD_AGREEMENT
  PARTIAL_OCCUPATION
  PRACTICAL_COMPLETION
  SCHEDULE_OF_DEFECTS
  MAKING_GOOD_DEFECTS
  TERMINATION_INTENT
  TERMINATION
  TERMINATED_FINAL
  NOMINATION_LETTER
  FINAL
}

/// Where a certificate stands (ADR 0022). VOID only before ISSUED; an issued certificate is corrected by a later one.
enum CertificateStatus {
  DRAFT
  IN_ROUTING
  SIGNING
  ISSUED
  VOID
}

/// What a printed signature block is for (FR-CRT-004).
enum SignatureBlockKind {
  RECOMMENDING
  AUTHORISING
  CONTRACTOR
  WITNESS
  APPLICANT
  SUPPORTING
}

/// Who may sign a block. SO, SO_REP and RECOMMENDING_OFFICER are resolved by the contract's supervision
/// (6.13 FR-SUP-001); NAMED_OFFICE by an office on the roster; the rest are people outside the organisation.
enum SignatureOfficeRule {
  SO
  SO_REP
  RECOMMENDING_OFFICER
  CONTRACTOR
  WITNESS
  NAMED_OFFICE
}

/// A recommending block's answer, where the block carries one (DISOKONG / TIDAK DISOKONG).
enum SignatureDecision {
  SUPPORTED
  NOT_SUPPORTED
}

/// When a distribution row applies to a contract (FR-CRT-006).
enum DistributionCondition {
  NONE
  GUARANTOR_EXISTS
  CONSULTANT_ENGAGED
}

/// An internal step on a routing sheet before the approval matrix's own (FR-CRT-007).
enum RoutingCheckKind {
  CHECKED
  VERIFIED
  ENDORSED
}

/// What a routing sheet type is drawn over: a certificate's route, or an award's appointment route (the
/// pre-award sheet, rulings 6.14 condition).
enum RoutingSubject {
  CERTIFICATE
  AWARD
}

/// One certificate of a contract (ADR 0022). Domain records (6.13) own their content and point here by
/// `certificateId @unique`; this record owns the shared life: the frozen figures, the routing sheet, the
/// signatures in printed order, the date from the authorising signature, the number and distribution.
model Certificate {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  kind     CertificateKind
  /// From the `certificate` series at issue; null before. Unique per organisation.
  number   String?
  /// The per-contract ordinal of its kind ("interim certificate 3"), allocated at issue under the contract
  /// lock. A voided draft never had one, so voiding consumes nothing.
  sequence Int?
  status   CertificateStatus @default(DRAFT)

  /// Sectional completion: the section of the pinned baseline version it concerns.
  sectionId String?
  section   ContractSection? @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  /// The form it prints on, chosen by the module that raised it; its revision (blocks and distribution)
  /// is pinned at the first signature (OD-2 A) and never moves afterwards.
  templateId       String?
  template         DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateRevision Json?
  pinnedAt         DateTime?

  /// The baseline version it read (ADR 0021 §3), through `baselineFor`. Never re-read live.
  baselineId String
  baseline   ContractBaseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)

  /// The figures as the owning module computed them, money as decimal strings (FR-CRT-003).
  computedSnapshot Json?

  /// FR-CRT-005: the organisation's day of the authorising block's recorded act. Never a form field.
  certificateDate              DateTime?
  certificateDateCorrectedFrom DateTime?
  certificateDateCorrectionReason String  @default("")

  /// The routing sheet (FR-CRT-007, ADR 0023): its type, frozen when sent for routing, and DATE (1).
  routingTypeId             String?
  routingType               RoutingSheetType? @relation(fields: [routingTypeId], references: [id], onDelete: Restrict)
  routingSnapshot           Json?
  routingReceivedOn         DateTime?
  routingReceivedRecordedAt DateTime?

  /// When it was opened (the server's clock) and the organisation's day.
  openedAt DateTime
  openedOn DateTime

  voidReason String    @default("")
  voidedAt   DateTime?
  issuedAt      DateTime?
  /// Everything the issue was judged under: the pinned revision, the signatures, the figures with any
  /// override, the baseline version and the copies resolved. Rendered from, never re-derived.
  issueSnapshot Json?

  signatures        CertificateSignature[]
  overrides         CertificateOverride[]
  documents         CertificateDocument[]
  copies            IssuedCopy[]
  approvalInstances ApprovalInstance[]
  routingChecks     RoutingCheck[]
  /// 6.13 (FR-SUP-003): the delegation this certificate is the letter, or the notification, of.
  delegationAsLetter SoDelegation? @relation("DelegationLetter")
  delegationAsNotice SoDelegation? @relation("DelegationNotice")
  /// 6.13 Part A step 3 (4c): the record this certificate is the certificate of.
  interimValuation   InterimValuation?
  advancePayment     AdvancePayment?
  ladWarning         LadWarning?
  nonCompletion      NonCompletion?
  financePayment     FinancePayment?
  retentionReleasesRead RetentionRelease[]
  /// 6.13 Part A step 4 (4d): the variation record this certificate is the application, instruction or order of,
  /// and the adjustment of the contract sum it certifies.
  variationApplication  Variation?            @relation("VariationApplication")
  variationInstruction  VariationInstruction?
  variationCertificate  VariationCertificate?
  sumAdjustment         SumAdjustment?
  /// 6.13 Part B run 1b: the extension of time or period agreement this certificate is the certificate of, and the
  /// LAD waiver applied on it.
  extensionOfTime       ExtensionOfTime?
  periodAgreement       PeriodAgreement?
  ladWaiverApplied      LadWaiver?            @relation("LadWaiverAppliedOn")

  @@unique([organisationId, number])
  @@unique([contractId, kind, sequence])
  @@index([contractId])
}

/// One signature block recorded on a certificate, in printed order (FR-CRT-004). Recorded on behalf of,
/// not signed. The office is as resolved on the day (§7.2: the historical holder is kept).
model CertificateSignature {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificateId  String
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  blockOrder Int
  blockKind  SignatureBlockKind
  /// The block's label as pinned.
  blockLabel String
  personId   String?
  person     Person?            @relation("CertificateSignedBy", fields: [personId], references: [id], onDelete: Restrict)
  name       String
  officeCode  String?
  officeLabel String?
  delegationId String?
  delegation   Delegation?      @relation("CertificateSignatureDelegation", fields: [delegationId], references: [id], onDelete: Restrict)
  /// Only the masked number is kept (6.11 R20).
  icMasked    String?
  decision    SignatureDecision?
  decisionCap Decimal?          @db.Decimal(18, 2)
  /// The contractor refused to sign (FR-VAR-022), where the block allows it: recorded, and it does not block.
  refused     Boolean           @default(false)
  refusalNote String            @default("")
  signedOn    DateTime
  recordedAt  DateTime

  @@unique([certificateId, blockOrder])
}

/// A computed figure overridden in DRAFT, with its justification and the named Person (FR-CRT-003).
/// Append-only: the latest per field applies; both figures are kept. Totals are never overridden.
model CertificateOverride {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificateId  String
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  fieldKey      String
  /// Both as written in the snapshot (money as a decimal string).
  computed      String
  overridden    String
  justification String
  personId      String
  person        Person   @relation("CertificateOverriddenBy", fields: [personId], references: [id], onDelete: Restrict)
  personName    String
  recordedAt    DateTime

  @@index([certificateId])
}

/// The certificate's text, frozen at issue (ADR 0008), one per language the pinned form has a text in.
model CertificateDocument {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificateId  String
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  templateId           String
  template             DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateCode         String
  templateName         String
  templateFormCode     String           @default("")
  templateRevisionDate DateTime?
  templateBodyVersion  Int
  language             DocumentLanguage
  version              Int              @default(1)
  fields               Json
  renderedText         String           @db.Text
  frozenAt             DateTime

  @@unique([certificateId, language, version])
}

/// A form's signature block, in printed order (FR-CRT-001, 004). The customer's; ships empty.
model FormSignatureBlock {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  templateId     String
  template       DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  blockOrder       Int
  blockKind        SignatureBlockKind
  labelEn          String
  labelMs          String?
  /// FR-CRT-005: this block's act dates the certificate. At most one per form.
  datesCertificate Boolean             @default(false)
  officeRule       SignatureOfficeRule
  /// The office, where the rule is NAMED_OFFICE.
  officeCode       String?
  /// Whether a delegate of the office may sign. Null: not decided, and nobody signs on it.
  delegable        Boolean?
  /// The block carries a supported / not supported answer.
  carriesDecision  Boolean             @default(false)
  /// The contractor may refuse to sign it, and the refusal is recorded (FR-VAR-022).
  refusalAllowed   Boolean             @default(false)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")

  @@unique([templateId, blockOrder])
}

/// A form's distribution list (FR-CRT-006). The customer's; ships empty (OD-5 A).
model FormDistribution {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  templateId     String
  template       DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  recipientCode String
  labelEn       String
  labelMs       String?
  mandatory     Boolean
  ackRequired   Boolean
  condition     DistributionCondition
  isOriginal    Boolean
  sortOrder     Int                   @default(0)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")

  @@unique([templateId, recipientCode])
}

/// A kind of routing sheet (FR-CRT-007, ADR 0023): a tenth sheet is a row. The customer's; ships empty.
model RoutingSheetType {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code            String
  labelEn         String
  labelMs         String?
  subject         RoutingSubject
  /// The certificate kind it serves; null with subject CERTIFICATE: any kind.
  certificateKind CertificateKind?
  /// The printed sheet.
  templateId      String?
  template        DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Which side of a percentage band's edge a value exactly on it falls (ADR 0024): true, the band it
  /// closes (min, max]; false, the band it opens [min, max). Null: not decided, and a value exactly on
  /// an edge reads "target not set".
  upperEdgeInclusive Boolean?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
  sortOrder  Int        @default(0)
  retiredOn  DateTime?

  checks       RoutingCheckDef[]
  targets      RoutingTarget[]
  certificates Certificate[]
  awardSheets  AwardRoutingSheet[]
  /// 6.13 Part A step 3: the certificate kinds sent on it.
  kindSettings CertificateKindSetting[]

  @@unique([organisationId, code])
}

/// An internal step of a routing sheet type, in order, with its own printed days where the form prints them.
model RoutingCheckDef {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  typeId         String
  type           RoutingSheetType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  order      Int
  kind       RoutingCheckKind
  labelEn    String
  labelMs    String?
  /// The office that records it. Null: any officer, shown so.
  officeCode String?
  /// This stage's printed days (a part of the total), where the form prints them.
  targetDays Int?

  @@unique([typeId, order])
}

/// The ICC target of a routing sheet type, optionally banded by percentage (min, max] or [min, max) as the
/// type's switch says (FR-CRT-008). The customer's; ships empty.
model RoutingTarget {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  typeId         String
  type           RoutingSheetType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  pctMin     Decimal? @db.Decimal(9, 4)
  pctMax     Decimal? @db.Decimal(9, 4)
  targetDays Int

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")
}

/// An internal check recorded on a routing sheet, in an iteration (FR-CRT-007, 009). The definition is
/// read from the type as frozen when the sheet started. Recorded on behalf of, not signed.
model RoutingCheck {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificateId  String?
  certificate    Certificate? @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  /// The pre-award sheet's checks (rulings 6.14 condition).
  awardId        String?
  award          Award?       @relation(fields: [awardId], references: [id], onDelete: Restrict)

  iteration  Int
  defOrder   Int
  kind       RoutingCheckKind
  label      String
  personId   String
  person     Person   @relation("RoutingCheckedBy", fields: [personId], references: [id], onDelete: Restrict)
  personName String
  on         DateTime
  note       String   @default("")
  recordedAt DateTime

  @@unique([certificateId, iteration, defOrder])
  @@unique([awardId, iteration, defOrder])
}

/// The pre-award routing sheet's header on an award (rulings 6.14 condition, ADR 0023): its type, frozen when
/// the sheet starts, and DATE (1). Its steps are the award's own appointment route; nothing here copies a decision.
model AwardRoutingSheet {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  awardId        String           @unique
  award          Award            @relation(fields: [awardId], references: [id], onDelete: Restrict)
  typeId         String
  type           RoutingSheetType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// The type, its checks and its targets as they stood when the sheet started.
  typeSnapshot   Json
  startedAt      DateTime
  receivedOn         DateTime?
  receivedRecordedAt DateTime?
}

// ------------------------------------------------------------------ 6.14 increment 2: printed-form fidelity, corrections, terms

/// A field of a printed form (FR-CRT-001, 002): the form's own label pair, and either the value the system fills it
/// with (bound: never an input on any screen) or nothing (printed blank, completed by hand on the paper). The
/// customer's; ships empty. Pinned with the form at a certificate's first signature (OD-2 A); a routing sheet freezes
/// its printed form's labels when it starts. CHECK: bound exactly when it names a value.
model FormField {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  templateId     String
  template       DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  key         String
  labelEn     String
  labelMs     String?
  bound       Boolean
  /// The value a bound field prints: a certificate's bound field or its routing sheet's (printed.ts).
  computedKey String?
  sortOrder   Int     @default(0)

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")

  @@unique([templateId, key])
}

/// A typing error in a controlled form, corrected when a certificate's text is rendered, the form code and revision
/// unchanged (FR-CRT-010). The customer's document-control decision; ships empty. Applies only to the forms it names.
model TextCorrection {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  fromText String
  toText   String

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")

  forms TextCorrectionForm[]

  @@index([organisationId])
}

/// A form a correction applies to.
model TextCorrectionForm {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  correctionId   String
  correction     TextCorrection   @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  templateId     String
  template       DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([correctionId, templateId])
  @@index([templateId])
}

/// One concept's canonical wording (FR-CRT-011): a form cites it as {{term:code}} and prints the wording in its
/// language. The customer's glossary; ships empty. CHECK: at least one wording.
model Term {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code        String
  canonicalEn String?
  canonicalMs String?

  provenance Provenance @default(ASSUMED)
  notes      String     @default("")

  aliases TermAlias[]

  @@unique([organisationId, code])
}

/// Another wording of a term the source documents use, kept for search (FR-CRT-011): a search for either finds both.
model TermAlias {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  termId         String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)

  alias String

  @@unique([termId, alias])
}

// ------------------------------------------------------------------ 6.13 Part A: supervision (4b, FR-SUP)

/// Why an S.O. assignment row exists (FR-SUP-001, §7.2: every holder kept).
enum SoAssignmentReason {
  /// Resolved by the employer's signature (the execution hook).
  EXECUTION
  /// Resolved by the one-off act, for a contract executed before 6.13.
  RESOLVED
  /// Re-resolved after the revised contract sum crossed a band (OD-A7, where the switch says so).
  RE_RESOLVED
}

/// FR-SUP-003: the delegate's type, which drives the delegation's scope.
enum DelegateKind {
  PRINCIPAL
  SPECIALIST
  SPECIALIST_QS
}

/// An act a delegate may be recorded for (FR-SUP-004): the delegation's scope lists them.
enum SupervisionAct {
  DIARY
  PROGRAMME_SCRUTINY
  PROGRESS
  OBSERVATION
  CONTRACTOR_COMMUNICATION
  INSTRUCTION
  VALUATION
  VARIATION_APPLICATION
}

/// FR-SUP-006: a works programme, or an annual contract's service and maintenance implementation schedule.
enum ProgrammeKind {
  WORK_PROGRAMME
  SERVICE_SCHEDULE
}

/// FR-SUP-006: the Principal S.O. Representative's decision on a submitted programme.
enum ProgrammeDecision {
  APPROVED
  RETURNED
}

/// FR-SUP-008: who endorses the diary at a site visit.
enum DiaryEndorser {
  SUPERIOR_OFFICER
  SUPERINTENDING_OFFICER
}

/// FR-SUP-014: what a compliance observation is about.
enum ComplianceArea {
  MATERIAL_QUALITY
  WORKMANSHIP
  AUTHORITY_COMPLIANCE
  WORKER_WELFARE
  SAFETY
  INSURANCE
  WAGES
  OSHA
}

/// FR-SUP-012: what calls for a revised programme.
enum DirectionCause {
  VARIATION
  LOCAL_AUTHORITY_DELAY
  OTHER_DELAY
}

/// A deduction waiting for the next interim certificate (FR-SUP-013).
enum PendingDeductionKind {
  INSURANCE_PREMIUM
}

/// FR-SUP-015: the S.O.'s early action, a branch of each.
enum EarlyActionBranch {
  EXTEND_TIME
  IMPOSE_LAD
  TERMINATE
}

/// B1 (OD-A8 A, ADR 0025): a party paid through the contract's certificates.
enum ContractPartyKind {
  NOMINATED_SUBCONTRACTOR
  NOMINATED_SUPPLIER
  ASSIGNEE
}

/// FR-SUP-009: a controlled set of site records handed over.
enum SiteRecordsSet {
  PIPE_LOG
  AS_BUILT
}

/// How this customer administers contracts after award (6.13). One per organisation; every value unset until
/// set, each with where it came from; an unset value refuses or warns at the act it governs, naming the setting.
/// Ships empty. Later steps add their own columns (payment, variations).
model PostAwardPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// FR-SUP-010: a contract is In Delay where actual progress is below this percentage of the approved
  /// programme's planned progress. Null: not set, and In Delay reads "not judged" (NOT_SET).
  inDelayProgressPct        Decimal?    @db.Decimal(9, 4)
  inDelayProvenance         Provenance?
  /// OD-A7: whether the S.O. is re-resolved when an issued adjustment moves the contract sum across a band.
  /// Null: not decided, and the contract and each later S.O. block warn.
  soReResolve               Boolean?
  soReResolveProvenance     Provenance?
  /// FR-SUP-003: the forms the delegation letter (A/1, B/1) and its notification (A/2, B/2) print on, per variant.
  /// Null: not set, and a delegation of that variant is refused naming the setting.
  delegationLetterConventionalId String?
  delegationLetterConventional   DocumentTemplate? @relation("PolicyDelegationLetterConventional", fields: [delegationLetterConventionalId], references: [id], onDelete: SetNull)
  delegationNoticeConventionalId String?
  delegationNoticeConventional   DocumentTemplate? @relation("PolicyDelegationNoticeConventional", fields: [delegationNoticeConventionalId], references: [id], onDelete: SetNull)
  delegationLetterDesignBuildId  String?
  delegationLetterDesignBuild    DocumentTemplate? @relation("PolicyDelegationLetterDesignBuild", fields: [delegationLetterDesignBuildId], references: [id], onDelete: SetNull)
  delegationNoticeDesignBuildId  String?
  delegationNoticeDesignBuild    DocumentTemplate? @relation("PolicyDelegationNoticeDesignBuild", fields: [delegationNoticeDesignBuildId], references: [id], onDelete: SetNull)
  delegationFormsProvenance      Provenance?

  /// 6.13 Part A step 3 (4c). FR-PAY-007 and the 75% ruling: the organisation's default allowance on unfixed
  /// materials, where a contract's baseline states none. The product ships none (the spec's 75% is a customer seed);
  /// unset refuses a materials line, never 0%.
  unfixedMaterialsDefaultPct  Decimal?            @db.Decimal(9, 4)
  unfixedMaterialsProvenance  Provenance?
  /// FR-PAY-021: the share of the retention released on as-built drawings. Unset refuses the first release.
  firstReleasePct             Decimal?            @db.Decimal(9, 4)
  firstReleaseProvenance      Provenance?
  /// OD-A6: the figure an interim certificate is routed on. Unset refuses its submission.
  paymentRouteFigure          PaymentRouteFigure?
  paymentRouteProvenance      Provenance?
  /// OD-A4: where the sen a pro-rata split leaves over go. Unset refuses a split that leaves any.
  waterfallRemainder          WaterfallRemainder?
  waterfallProvenance         Provenance?
  /// FR-PAY-014: how many interim certificates may issue before the contract is signed (the spec's "1 to 3").
  /// Unset refuses every certificate before execution.
  preExecutionInterimLimit    Int?
  preExecutionProvenance      Provenance?

  /// 6.13 Part A step 4 (4d). OD-A2: what a variation's percentage is of (this variation alone, or every approved
  /// variation to date with it), and the sum it is taken over (the original contract sum, or the revised sum: the
  /// original plus the issued adjustments), which is also the contract value its band is read at. Unset refuses
  /// sending a variation for approval, naming the setting.
  variationPctBasis           VariationPctBasis?
  variationBase               VariationBase?
  variationProvenance         Provenance?
  /// OD-A5 (FR-VAR-007): the schedule form a variation produces where an agreed rate exists, and where none does.
  /// Unset: the variation's schedule form is "not set", and its instruction is refused naming the setting.
  scheduleFormAgreedRate      VariationScheduleForm?
  scheduleFormNoAgreedRate    VariationScheduleForm?
  scheduleFormProvenance      Provenance?
  /// FR-VAR-009: the committee whose quorate decision (agree or disagree, per member) is the funder's consent to a
  /// variation affecting a funder's assets. Unset: such a variation's consent cannot be tabled, naming the setting.
  funderConsentCommitteeId    String?
  funderConsentCommittee      Committee?          @relation(fields: [funderConsentCommitteeId], references: [id], onDelete: SetNull)
  funderConsentProvenance     Provenance?

  /// 6.13 Part B run 1a (B4; Rule 1, BD-613-102): Part B's settings, each nullable and shipped unset with its
  /// provenance; the spec's figures are test fixtures and a go-live seed, never a default. Unset refuses (or, for an
  /// advisory, says "Not set") only the act that needs it, naming the setting. Read by runs 1b to 5.
  /// FR-LAD-012 (S): the accrual alert's day count. Null: "Not set", no alert, never 0.
  ladAntiOppressionDays       Int?
  ladAntiOppressionProvenance Provenance?
  /// FR-EOT-005: the guidance shown on a weather claim. Null: none shown, and the screen says it is not set.
  weatherGuidance             String?
  weatherGuidanceProvenance   Provenance?
  /// OD-B7 (BD-613-75): when an approved LAD waiver reaches the money. Null: approved, not applied.
  ladWaiverApplication        LadWaiverApplication?
  ladWaiverProvenance         Provenance?
  /// FR-CMP-017 (§8.10): the design guarantee bond's rate on the design work's value, and its years from practical
  /// completion. Either null: NOT_SET (never 5% or five years). Each has its own provenance (BD-613-124).
  designBondPct               Decimal?            @db.Decimal(9, 4)
  designBondPctProvenance     Provenance?
  designBondYears             Int?
  designBondYearsProvenance   Provenance?
  /// OD-B8 (BD-613-76): when the performance bond and the retention balance are released. Null refuses the release,
  /// naming the setting. Each switch has its own provenance (Run 1a fix round, review S7).
  performanceBondReleaseAt    ReleaseEvent?
  performanceBondReleaseProvenance Provenance?
  retentionBalanceReleaseAt   ReleaseEvent?
  retentionBalanceReleaseProvenance Provenance?
  /// FR-NSC (§8.10): the nominated party's bond rate (null: NOT_SET), the quotation route's ceiling for a nominated
  /// package (null: NOT_SET, never RM300,000), and OD-B19: one form for the nomination letters, or one per letter.
  /// Each has its own provenance (review S7).
  nominatedBondPct            Decimal?            @db.Decimal(9, 4)
  nominatedBondProvenance     Provenance?
  nominatedQuotationCeiling   Decimal?            @db.Decimal(18, 2)
  nominatedQuotationCeilingProvenance Provenance?
  nominationLetterForms       NominationLetterForms?
  nominationLetterFormsProvenance Provenance?
  /// §8.9 (FR-TRM-011–016): the re-tender cap in days (null blocks the terminated account) and OD-B2's composition of
  /// the cost-of-loss days (null blocks it; both readings shown). Each has its own provenance (BD-613-124): the cap is
  /// §8.9's, the composition a customer's undecided choice.
  retenderCapDays             Int?
  retenderCapProvenance       Provenance?
  lossDaysComposition         LossDaysComposition?
  lossDaysCompositionProvenance Provenance?
  /// OD-B9 (BD-613-77): what the final account's previous interim payments are. Null refuses the final account.
  finalPreviousBasis          FinalPreviousBasis?
  finalAccountProvenance      Provenance?

  notes String @default("")
}

/// OD-B7: when an approved LAD waiver is applied (the next certificate, or the final account).
enum LadWaiverApplication {
  NEXT_CERTIFICATE
  FINAL_ACCOUNT
}

/// OD-B8: the event at which a security or the retention balance is released.
enum ReleaseEvent {
  MAKING_GOOD
  FINAL_PAYMENT
}

/// OD-B19: the SK010 nomination letter set printed on one form, or one per letter.
enum NominationLetterForms {
  ONE_FORM
  PER_LETTER
}

/// OD-B2: the cost-of-loss days: the capped re-tender days plus the new contract period, or the days to the new
/// completion with the cap applied only where the re-tender exceeds it.
enum LossDaysComposition {
  CAPPED_RETENDER_PLUS_PERIOD
  DAYS_TO_NEW_COMPLETION
}

/// OD-B9: the final account's previous interim payments, before their deductions or as paid.
enum FinalPreviousBasis {
  BEFORE_DEDUCTIONS
  AS_PAID
}

/// FR-MTD-012, FR-EOT-011: which time instrument a contract type offers.
enum EotInstrumentKind {
  EXTENSION_OF_TIME
  CONTRACT_PERIOD
  BOTH
}

/// FR-CMP-006: which practical completion certificate a contract type takes.
enum CompletionVariant {
  STANDARD
  IT
}

/// The Superintending Officer of a contract (FR-SUP-001): an office resolved from the approval matrix's
/// `superintending_officer` rows by contract value and regime, never keyed. Append-only (§7.2): the office in
/// force on a day is the latest row effective on or before it; every earlier holder is kept.
model ContractSoAssignment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  roleCode      String
  roleLabel     String
  reason        SoAssignmentReason
  /// What it was resolved on, as it stood: the issue, the rule and its clause, the value and the regime.
  matrixLabel   String
  ruleKey       String
  ruleLabel     String
  clause        String
  contractValue Decimal @db.Decimal(18, 2)
  regime        String?
  /// The resolution's warnings that did not refuse it (a known gap, an undecided chain), in words.
  warnings      Json
  /// The organisation's day it holds from, and when it was recorded.
  effectiveOn   DateTime
  recordedAt    DateTime

  delegations SoDelegation[]

  @@index([contractId])
}

/// A delegation of the S.O.'s authority to a representative (FR-SUP-002–004): the competency confirmation, the
/// delegate's type and scope, and the letter pair it is made by (Part A's first certificates, through the 6.14
/// core). In force from the letter's date until revoked. No sub-delegation: a delegate never delegates.
model SoDelegation {
  id             String               @id @default(cuid())
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  assignmentId   String
  assignment     ContractSoAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  kind               DelegateKind
  delegatePersonId   String
  delegatePerson     Person @relation("SoDelegate", fields: [delegatePersonId], references: [id], onDelete: Restrict)
  delegateName       String
  /// The S.O. who delegates, recorded on their behalf (not signed): a holder of the assignment's office.
  grantorPersonId    String
  grantorPerson      Person @relation("SoDelegationGrantor", fields: [grantorPersonId], references: [id], onDelete: Restrict)
  grantorName        String
  /// FR-SUP-002: the S.O.'s recorded satisfaction with the delegate's ability and experience (CHECK true).
  competencyConfirmed Boolean
  competencyNote     String
  /// FR-SUP-003: the letter pair as frozen from the contract type when it was made.
  variant            DelegationVariant
  letterCertificateId String     @unique
  letterCertificate   Certificate @relation("DelegationLetter", fields: [letterCertificateId], references: [id], onDelete: Restrict)
  noticeCertificateId String     @unique
  noticeCertificate   Certificate @relation("DelegationNotice", fields: [noticeCertificateId], references: [id], onDelete: Restrict)
  recordedAt         DateTime
  recordedOn         DateTime
  revokedOn          DateTime?
  revokeReason       String    @default("")
  revokedAt          DateTime?

  scope SoDelegationScope[]

  @@index([contractId])
}

/// One act within a delegation's scope (FR-SUP-004).
model SoDelegationScope {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  delegationId   String
  delegation     SoDelegation @relation(fields: [delegationId], references: [id], onDelete: Restrict)
  act            SupervisionAct

  @@unique([delegationId, act])
}

/// Possession of site (FR-SUP-005): recorded once; writes the POSSESSION baseline version and moves the contract
/// to ACTIVE (the only act that does). What it was judged under is frozen with it.
model Possession {
  id                 String           @id @default(cuid())
  organisationId     String
  organisation       Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId         String           @unique
  contract           Contract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  possessionOn       DateTime
  recordedByPersonId String
  recordedBy         Person           @relation("PossessionRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  /// The POSSESSION version it wrote.
  baselineId         String           @unique
  baseline           ContractBaseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  /// The type's start-of-work behaviour as read, and the bond and policies as judged (BD-612-22).
  judgedUnder        Json
  note               String           @default("")
  recordedAt         DateTime
  recordedOn         DateTime
}

/// A revision of the contractor's programme (FR-SUP-006, 012): submitted, scrutinised by the S.O.
/// Representative, then approved or returned for revision by the Principal S.O. Representative. The approved
/// programme in force is the latest approved revision; a revision replaces it only when approved.
model WorkProgramme {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  revision       Int
  kind           ProgrammeKind
  submittedOn    DateTime
  /// The direction it answers, where one called for it (FR-SUP-012).
  directionId    String?
  direction      ProgrammeDirection? @relation(fields: [directionId], references: [id], onDelete: Restrict)
  note           String          @default("")
  recordedAt     DateTime

  scrutinisedByPersonId String?
  scrutinisedBy         Person?   @relation("ProgrammeScrutinisedBy", fields: [scrutinisedByPersonId], references: [id], onDelete: Restrict)
  scrutinisedOn         DateTime?
  /// Whether it reflects a reasonable and realistic sequence with reasonable commencement and completion dates.
  reasonable            Boolean?
  scrutinyNote          String    @default("")

  decision            ProgrammeDecision?
  decidedByPersonId   String?
  decidedBy           Person?   @relation("ProgrammeDecidedBy", fields: [decidedByPersonId], references: [id], onDelete: Restrict)
  decidedOn           DateTime?
  decisionNote        String    @default("")
  decidedAt           DateTime?

  points ProgrammePoint[]
  /// 6.13 Part B run 1b (FR-EOT-004): the EOT claims assessed against this revision.
  eotClaims EotClaim[]

  @@unique([contractId, revision])
}

/// A point of a programme's planned progress: by the day, this percentage of the works (FR-SUP-010).
model ProgrammePoint {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  programmeId    String
  programme      WorkProgramme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  day            DateTime
  plannedPct     Decimal       @db.Decimal(9, 4)

  @@unique([programmeId, day])
}

/// Actual physical progress recorded on a day (FR-SUP-010).
model ProgressRecord {
  id                 String       @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId         String
  contract           Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  day                DateTime
  actualPct          Decimal      @db.Decimal(9, 4)
  recordedByPersonId String
  recordedBy         Person       @relation("ProgressRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  note               String       @default("")
  recordedAt         DateTime

  @@unique([contractId, day])
}

/// The daily site diary (FR-SUP-007): one entry a day from commencement to completion, complete only with both
/// attestations (the responsible officer and the contractor's agent, who meet at the end of the day). A
/// disagreement is recorded on the entry and escalated to the S.O. An entry for an earlier day needs a recorded
/// exception.
model SiteDiaryEntry {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId        String
  contract          Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  day               DateTime
  weather           String       @default("")
  entry             String       @db.Text
  officerPersonId   String
  officer           Person       @relation("DiaryOfficer", fields: [officerPersonId], references: [id], onDelete: Restrict)
  officerAttestedOn DateTime?
  agentName         String       @default("")
  agentAttestedOn   DateTime?
  disagreement      String       @default("")
  escalatedOn       DateTime?
  /// An entry for a day before the one it was written on: the recorded exception (required, CHECK).
  backdatedReason   String       @default("")
  recordedAt        DateTime
  recordedOn        DateTime

  @@unique([contractId, day])
}

/// An endorsement of the diary at a site visit (FR-SUP-008), over the days it covers.
model DiaryEndorsement {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  role           DiaryEndorser
  personId       String
  person         Person        @relation("DiaryEndorsedBy", fields: [personId], references: [id], onDelete: Restrict)
  visitedOn      DateTime
  coversFrom     DateTime
  coversTo       DateTime
  note           String        @default("")
  recordedAt     DateTime
}

/// A special meeting chaired by the S.O. after an In Delay classification (FR-SUP-011), with its minutes.
model SiteMeeting {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  heldOn         DateTime
  chairPersonId  String
  chair          Person       @relation("SiteMeetingChair", fields: [chairPersonId], references: [id], onDelete: Restrict)
  attendees      String[]
  minutes        String       @db.Text
  /// The In Delay reading that called it, as it stood on the day.
  inDelayReading Json
  recordedAt     DateTime
}

/// A compliance observation (FR-SUP-014).
model ComplianceObservation {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  area           ComplianceArea
  observedOn     DateTime
  personId       String
  person         Person         @relation("ObservationBy", fields: [personId], references: [id], onDelete: Restrict)
  note           String
  recordedAt     DateTime
}

/// A direction to review the completion date and submit a revised programme (FR-SUP-012).
model ProgrammeDirection {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  cause          DirectionCause
  directedOn     DateTime
  personId       String
  person         Person         @relation("DirectionBy", fields: [personId], references: [id], onDelete: Restrict)
  note           String
  recordedAt     DateTime

  programmes WorkProgramme[]
}

/// A sum the employer paid on the contractor's behalf, waiting for the next interim certificate's deduction
/// block (FR-SUP-013 self-help on insurance; FR-PAY-011). Read by the interim certificate (6.13 step 3).
model PendingDeduction {
  id             String               @id @default(cuid())
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  kind           PendingDeductionKind
  policyId       String?
  policy         InsurancePolicy?     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  amount         Decimal              @db.Decimal(18, 2)
  paidOn         DateTime
  extendedTo     DateTime?
  personId       String
  person         Person               @relation("PendingDeductionBy", fields: [personId], references: [id], onDelete: Restrict)
  note           String
  recordedAt     DateTime
  /// 6.13 Part A step 3: the valuation whose certificate deducts it (null: still waiting). A valuation whose
  /// certificate is void gives it back to the next.
  valuationId    String?
  valuation      InterimValuation? @relation(fields: [valuationId], references: [id], onDelete: Restrict)
}

/// The S.O.'s early-action decision (FR-SUP-015): one or more branches, each opening its module.
model EarlyActionDecision {
  id             String              @id @default(cuid())
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  decidedOn      DateTime
  branches       EarlyActionBranch[]
  personId       String
  person         Person              @relation("EarlyActionBy", fields: [personId], references: [id], onDelete: Restrict)
  reason         String
  recordedAt     DateTime
}

/// A party paid through the contract's certificates (B1, OD-A8 A, ADR 0025): totals only until the annexes
/// arrive. Never deleted once a certificate could carry it; retired with a reason.
model ContractParty {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  kind           ContractPartyKind
  name           String
  /// The sub-contract (or assigned) sum, where stated. Null: not stated.
  sum            Decimal?          @db.Decimal(18, 2)
  /// Whether it is paid direct. Null: not answered.
  directPayment  Boolean?
  provenance     Provenance?
  note           String            @default("")
  recordedAt     DateTime
  retiredOn      DateTime?
  retireReason   String            @default("")

  /// 6.13 Part A step 3: its lines on valuations, and the advances paid to it.
  partyLines      PartyLine[]
  advancePayments AdvancePayment[]
}

/// A controlled set of site records handed to the Implementing Department (FR-SUP-009), the versions pinned.
model SiteRecordsHandover {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  recordsSet     SiteRecordsSet
  handedOverOn   DateTime
  toLabel        String
  receivedByName String
  personId       String
  person         Person         @relation("RecordsHandedOverBy", fields: [personId], references: [id], onDelete: Restrict)
  /// The versions handed over: id, document title, version number, fingerprint.
  pinnedVersions Json
  note           String         @default("")
  recordedAt     DateTime

  /// 6.13 Part A step 3: a retention release that rests on this handover of the as-built drawings.
  retentionReleases RetentionRelease[]
}

// ------------------------------------------------------------------ 6.13 Part A step 3 (4c): interim payment and the damages chain

/// FR-PAY-004: what started a valuation cycle.
enum ValuationTrigger {
  VALUATION_DATE
  CLAIM
}

/// FR-PAY-006: the contractor's answer to the joint valuation.
enum ContractorAnswer {
  AGREED
  DISSENT
}

/// Where a valuation stands. HELD: below the minimum, held to the next cycle (FR-PAY-013).
enum ValuationStatus {
  OPEN
  RAISED
  HELD
  WITHDRAWN
}

/// FR-PAY-011: the deductions an officer keys (the rest are computed).
enum KeyedDeductionKind {
  PREMIUMS_PERKESO
  WAGES
  NON_COMPLIANCE
  OTHER
  LAD_ROUNDING
}

/// FR-PAY-021: a release of retention money.
enum RetentionReleaseKind {
  RELEASED_FIRST
  RELEASED_BALANCE
}

/// FR-PAY-002: whose advance.
enum AdvanceParty {
  MAIN
  NSC
}

/// OD-A6: the figure an interim certificate is routed on.
enum PaymentRouteFigure {
  RECOMMENDED
  GROSS_THIS_PERIOD
}

/// OD-A4: the remainder rule of a pro-rata split.
enum WaterfallRemainder {
  LARGEST_REMAINDER
  FIRST_PARTY
}

/// FR-LAD-001, OD-A1 A: the non-completion decision.
enum NonCompletionOutcome {
  LAD_APPLIES
  EXCUSED_OR_PENDING
}

/// FR-LAD-004: whole works or a section.
enum NonCompletionScope {
  WHOLE
  SECTION
}

/// The contract clocks Part A reads (plan A2). Part B adds its own, each in its own migration.
enum ContractClock {
  ORAL_CONFIRM
  ORAL_OBJECTION
  DAYWORK_SUBSTANTIATION
  LAD_WARNING_RESPONSE
  CERT_ISSUE
}

/// The form a certificate kind prints on, and the routing sheet it is sent on (6.13 Part A step 3). One per kind
/// per organisation; the product ships none. No form: the kind's certificate is not raised, naming this setting.
/// No routing sheet: it goes without one (its approval route, where its kind has one, is still required).
model CertificateKindSetting {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  kind           CertificateKind
  templateId     String?
  template       DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  routingTypeId  String?
  routingType    RoutingSheetType? @relation(fields: [routingTypeId], references: [id], onDelete: Restrict)
  provenance     Provenance
  notes          String            @default("")

  @@unique([organisationId, kind])
}

/// A contract clock (plan A2): its length and unit, with where the figure came from. Unset reads "Not set"; the act
/// it governs refuses unless the clock is advisory.
model ContractClockRule {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  clock          ContractClock
  length         Int
  unit           PeriodUnit
  provenance     Provenance
  notes          String        @default("")

  @@unique([organisationId, clock])
}

/// BD-613-41 as amended: a contract's position before the first interim valuation the system raises, entered once:
/// the last interim certificate it covers, the gross certified and previously certified to date, retention held and
/// released per tier, advance recouped by schedule number, and damages charged until. Each figure is STATED (its
/// note names the source certificate's reference) or ASSUMED (its note the reason; ASSUMED warns on every later
/// certificate). Corrected only with a reason and only until a certificate not void has been raised after it (BD-613-50). The payment
/// module reads it as the latest issued interim certificate.
model OpeningPosition {
  id                    String       @id @default(cuid())
  organisationId        String
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId            String       @unique
  contract              Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// The last interim certificate it covers: its number as issued, and its sequence on the contract.
  lastCertificateNumber String
  lastSequence          Int
  grossToDate           Decimal      @db.Decimal(18, 2)
  grossProvenance       Provenance
  grossNote             String
  previouslyCertified   Decimal      @db.Decimal(18, 2)
  previousProvenance    Provenance
  previousNote          String
  retentionMain         Decimal      @db.Decimal(18, 2)
  retentionNsc          Decimal      @db.Decimal(18, 2)
  retentionNs           Decimal      @db.Decimal(18, 2)
  retentionProvenance   Provenance
  retentionNote         String
  releasedMain          Decimal      @db.Decimal(18, 2)
  releasedNsc           Decimal      @db.Decimal(18, 2)
  releasedNs            Decimal      @db.Decimal(18, 2)
  releasedProvenance    Provenance
  releasedNote          String
  /// Advance recouped by schedule number: [{ sequence, amount }] (amount a decimal string).
  advanceRecouped       Json
  advanceProvenance     Provenance
  advanceNote           String
  /// The first day not charged with damages (null: none charged).
  damagesChargedUntil   DateTime?
  damagesProvenance     Provenance
  damagesNote           String
  personId              String
  person                Person       @relation("OpeningRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt            DateTime
  recordedOn            DateTime
}

/// FR-PAY-003: the day of the month agreed with the contractor as the site valuation day.
model PaymentCalendar {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String       @unique
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  dayOfMonth     Int
  agreedOn       DateTime
  agreedWith     String
  personId       String
  person         Person       @relation("CalendarRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  note           String       @default("")
  recordedAt     DateTime
}

/// One interim valuation (FR-PAY-004–013): its trigger, the joint valuation, the work valued and its lines, until its
/// certificate is raised (then frozen) or it is held to the next cycle. What the certificate was judged under is
/// frozen in `judgedUnder` when it is raised, and never read live again.
model InterimValuation {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  trigger        ValuationTrigger
  /// The claim's day (CLAIM); the issue period runs from it. Null for a calendar valuation.
  triggerDate    DateTime?
  valuationDate  DateTime
  status         ValuationStatus  @default(OPEN)
  /// The main contractor's work executed, to date. Null: not yet valued.
  mainWorks      Decimal?         @db.Decimal(18, 2)
  mainWorksNote  String           @default("")
  /// FR-PAY-006: the joint valuation.
  jointOn          DateTime?
  participants     String[]
  method           String           @default("")
  contractorAnswer ContractorAnswer?
  dissent          String           @default("")
  /// Who it is recorded for (the S.O., or a representative whose delegation covers valuation).
  personId       String
  person         Person           @relation("ValuationRecordedFor", fields: [personId], references: [id], onDelete: Restrict)
  certificateId  String?          @unique
  certificate    Certificate?     @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  judgedUnder    Json?
  closeReason    String           @default("")
  closedAt       DateTime?
  recordedAt     DateTime
  recordedOn     DateTime

  materialLines      MaterialLine[]
  partyLines         PartyLine[]
  deductions         ValuationDeduction[]
  pendingDeductions  PendingDeduction[]

  @@index([contractId])
}

/// FR-PAY-005, 007: a line of the contractor's materials-on-site list, with the three answers.
model MaterialLine {
  id               String           @id @default(cuid())
  organisationId   String
  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  valuationId      String
  valuation        InterimValuation @relation(fields: [valuationId], references: [id], onDelete: Restrict)
  description      String
  quantity         String
  location         String
  value            Decimal          @db.Decimal(18, 2)
  protectedOnSite  Boolean?
  notTooEarly      Boolean?
  formsPartOfWorks Boolean?
  temporary        Boolean
  submittedOn      DateTime
  recordedAt       DateTime
}

/// FR-PAY-010 (B1, ADR 0025): a nominated party's or an assignee's totals on a valuation: its value to date (the
/// nominated tiers' gross) and what is due to it on this certificate (the waterfall's). Totals only.
model PartyLine {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  valuationId    String
  valuation      InterimValuation @relation(fields: [valuationId], references: [id], onDelete: Restrict)
  partyId        String
  party          ContractParty    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  /// The party's work or supply valued to date (nominated parties). Null for an assignee.
  value          Decimal?         @db.Decimal(18, 2)
  due            Decimal          @db.Decimal(18, 2)
  submittedOn    DateTime
  note           String           @default("")
  recordedAt     DateTime

  @@unique([valuationId, partyId])
}

/// FR-PAY-011: a deduction an officer keys on a valuation (premiums and social security, wages, non-compliance,
/// up to three others, the damages line's signed rounding).
model ValuationDeduction {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  valuationId    String
  valuation      InterimValuation   @relation(fields: [valuationId], references: [id], onDelete: Restrict)
  kind           KeyedDeductionKind
  label          String             @default("")
  amount         Decimal            @db.Decimal(18, 2)
  note           String             @default("")
  recordedAt     DateTime
}

/// FR-PAY-021: a release of retention, per tier, read from what the latest issued interim certificate held. Paid
/// through the next interim certificate (it comes off the retention held). Once each.
model RetentionRelease {
  id                 String               @id @default(cuid())
  organisationId     String
  organisation       Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId         String
  contract           Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  kind               RetentionReleaseKind
  main               Decimal              @db.Decimal(18, 2)
  nsc                Decimal              @db.Decimal(18, 2)
  ns                 Decimal              @db.Decimal(18, 2)
  /// What was held, as read from that certificate, and the percentage applied (frozen).
  heldMain           Decimal              @db.Decimal(18, 2)
  heldNsc            Decimal              @db.Decimal(18, 2)
  heldNs             Decimal              @db.Decimal(18, 2)
  pct                Decimal?             @db.Decimal(9, 4)
  pctProvenance      Provenance?
  basisCertificateId String
  basisCertificate   Certificate          @relation(fields: [basisCertificateId], references: [id], onDelete: Restrict)
  handoverId         String?
  handover           SiteRecordsHandover? @relation(fields: [handoverId], references: [id], onDelete: Restrict)
  releasedOn         DateTime
  personId           String
  person             Person               @relation("RetentionReleasedBy", fields: [personId], references: [id], onDelete: Restrict)
  note               String               @default("")
  recordedAt         DateTime

  @@unique([contractId, kind])
}

/// FR-PAY-001 (B2, OD-A9 A): an advance payment, a mechanism only: its amount, the guarantee it rests on, and the
/// recoupment schedule entered for the contract. The advance payment certificate is its certificate.
model AdvancePayment {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  party          AdvanceParty
  partyId        String?
  contractParty  ContractParty?     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  amount         Decimal            @db.Decimal(18, 2)
  securityId     String
  security       SecurityInstrument @relation(fields: [securityId], references: [id], onDelete: Restrict)
  certificateId  String             @unique
  certificate    Certificate        @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  appliedOn      DateTime
  personId       String
  person         Person             @relation("AdvanceAppliedBy", fields: [personId], references: [id], onDelete: Restrict)
  note           String             @default("")
  judgedUnder    Json
  recordedAt     DateTime

  schedule AdvanceRecoupmentRow[]
}

/// FR-PAY-002: on interim certificate `sequence`, recoup this much of the advance.
model AdvanceRecoupmentRow {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  advanceId      String
  advance        AdvancePayment @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  sequence       Int
  amount         Decimal        @db.Decimal(18, 2)

  @@unique([advanceId, sequence])
}

/// FR-PAY-019 (INT-07, manual adapter): Finance's payment of an issued payment certificate.
model FinancePayment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificateId  String       @unique
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  batchNo        String
  paidOn         DateTime
  amount         Decimal      @db.Decimal(18, 2)
  personId       String
  person         Person       @relation("FinancePaymentBy", fields: [personId], references: [id], onDelete: Restrict)
  note           String       @default("")
  recordedAt     DateTime
}

/// FR-LAD-003: the warning letter of intention to impose damages (its certificate), with the registered post.
model LadWarning {
  id                 String       @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId         String
  contract           Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  certificateId      String       @unique
  certificate        Certificate  @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  eotClause          String
  ladClause          String
  extendedCompletion DateTime
  /// The rate a day as read from the pinned baseline (never keyed).
  rate               Decimal      @db.Decimal(18, 2)
  /// The response clock as it stood (null: not set; advisory).
  responseClock      Json?
  consignmentRef     String       @default("")
  postedOn           DateTime?
  postedAt           DateTime?
  personId           String
  person             Person       @relation("LadWarningBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt         DateTime
  recordedOn         DateTime

  nonCompletions NonCompletion[]
}

/// FR-LAD-001, 004, 005, 008 (OD-A1 A): the non-completion decision. LAD_APPLIES raises the Certificate of
/// Non-Completion (its certificate) and carries the accrual window (ASSUMED reading, shown); EXCUSED_OR_PENDING
/// lets interim certificates proceed without a damages line, its reasons shown on them. The latest decision governs;
/// Part B's extension-of-time record replaces it, never rewriting an issued certificate.
model NonCompletion {
  id                 String               @id @default(cuid())
  organisationId     String
  organisation       Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId         String
  contract           Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  outcome            NonCompletionOutcome
  reason             String
  scope              NonCompletionScope?
  /// A section of the pinned baseline (its reference), for SECTION.
  sectionRef         String?
  certificateId      String?              @unique
  certificate        Certificate?         @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  warningId          String?
  warning            LadWarning?          @relation(fields: [warningId], references: [id], onDelete: Restrict)
  eotClause          String               @default("")
  ladClause          String               @default("")
  /// The date for completion as read (the pinned baseline's), and the rate a day it charges at (never keyed).
  dateForCompletion  DateTime
  rate               Decimal?             @db.Decimal(18, 2)
  insuranceExpiry    DateTime?
  expectedCompletion DateTime?
  windowFrom         DateTime?
  windowUntil        DateTime?
  windowClosedAt     DateTime?
  /// FR-LAD-005: the four pack items, each answered or not required with its reason.
  pack               Json
  decidedOn          DateTime
  personId           String
  person             Person               @relation("NonCompletionBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt         DateTime
  /// Code review run 2 item 6: one live decision a contract. A later decision replaces the live one explicitly, with
  /// its reason (audited, linking the earlier); never while the earlier's Certificate of Non-Completion is open.
  replacesId         String?              @unique
  replaces           NonCompletion?       @relation("NonCompletionReplaces", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy         NonCompletion?       @relation("NonCompletionReplaces")
  replaceReason      String               @default("")

  /// 6.13 Part B run 1b (613A-C2 (a)(1), BD-613-89): where the entitlement determination behind the decision is
  /// recorded. Every Part A decision reads CNC_DETERMINATION (the decision itself determined it); every later one
  /// EOT_RECORD. An excusable or pending one on the EOT record names the claim it waits on (CHECK).
  basis              NonCompletionBasis
  eotClaimId         String?
  eotClaim           EotClaim?            @relation(fields: [eotClaimId], references: [id], onDelete: Restrict)
  /// 613A-C2 (a)(2) as amended (BD-613-89): the issued EOT certificate that superseded it, for later certificates
  /// only, with the note recorded at its issue (closed by the extension, or a replacement needed past the new date).
  supersededByEotId  String?
  supersededByEot    ExtensionOfTime?     @relation(fields: [supersededByEotId], references: [id], onDelete: Restrict)
  supersededNote     String               @default("")

  /// 6.13 Part B run 1b (FR-LAD-009): the waivers of the damages it charges.
  waivers            LadWaiver[]
}

/// 613A-C2 (a)(1): where a non-completion decision's entitlement determination is recorded.
enum NonCompletionBasis {
  CNC_DETERMINATION
  EOT_RECORD
}

// ------------------------------------------------------------------ 6.13 Part A step 4 (4d): variations and price adjustment

/// OD-A2: a variation's percentage is of this variation alone, or of every approved variation to date with it.
enum VariationPctBasis {
  THIS_VARIATION
  CUMULATIVE
}

/// OD-A2: the sum a variation's percentage is taken over, and the contract value its band is read at.
enum VariationBase {
  ORIGINAL
  REVISED
}

/// FR-VAR-007 (OD-A5): the schedule form a variation produces: the agreed-price schedule, the measured schedule,
/// or both (a pure union of the two).
enum VariationScheduleForm {
  AGREED_PRICE
  MEASURED
  BOTH
}

/// FR-VAR-001: who originated the variation: the implementing department (reviewed by an S.O.'s Representative),
/// or an S.O.'s Representative directly.
enum VariationOrigin {
  DEPARTMENT
  SO_REPRESENTATIVE
}

/// FR-VAR-004 (§8.7): the four exemptions from prior approval. An exempt variation goes straight to the S.O.'s
/// instruction, without the committee or the approval tiers.
enum VariationExemption {
  REDUCTION
  PC_SUM
  PROVISIONAL_SUM
  REMEASUREMENT
}

/// Where a variation stands, as stored; the rest of its stage (with the S.O., awaiting approval, approved,
/// instructed, certified) is read from its records, never stored twice.
enum VariationStatus {
  DRAFT
  SUBMITTED
  SUPPORTED
  CLOSED
}

/// FR-VAR-008, FR-PAD-004: the separate approvals a variation may need, each its own route.
enum VariationEvent {
  PRIOR
  INCREASE
  AGREED_RATE
  REMEASUREMENT
}

/// FR-VAR-018: where a measured item's rate comes from.
enum VariationRateSource {
  CONTRACT_RATE
  AGREED_RATE
}

/// An addition to the contract sum, or an omission from it.
enum AdjustmentDirection {
  ADDITION
  OMISSION
}

/// FR-PAD-002: the section of the adjustment certificate a line is in: 1.1 variation-driven, 1.2 other.
enum AdjustmentSection {
  VARIATION
  OTHER
}

/// A variation of the works (FR-VAR-001–024): originated, applied for (the application, VO-660, a certificate),
/// decided by the S.O., approved on its own routes (prior approval, an increase, agreed rates, a re-measurement;
/// FR-VAR-008) unless exempt (FR-VAR-004), instructed (the S.O.'s instruction, a certificate), measured, and
/// certified (the Variation Order Certificate, VO-663). The contract sum moves only by an issued adjustment
/// certificate (FR-PAD-003). Its figures are worked out, never keyed: the cumulative and the new sum (FR-VAR-003,
/// 024), the percentage on the configured basis (OD-A2), its edge wording (OD-A3).
/// 6.13 Part B (ADR 0029, OD-B5 A): the kind of a post-award matter decided on an approval route.
enum ContractMatterKind {
  EOT
  PERIOD_EXTENSION
  LAD_WAIVER
  TERMINATION
  NOMINATED_INCREASE
  NOMINATION
  LOSS_EXPENSE
}

/// 6.13 Part B (ADR 0029, OD-B5 A, BD-613-73): a post-award matter decided on an approval route: an extension of time,
/// a contract period extension, a LAD waiver, a termination, a nominated-sum increase, a nomination or a loss-and-expense
/// claim. It owns its routes (ApprovalInstance.contractMatterId) and the committee matters tabled from it
/// (CommitteeDecision.contractMatterId); each domain record points to it by its own `matterId @unique` (runs 1b to 5).
/// Built at run 1a with no writer: the acts that record, send and close a matter come with run 1b.
model ContractMatter {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  kind           ContractMatterKind
  /// From the `contract_matter` numbering series at its first send; null until then (no series: the send is refused,
  /// naming it).
  reference      String?
  /// The value its route is resolved on; null where the domain routes on a ratio, or before it is sent. Never below
  /// nothing (CHECK ContractMatter_shape). Read SULIT wherever shown (MATTER_AMOUNT_SULIT.CONTRACT, not decided);
  /// registered in SULIT_FIELDS under this name of its own (Run 1a fix round, review S4).
  matterRoutedValue Decimal?        @db.Decimal(18, 2)
  /// The exact ratio the route is resolved on (a LAD waiver: waived ÷ LAD amount): both or neither, the denominator
  /// above nothing (CHECK ContractMatter_shape). SULIT, registered in SULIT_FIELDS (review S4).
  matterRatioNum Decimal?           @db.Decimal(18, 2)
  matterRatioDen Decimal?           @db.Decimal(18, 2)
  /// The routing condition the matrix reads (e.g. FIN_IMPACT_OTHER), as the domain's rows name it.
  cond           String?
  /// Its approval of record: the APPROVED latest route (one writer, the route hook, run 1b).
  approvedRouteId String?           @unique
  approvedRoute   ApprovalInstance? @relation("ContractMatterApprovalOfRecord", fields: [approvedRouteId], references: [id], onDelete: Restrict)
  /// Closed with its reason (CHECK ContractMatter_shape: a closed matter says why). One open TERMINATION matter a
  /// contract (partial unique index ContractMatter_one_open_termination).
  closedAt       DateTime?
  closeReason    String             @default("")
  /// Who recorded it, on their behalf, not signed.
  personId       String
  person         Person             @relation("ContractMatterRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt     DateTime

  routes    ApprovalInstance[]  @relation("ContractMatterRoutes")
  /// 6.13 Part B run 1b: the domain record the matter is the route of (one of them).
  eotClaim         EotClaim?
  periodExtension  PeriodExtension?
  lossExpenseClaim LossExpenseClaim?
  ladWaiver        LadWaiver?
  decisions CommitteeDecision[]

  @@unique([organisationId, reference])
  @@index([contractId])
}

// ------------------------------------------------------------------ 6.13 Part B run 1b: time and damages

/// FR-EOT-001: how a delay notice came: the contractor's written notice, or the S.O.'s direction to give reasons.
enum DelayNoticePath {
  CONTRACTOR_NOTICE
  SO_DIRECTION
}

/// FR-EOT-002: the entitlement test's answer.
enum EotEntitlement {
  ENTITLED
  NOT_ENTITLED
}

/// FR-EOT-003: the best-endeavours test's answer (PARTIAL: a partial extension, the un-extended period stated).
enum BestEndeavours {
  FULL
  PARTIAL
  NONE
}

/// FR-EOT-007: the cause of an EOT's financial impact, which picks its route (never its value).
enum FinancialImpact {
  NONE
  AUTHORITY_REQUIREMENT
  OTHER
}

/// FR-EOT-008: whether a reason's extension runs with others (a concurrent group, counted at its longest) or adds.
enum ReasonConcurrency {
  CONCURRENT
  CONSECUTIVE
}

/// FR-EOT-001: a delay notice: the contractor's written notice of the causes of delay, or the S.O.'s direction to a
/// contractor behind schedule to give reasons. Timestamped (`receivedAt`); its scan is attached (DELAY_NOTICE). No clock:
/// "immediately" carries no day count.
model DelayNotice {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  path           DelayNoticePath
  cause          String
  occurredOn     DateTime
  receivedOn     DateTime
  receivedAt     DateTime
  /// Who it is recorded for (the S.O., or a representative), on their behalf, not signed.
  personId       String
  person         Person          @relation("DelayNoticeRecordedFor", fields: [personId], references: [id], onDelete: Restrict)
  note           String          @default("")
  recordedAt     DateTime

  claims      EotClaimNotice[]
  attachments DocumentAttachment[]

  @@index([contractId])
}

/// The delay notices an EOT claim rests on.
model EotClaimNotice {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  claimId        String
  claim          EotClaim     @relation(fields: [claimId], references: [id], onDelete: Restrict)
  noticeId       String
  notice         DelayNotice  @relation(fields: [noticeId], references: [id], onDelete: Restrict)

  @@unique([claimId, noticeId])
}

/// FR-EOT-001–008: an extension-of-time claim, decided on its contract matter's route (ADR 0029). Its scope (the whole
/// works or a section of the baseline), its ground, the approved programme revision the actual delay is assessed
/// against (FR-EOT-004), the weather answers (FR-EOT-005), the five-item pack (FR-EOT-006), the financial impact that
/// picks its route (FR-EOT-007), and the S.O.'s determination: entitled or not (FR-EOT-002) and best endeavours
/// (FR-EOT-003). A condition of the award excluding an EOT pre-answers "not a ground" (FR-AWD-014); overriding it needs
/// a reason.
model EotClaim {
  id                      String             @id @default(cuid())
  organisationId          String
  organisation            Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matterId                String             @unique
  matter                  ContractMatter     @relation(fields: [matterId], references: [id], onDelete: Restrict)
  contractId              String
  contract                Contract           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  scope                   NonCompletionScope
  sectionRef              String?
  groundClause            String
  cause                   String
  programmeId             String
  programme               WorkProgramme      @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  financialImpact         FinancialImpact
  proposedDays            Int
  isWeather               Boolean
  exceptional             Boolean?
  earthworksDays          Int?
  actualDelayDays         Int?
  /// The five items of FR-EOT-006, each answered or not required with its reason.
  pack                    Json
  canComplete             Boolean?
  estimatedCompletion     DateTime?
  excludedByConditionId   String?
  excludedByCondition     AwardCondition?    @relation(fields: [excludedByConditionId], references: [id], onDelete: Restrict)
  exclusionOverrideReason String             @default("")
  entitlement             EotEntitlement?
  entitlementReason       String             @default("")
  bestEndeavours          BestEndeavours?
  determinedOn            DateTime?
  determinedByPersonId    String?
  determinedBy            Person?            @relation("EotClaimDeterminedBy", fields: [determinedByPersonId], references: [id], onDelete: Restrict)
  personId                String
  person                  Person             @relation("EotClaimRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt              DateTime

  notices           EotClaimNotice[]
  reasons           EotReason[]
  extensions        ExtensionOfTime[]
  lossExpenseClaims LossExpenseClaim[]
  attachments       DocumentAttachment[]
  /// The damages decisions that wait on it (excusable or pending, EOT_RECORD).
  nonCompletions    NonCompletion[]

  @@index([contractId])
}

/// FR-EOT-008: a row of the EOT certificate's reason table: the reason, its clause, the delay's days (`delayUntil` the
/// first day not delayed), the extension it earns, and whether it runs concurrently (in its group) or consecutively.
model EotReason {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  claimId        String
  claim          EotClaim          @relation(fields: [claimId], references: [id], onDelete: Restrict)
  clause         String
  reason         String
  delayFrom      DateTime
  delayUntil     DateTime
  extensionDays  Int
  concurrency    ReasonConcurrency
  group          String?
  sortOrder      Int               @default(0)

  @@index([claimId])
}

/// FR-EOT-008: the extension of time a certificate grants (its certificate's figures), OD-B6 A: the officer states the
/// days granted; the reasons' computed days are shown beside them (assumed). The previous and new dates for completion
/// of its scope; its issue writes the EXTENSION_OF_TIME baseline version (`baselineId`). One live (not void) certificate
/// a claim, held in lib (BD-613-135).
model ExtensionOfTime {
  id                 String            @id @default(cuid())
  organisationId     String
  organisation       Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificateId      String            @unique
  certificate        Certificate       @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  claimId            String
  claim              EotClaim          @relation(fields: [claimId], references: [id], onDelete: Restrict)
  grantedDays        Int
  computedDays       Int
  previousCompletion DateTime
  newCompletion      DateTime
  unextendedNote     String            @default("")
  baselineId         String?           @unique
  baseline           ContractBaseline? @relation("ExtensionOfTimeVersion", fields: [baselineId], references: [id], onDelete: Restrict)
  /// FR-EOT-009: the policies whose cover ends before the new date, offered for the S.O.'s self-help (frozen at raise).
  insuranceOffered   Json
  personId           String
  person             Person            @relation("ExtensionOfTimeRaisedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt         DateTime

  /// The damages decisions its issue superseded.
  supersededDecisions NonCompletion[]

  @@index([claimId])
}

/// FR-EOT-006, OD-B20: a loss-and-expense claim: claimed (from an EOT claim's pack or on its own), valued, then sent on
/// its contract matter's route. Only an approved one enters a 1.2 adjustment line (run 1b C11).
model LossExpenseClaim {
  id               String          @id @default(cuid())
  organisationId   String
  organisation     Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId       String
  contract         Contract        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  claimId          String?
  claim            EotClaim?       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimed          Decimal         @db.Decimal(18, 2)
  valued           Decimal?        @db.Decimal(18, 2)
  basis            String          @default("")
  valuedOn         DateTime?
  valuedByPersonId String?
  valuedBy         Person?         @relation("LossExpenseValuedBy", fields: [valuedByPersonId], references: [id], onDelete: Restrict)
  matterId         String?         @unique
  matter           ContractMatter? @relation(fields: [matterId], references: [id], onDelete: Restrict)
  personId         String
  person           Person          @relation("LossExpenseRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt       DateTime

  @@index([contractId])
}

/// FR-EOT-011, 012: an extension of the contract period (a term contract), decided on its contract matter's route: the
/// four cumulative preconditions and the SPAN Act's compliance, each answered before evaluation (any false refuses the
/// send; nothing is assumed), the current and new expiry, the financial impact if any.
model PeriodExtension {
  id                      String         @id @default(cuid())
  organisationId          String
  organisation            Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matterId                String         @unique
  matter                  ContractMatter @relation(fields: [matterId], references: [id], onDelete: Restrict)
  contractId              String
  contract                Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  priorAgreement          Boolean
  termsRetained           Boolean
  ratesRetained           Boolean
  performanceSatisfactory Boolean
  spanConfirmed           Boolean
  currentExpiry           DateTime
  newExpiry               DateTime
  financialImpact         Decimal?       @db.Decimal(18, 2)
  reason                  String
  personId                String
  person                  Person         @relation("PeriodExtensionRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt              DateTime

  agreements PeriodAgreement[]

  @@index([contractId])
}

/// FR-EOT-013: the supplementary agreement extending the contract period (its certificate, bilateral); its issue writes
/// the PERIOD_EXTENSION baseline version. One live (not void) agreement an extension, held in lib (BD-613-135).
model PeriodAgreement {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificateId  String            @unique
  certificate    Certificate       @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  extensionId    String
  extension      PeriodExtension   @relation(fields: [extensionId], references: [id], onDelete: Restrict)
  baselineId     String?           @unique
  baseline       ContractBaseline? @relation("PeriodAgreementVersion", fields: [baselineId], references: [id], onDelete: Restrict)
  personId       String
  person         Person            @relation("PeriodAgreementRaisedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt     DateTime

  @@index([extensionId])
}

/// FR-LAD-008, 009 (OD-B7, BD-613-75): a waiver of the damages a decision charges, decided on its contract matter's
/// route at the exact ratio waived ÷ LAD amount. The LAD amount is the decision's damages charged and chargeable to
/// `asOf`, less credits, frozen when sent with what it was read from (`basis`); applying it on a basis that has moved is
/// refused (LAD_BASIS_MOVED) and it is sent again. Applied once, on the certificate it reaches (`appliedOnCertificateId`).
model LadWaiver {
  id                     String         @id @default(cuid())
  organisationId         String
  organisation           Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matterId               String         @unique
  matter                 ContractMatter @relation(fields: [matterId], references: [id], onDelete: Restrict)
  decisionId             String
  decision               NonCompletion  @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  ladAmount              Decimal        @db.Decimal(18, 2)
  waived                 Decimal        @db.Decimal(18, 2)
  asOf                   DateTime
  basis                  Json
  waiverLetterRef        String         @default("")
  reason                 String
  appliedOnCertificateId String?        @unique
  appliedOnCertificate   Certificate?   @relation("LadWaiverAppliedOn", fields: [appliedOnCertificateId], references: [id], onDelete: Restrict)
  appliedAt              DateTime?
  personId               String
  person                 Person         @relation("LadWaiverRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt             DateTime

  @@index([decisionId])
}

model Variation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  /// From the `variation` numbering series, when it is submitted (or, exempt, when it is recorded).
  reference String?
  status    VariationStatus @default(DRAFT)

  /// FR-VAR-001: the path it was originated on, and by whom (recorded on their behalf, not signed).
  origin             VariationOrigin
  originatorPersonId String
  originator         Person          @relation("VariationOriginator", fields: [originatorPersonId], references: [id], onDelete: Restrict)
  originatorName     String
  /// FR-VAR-001: the department path's review by an S.O.'s Representative, before it is submitted.
  reviewedByPersonId String?
  reviewedBy         Person?         @relation("VariationReviewer", fields: [reviewedByPersonId], references: [id], onDelete: Restrict)
  reviewedOn         DateTime?
  reviewNote         String          @default("")
  /// FR-VAR-002: a Specialist representative's confirmation that the allocation is available, and the Principal
  /// Representative it passed through. Null: not answered.
  allocationConfirmed Boolean?
  allocationNote      String         @default("")
  principalPersonId   String?
  principal           Person?        @relation("VariationPrincipal", fields: [principalPersonId], references: [id], onDelete: Restrict)
  principalOn         DateTime?

  /// FR-VAR-003: the variation itself.
  description       String
  reason            String
  /// The estimated amount: above nothing for an addition, below it for a reduction (omission).
  estimate          Decimal             @db.Decimal(18, 2)
  exemption         VariationExemption?
  periodImplication Boolean?
  /// FR-VAR-009: whether it affects a funder's assets, so needs the funder's consent before its instruction.
  funderConsentRequired Boolean?
  /// FR-VAR-006: whether a negotiated agreed rate already exists.
  agreedRateExists  Boolean?

  /// The application (VO-660), opened when submitted. None for an exempt variation.
  applicationCertificateId String?      @unique
  applicationCertificate   Certificate? @relation("VariationApplication", fields: [applicationCertificateId], references: [id], onDelete: Restrict)
  submittedOn              DateTime?
  submittedAt              DateTime?
  /// What the application was worked out on when submitted (the contract sum, the cumulative, the new sum), frozen.
  applicationReading       Json?

  /// FR-VAR-005: the S.O.'s decision, with a value cap where supported, and where not supported sent where its
  /// destination said (or the officer chose).
  soDecision          SignatureDecision?
  soDecisionCap       Decimal?           @db.Decimal(18, 2)
  soDecidedByPersonId String?
  soDecidedBy         Person?            @relation("VariationSoDecision", fields: [soDecidedByPersonId], references: [id], onDelete: Restrict)
  soDecidedOn         DateTime?
  soDecisionNote      String             @default("")

  /// FR-VAR-014: work commenced pending approval, on the support of the S.O. or an S.O.'s Representative.
  commencedOn               DateTime?
  commencedSupportPersonId  String?
  commencedSupport          Person?   @relation("VariationCommencedSupport", fields: [commencedSupportPersonId], references: [id], onDelete: Restrict)
  commencedNote             String    @default("")

  closedOn          DateTime?
  closedReason      String    @default("")
  closedByPersonId  String?
  closedBy          Person?   @relation("VariationClosedBy", fields: [closedByPersonId], references: [id], onDelete: Restrict)

  recordedOn DateTime
  recordedAt DateTime

  approvals        VariationApproval[]
  approvalRoutes   ApprovalInstance[]
  matters          CommitteeDecision[]
  instructions     VariationInstruction[]
  measurements     VariationMeasurement[]
  dayworkRecords   DayworkRecord[]
  orders           VariationCertificate[]

  @@unique([organisationId, reference])
  @@index([contractId])
}

/// One approval a variation needs (FR-VAR-008, FR-PAD-004), on its own route on the matrix, with the reading it was
/// resolved on frozen when it was sent: the basis and base as set, the base amount, the ratio's two amounts, the
/// percentage shown and its edge wording (OD-A2, OD-A3). Never read live again.
model VariationApproval {
  id                 String           @id @default(cuid())
  organisationId     String
  organisation       Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  variationId        String
  variation          Variation        @relation(fields: [variationId], references: [id], onDelete: Restrict)
  event              VariationEvent
  approvalInstanceId String           @unique
  approvalInstance   ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  value              Decimal          @db.Decimal(18, 2)
  reading            Json
  sentByPersonId     String
  sentBy             Person           @relation("VariationRouteSentBy", fields: [sentByPersonId], references: [id], onDelete: Restrict)
  sentOn             DateTime
  sentAt             DateTime

  @@index([variationId])
}

/// The S.O.'s instruction (FR-VAR-015, 016), a certificate dated by the S.O.'s signature: never before the
/// variation's approval (or its exemption, and the funder's consent where it needs one). Its description is the
/// heading every measured item is under (FR-VAR-017) and the Variation Order Certificate repeats (FR-VAR-020).
/// The oral-instruction loop's two clocks are frozen when each day is recorded.
model VariationInstruction {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  variationId    String
  variation      Variation    @relation(fields: [variationId], references: [id], onDelete: Restrict)
  certificateId  String       @unique
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  description    String
  /// The schedule form it produces (OD-A5), as the configured rule gave it.
  scheduleForm   VariationScheduleForm
  oralIssuedOn          DateTime?
  /// The day the contractor's written confirmation is due back by (ORAL_CONFIRM), frozen. Null: the clock was not set.
  confirmDueOn          DateTime?
  contractorConfirmedOn DateTime?
  confirmationMatches   Boolean?
  /// The day an objection is due by (ORAL_OBJECTION, from the confirmation's receipt), frozen. Null: not set.
  objectionDueOn        DateTime?
  objectedOn            DateTime?
  objectionNote         String    @default("")
  personId       String
  person         Person       @relation("InstructionRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt     DateTime

  measurements   VariationMeasurement[]
  orders         VariationCertificate[]
  /// Its plans or sketches (FR-VAR-015), through the document store.
  attachments    DocumentAttachment[]

  @@index([variationId])
}

/// One measured item of an instructed variation (FR-VAR-017, 018): under the instruction's heading exactly, one item
/// each (never merged), its rate from the contract (citing the item, with any percentage adjustment) or an agreed
/// rate (approved on its own route first). The amount is worked out, half up to the sen, once.
model VariationMeasurement {
  id             String               @id @default(cuid())
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  variationId    String
  variation      Variation            @relation(fields: [variationId], references: [id], onDelete: Restrict)
  instructionId  String
  instruction    VariationInstruction @relation(fields: [instructionId], references: [id], onDelete: Restrict)
  heading        String
  itemRef        String
  description    String
  rateSource     VariationRateSource
  /// The contract item a contract rate is taken from (the bill or schedule of rates).
  bqItemRef      String               @default("")
  quantity       Decimal              @db.Decimal(18, 3)
  unit           String
  baseRate       Decimal              @db.Decimal(18, 2)
  /// The contract's percentage adjustment applied to the rate, where it has one (above or below). Null: none.
  adjustmentPct  Decimal?             @db.Decimal(9, 4)
  amount         Decimal              @db.Decimal(18, 2)
  direction      AdjustmentDirection
  measuredOn     DateTime
  /// FR-VAR-017: work to be covered up, measured during execution with detailed records.
  coveredUp      Boolean
  recordsNote    String               @default("")
  personId       String
  person         Person               @relation("MeasurementRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt     DateTime
  removedAt      DateTime?
  removedReason  String               @default("")

  @@index([instructionId])
}

/// A daywork record (FR-VAR-019): labour and plant time checked and agreed with the contractor the same day, and
/// the contractor's substantiation (vouchers, receipts, wage books, timesheets) due within its clock, frozen.
model DayworkRecord {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  variationId    String
  variation      Variation    @relation(fields: [variationId], references: [id], onDelete: Restrict)
  workedOn       DateTime
  description    String
  agreedOn       DateTime?
  agreedWith     String       @default("")
  /// DAYWORK_SUBSTANTIATION from the day worked, frozen when recorded. Null: the clock was not set.
  substantiationDueOn      DateTime?
  substantiationReceivedOn DateTime?
  personId       String
  person         Person       @relation("DayworkRecordedBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt     DateTime

  @@index([variationId])
}

/// The Variation Order Certificate (VO-663, FR-VAR-020–023): the measured variation certified, addition or omission,
/// citing its instruction, under the valuation clause chosen; its description identical to the instruction's. What it
/// was worked out from is frozen with it.
model VariationCertificate {
  id               String               @id @default(cuid())
  organisationId   String
  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  variationId      String
  variation        Variation            @relation(fields: [variationId], references: [id], onDelete: Restrict)
  instructionId    String
  instruction      VariationInstruction @relation(fields: [instructionId], references: [id], onDelete: Restrict)
  certificateId    String               @unique
  certificate      Certificate          @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  description      String
  direction        AdjustmentDirection
  valuationClauseId String?
  valuationClause   ClauseText?         @relation(fields: [valuationClauseId], references: [id], onDelete: Restrict)
  /// The clause's title as read when raised.
  valuationClauseTitle String
  judgedUnder      Json
  personId         String
  person           Person               @relation("VariationCertificateBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt       DateTime

  adjustmentLines  SumAdjustmentLine[]

  @@index([variationId])
}

/// The Certificate of Adjustment of Contract Sum (FR-PAD-001–007): the master record of the contract sum's movement.
/// Interim and final certificates read the revised sum only from issued ones (FR-PAD-003).
model SumAdjustment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  certificateId  String       @unique
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  /// What it was worked out on: the issued adjustments before it (by id), the contract type's triggers, frozen.
  judgedUnder    Json
  personId       String
  person         Person       @relation("SumAdjustmentBy", fields: [personId], references: [id], onDelete: Restrict)
  recordedAt     DateTime

  lines SumAdjustmentLine[]

  @@index([contractId])
}

/// One line of an adjustment certificate: 1.1 a variation's issued certificate, or 1.2 another adjustment by its
/// trigger, with the basis of its calculation (FR-PAD-002, 005).
model SumAdjustmentLine {
  id                     String                @id @default(cuid())
  sumAdjustmentId        String
  sumAdjustment          SumAdjustment         @relation(fields: [sumAdjustmentId], references: [id], onDelete: Cascade)
  section                AdjustmentSection
  trigger                SumAdjustmentTrigger
  variationCertificateId String?
  variationCertificate   VariationCertificate? @relation(fields: [variationCertificateId], references: [id], onDelete: Restrict)
  reference              String
  description            String
  direction              AdjustmentDirection
  amount                 Decimal               @db.Decimal(18, 2)
  basis                  String                @default("")
  sortOrder              Int

  @@index([sumAdjustmentId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Sign-in (ADR 0034). Person stays identity; an account is the way a person signs in. Accounts and sessions are never
// deleted, only disabled and revoked.
// ---------------------------------------------------------------------------------------------------------------------

/// Who or what acts (ADR 0034 D11): a staff account, a supplier account, or the system (a command or a loader, always labelled).
enum ActorKind {
  STAFF
  SUPPLIER
  SYSTEM
}

/// ACTIVE may sign in. PENDING_ACTIVATION is waiting for its one-time code. DISABLED is never deleted.
enum AccountStatus {
  ACTIVE
  DISABLED
  PENDING_ACTIVATION
}

/// Why a session ended. A session is revoked, never deleted.
enum SessionRevokeReason {
  SIGNED_OUT
  SIGNED_OUT_EVERYWHERE
  IDLE
  ABSOLUTE
  PASSWORD_CHANGED
  CODE_USED
  CONCURRENT_LIMIT
  ACCOUNT_DISABLED
  ACCOUNT_CHANGED
  REPLACED
  ADMINISTRATOR
}

/// What a one-time code is for. It is handed over by hand; the system never sends it.
enum CodePurpose {
  ACTIVATION
  RESET
}

/// One row of the sign-in log per event (ADR 0034 D16).
enum SignInEventKind {
  SIGNED_IN
  FAILED
  LOCKED_OUT
  THROTTLED
  SESSION_LIMIT
  SIGNED_OUT
  IDLE_EXPIRED
  ABSOLUTE_EXPIRED
  REVOKED
  PASSWORD_CHANGED
  CODE_ISSUED
  CODE_USED
  STEP_UP_OK
  STEP_UP_FAILED
  ACCOUNT_CREATED
  ACCOUNT_DISABLED
  UNLOCKED
}

/// What happens when an account is already at its concurrent-session limit. The customer's choice: unset is null.
enum ConcurrentSessionAction {
  REVOKE_OLDEST
  REFUSE_NEW
}

/// Whether a decision taken on paper may be recorded by someone else on the decider's behalf. The customer's choice: unset is null.
enum PaperSignatureRecording {
  ALLOWED
  REFUSED
}

/// A staff member's way in: one per Person, bound for good once made. The password is held only as a hash
/// (scrypt, PHC format, parameters in the string). Its CHECKs (hand-appended in the migration) keep the sign-in key
/// the lower-cased name and a disabled account dated.
model StaffAccount {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  /// As the person types it, for display; `loginKey` is the same lower-cased and is what is compared and unique.
  loginName String
  loginKey  String @unique

  passwordHash      String
  passwordChangedAt DateTime
  /// Set where the next sign-in must be followed by choosing a new password.
  mustChangePassword Boolean @default(false)
  /// Administration is kept apart from every transactional capability (NFR-SEC-004, Phase 2a).
  isAdministrator    Boolean @default(false)
  status             AccountStatus

  /// Counted in the database so every instance shares it. Reset by a good sign-in and when a lock ends.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastSignInAt   DateTime?
  disabledAt     DateTime?
  disabledReason String    @default("")
  /// A reset was done to this account: said once, at the next sign-in, until acknowledged.
  resetNoticePending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions StaffSession[]
  codes    OneTimeCode[]
  events   SignInEvent[]

  @@index([organisationId])
}

/// A signed-in browser. Only the SHA-256 of its 256-bit token is stored; the cookie carries the token. There is no
/// `assurance` column: a later second factor attaches at the password re-entry step, not here.
model StaffSession {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  accountId      String
  account        StaffAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  tokenHash String @unique

  createdAt  DateTime @default(now())
  lastSeenAt DateTime
  /// Fixed when the session is made and never extended.
  absoluteExpiresAt DateTime
  /// When the password was last re-entered in this session (Phase 2 reads it).
  stepUpAt DateTime?

  /// Ordinary editable columns, under the sign-in-detail retention setting (ADR 0034 D16).
  sourceAddress String?
  userAgent     String  @default("")

  revokedAt     DateTime?
  revokedReason SessionRevokeReason?

  @@index([accountId, revokedAt])
}

/// One-time code to activate an account or reset its password. 128 random bits, shown once, held as SHA-256. Handed
/// over by an officer who says how identity was checked. The supplier account has no foreign key until Phase 4.
model OneTimeCode {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  store             ActorKind
  staffAccountId    String?
  staffAccount      StaffAccount? @relation(fields: [staffAccountId], references: [id], onDelete: Restrict)
  supplierAccountId String?

  purpose   CodePurpose
  codeHash  String      @unique
  expiresAt DateTime
  usedAt    DateTime?

  issuedByPersonId String
  issuedBy         Person @relation("CodeIssuedBy", fields: [issuedByPersonId], references: [id], onDelete: Restrict)
  /// Why it was issued, and (for a supplier) how the caller's identity was checked outside the system.
  reason        String
  identityCheck String   @default("")
  createdAt     DateTime @default(now())

  @@index([staffAccountId])
}

/// How long and how many, per organisation: every column nullable, with a CHECK range and no default. Unset means
/// sign-in refuses and says which setting is unset. Ranges are validity bounds, not policy.
model SecurityPolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  staffIdleMinutes         Int?
  staffAbsoluteMinutes     Int?
  supplierIdleMinutes      Int?
  supplierAbsoluteMinutes  Int?
  maxConcurrentSessions    Int?
  concurrentSessionAction  ConcurrentSessionAction?
  maxFailedAttempts        Int?
  lockoutMinutes           Int?
  addressThrottleAttempts  Int?
  addressThrottleMinutes   Int?
  /// At least 8 (NIST SP 800-63B), at most 256.
  passwordMinLength        Int?
  resetCodeValidityMinutes Int?
  paperSignatureRecording  PaperSignatureRecording?
  /// O-1: how long the source address and user agent of a sign-in event are kept before the operator may purge them.
  /// At least the address-throttle window, or the throttle would lose its own evidence. Unset: they are kept.
  signInDetailRetentionDays Int?

  updatedAt DateTime @updatedAt
}

/// The permanent sign-in log: append-only (its refusal trigger, migration 20261007100100, has no bypass). It holds no
/// personal data beyond which account: the address and user agent are in SignInEventDetail (O-1). The supplier
/// account has no foreign key until Phase 4.
model SignInEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  store             ActorKind
  /// The account the attempt was matched to, if any. An unknown name matches none.
  staffAccountId    String?
  staffAccount      StaffAccount? @relation(fields: [staffAccountId], references: [id], onDelete: Restrict)
  supplierAccountId String?
  kind              SignInEventKind
  at                DateTime        @default(now())

  detail SignInEventDetail?

  @@index([staffAccountId, at])
  @@index([kind, at])
  @@index([organisationId, at])
}

/// The source address and user agent of a sign-in event, kept apart so the permanent row holds neither (O-1). Its
/// trigger refuses every UPDATE, and refuses a DELETE unless the row is older than the organisation's
/// retention setting, and always while that is unset; no database login is exempt (migration 20261007100100).
model SignInEventDetail {
  eventId String      @id
  event   SignInEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  sourceAddress String?
  userAgent     String  @default("")

  @@index([sourceAddress])
}

/// Who has edited a draft of the approval matrix, one row per person (ADR 0034 D15). The issuer of the draft is never one of these.
model AuthorityMatrixMaker {
  id       String          @id @default(cuid())
  matrixId String
  matrix   AuthorityMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  personId String
  person   Person          @relation(fields: [personId], references: [id], onDelete: Restrict)

  /// The first edit of this draft by this person.
  firstAt DateTime @default(now())

  @@unique([matrixId, personId])
  @@index([personId])
}

/// Which roles hold which product permission (ADR 0034 D8). The key is product vocabulary (a closed list in code), the role is the
/// customer's, and the decision is the customer's: no row is UNDECIDED, which is refused but shown as undecided, never as withheld.
/// A key is text, not an enum: the list of keys is code, and a new key must not need a migration. The role is a code, as a rule's is
/// (no key), so a retired role's decision stays legible.
model RolePermission {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  permissionKey String
  roleCode      String
  decision      PermissionDecision

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, permissionKey, roleCode])
}

/// One act's attribution (ADR 0034 D12): who it is attributed to and who recorded it, in one row per (act, slot), written by the one
/// writer (`attributeAct`) in the act's own transaction. No foreign key to the act (the entity is text), as `AuditEntry`'s has none; and
/// none on the supplier accounts, whose table arrives in Phase 4a. A row is evidence: a trigger refuses every UPDATE and DELETE
/// (migration 20261007130200). The CHECKs, hand-appended in the migration: exactly one subject, exactly one recorder, SIGNED only where
/// the recorder is the subject, and RECORDED_ON_BEHALF only with a paper reference or a reason.
model ActAttribution {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// The act's own row: its model, its id, and which person slot of it (`ACT_SLOTS`).
  entity   String
  entityId String
  slot     String
  /// A slot written again (a variation returned and decided again, a conflict declared twice on one step) is a new occurrence, from 1. The
  /// earlier rows stay as the evidence of who acted before, and the highest occurrence is the one in force (`latestAttribution`).
  occurrence Int @default(1)

  /// Whom the act is attributed to: a person, or (Phase 4) a supplier's account. Exactly one.
  subjectPersonId          String?
  subjectPerson            Person? @relation("ActSubject", fields: [subjectPersonId], references: [id], onDelete: Restrict)
  subjectSupplierAccountId String?

  /// Who recorded it: a person, a supplier's account, or (a demo loader, a fixture, a migration) the system by label. Exactly one.
  recordedByPersonId          String?
  recordedByPerson            Person? @relation("ActRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedBySupplierAccountId String?
  recordedBySystemLabel       String?

  mode ActMode
  /// Where the password was asked again for this act (a signature-class act), and the session it was asked in.
  stepUpAt  DateTime?
  sessionId String?
  /// The paper the act was recorded from, and why, for RECORDED_ON_BEHALF. One of them is required there.
  paperReference String @default("")
  reason         String @default("")

  /// NFR-SIG-001: what a signature-class act signed, exactly (the model and id of the document or record), and the office the signer held when they did.
  /// Both null for an act that signs nothing. The role is a configuration key: a screen reads its label.
  documentEntity String?
  documentId     String?
  roleCode       String?

  /// NFR-AUD-005 and 006: the server stamps the time of the act (`at`), never the person. A signed act dated earlier than the day it is recorded is a
  /// recorded exception: the day it is dated, why, and the person who authorised it (named by the actor: attested, not signed). All three or none.
  effectiveOn                  DateTime? @db.Date
  backdateReason               String    @default("")
  backdateAuthorisedByPersonId String?
  backdateAuthorisedByPerson   Person?   @relation("ActBackdateAuthorisedBy", fields: [backdateAuthorisedByPersonId], references: [id], onDelete: Restrict)

  at DateTime @default(now())

  @@unique([entity, entityId, slot, occurrence])
  /// One password entry signs one act: a signature-class row keeps the session and the stamp `stepUp` gave it, and no two rows share them.
  /// Other rows keep no stamp, and a null is never equal to another, so they do not collide.
  @@unique([sessionId, stepUpAt])
  @@index([organisationId, at])
  @@index([subjectPersonId])
  @@index([recordedByPersonId])
}

/// A change to high-risk configuration that a second person decides (ADR 0034 D15, Phase 2c). The payload is what is proposed,
/// `before` what the proposer saw: if the live values differ from `before` when it is decided, the change is STALE and nothing is
/// applied. The proposer and the person who decides are different Persons, and the database holds that too.
model ConfigurationChange {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  kind    ConfigurationChangeKind
  payload Json
  before  Json
  status  ConfigurationChangeStatus @default(PROPOSED)
  /// Why it is proposed, in the proposer's words.
  reason  String                    @default("")

  proposedByPersonId String
  proposedBy         Person   @relation("ChangeProposedBy", fields: [proposedByPersonId], references: [id], onDelete: Restrict)
  proposedAt         DateTime @default(now())

  /// Set exactly when the change is no longer PROPOSED. WITHDRAWN is the proposer's own; the others are a second person's.
  decidedByPersonId String?
  decidedBy         Person?   @relation("ChangeDecidedBy", fields: [decidedByPersonId], references: [id], onDelete: Restrict)
  decidedAt         DateTime?
  decisionReason    String    @default("")

  @@index([organisationId, status])
  @@index([organisationId, kind])
}

/// How an act is attributed. SIGNED: the person did it, in their own session. RECORDED_ON_BEHALF: an officer recorded it for them from
/// a paper record, and it is not a signature.
enum ActMode {
  SIGNED
  RECORDED_ON_BEHALF
}

/// A role's decision on a product permission. There is no UNDECIDED value: no row is undecided.
enum PermissionDecision {
  GRANTED
  WITHHELD
}

/// What a ConfigurationChange changes. Phase 5 adds more, each with its own migration.
enum ConfigurationChangeKind {
  SECURITY_POLICY
  PERMISSION_GRANT
  ADMINISTRATOR_GRANT
  ADMINISTRATOR_REVOKE
  ACCOUNT_CODE
}

enum ConfigurationChangeStatus {
  PROPOSED
  APPLIED
  DECLINED
  WITHDRAWN
  STALE
}
